{
  "schemaVersion": "1.0.0",
  "id": "a1-u1-d2-ich-spreche-arabisch",
  "kind": "dialogue",
  "level": "A1",
  "title": {
    "de": "Ich spreche Arabisch",
    "ar": "أتحدث العربية"
  },
  "usedIn": [
    "a1-u1-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a1u1d2-l1",
      "speaker": "yusuf",
      "text": "Ich komme aus Tunesien. Ich spreche Arabisch und Französisch.",
      "direction": "لغاتي"
    },
    {
      "id": "a1u1d2-l2",
      "speaker": "lena",
      "text": "Und du? Sprichst du auch Deutsch?",
      "direction": "سؤال"
    },
    {
      "id": "a1u1d2-l3",
      "speaker": "yusuf",
      "text": "Ja. Deutsch ist neu für mich.",
      "direction": "إجابة"
    },
    {
      "id": "a1u1d2-l4",
      "speaker": "lena",
      "text": "Sehr gut! Deutsch ist gut.",
      "direction": "تشجيع"
    },
    {
      "id": "a1u1d2-l5",
      "speaker": "yusuf",
      "text": "Ich wohne in Berlin.",
      "direction": "مكان التعلم"
    },
    {
      "id": "a1u1d2-l6",
      "speaker": "lena",
      "text": "Ich komme aus Frankreich. Ich spreche auch Englisch.",
      "direction": "تبادل"
    },
    {
      "id": "a1u1d2-l7",
      "speaker": "yusuf",
      "text": "Und Französisch?",
      "direction": "سؤال"
    },
    {
      "id": "a1u1d2-l8",
      "speaker": "lena",
      "text": "Nein, nicht viel.",
      "direction": "إجابة بسيطة"
    }
  ]
}
