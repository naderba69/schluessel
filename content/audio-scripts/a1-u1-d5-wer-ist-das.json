{
  "schemaVersion": "1.0.0",
  "id": "a1-u1-d5-wer-ist-das",
  "kind": "dialogue",
  "level": "A1",
  "title": {
    "de": "Wer ist das? — Ein Freund aus Tunesien",
    "ar": "مَن هذا؟ — صديق من تونس"
  },
  "usedIn": [
    "a1-u1-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "wer-1",
      "speaker": "lena",
      "text": "Wer ist das?",
      "direction": "نهاية الأسبوع الأول: لينا ترى صورة على هاتف يوسف — فضول ودود"
    },
    {
      "id": "wer-2",
      "speaker": "yusuf",
      "text": "Das ist Nabil, ein Freund.",
      "direction": "يوسف مبتسماً — يعرّف بصديقه"
    },
    {
      "id": "wer-3",
      "speaker": "lena",
      "text": "Woher kommt er?",
      "direction": "سؤال واضح — كلمة السؤال أولاً"
    },
    {
      "id": "wer-4",
      "speaker": "yusuf",
      "text": "Aus Tunesien, wie ich.",
      "direction": "بفخر خفيف"
    },
    {
      "id": "wer-5",
      "speaker": "lena",
      "text": "Ist er auch Student?",
      "direction": "سؤال نعم/لا — نبرة صاعدة"
    },
    {
      "id": "wer-6",
      "speaker": "yusuf",
      "text": "Nein, er ist Schüler.",
      "direction": "يصحّح ببساطة"
    },
    {
      "id": "wer-7",
      "speaker": "lena",
      "text": "Spricht er Deutsch?",
      "direction": "مهتمة"
    },
    {
      "id": "wer-8",
      "speaker": "yusuf",
      "text": "Ja, ein bisschen. Wir sprechen oft zusammen Deutsch.",
      "direction": "ودود — يشرح"
    },
    {
      "id": "wer-9",
      "speaker": "lena",
      "text": "Und wie alt ist er?",
      "direction": "فضول"
    },
    {
      "id": "wer-10",
      "speaker": "yusuf",
      "text": "Das weiß ich nicht.",
      "direction": "يتردد — لا يعرف حقاً"
    },
    {
      "id": "wer-11",
      "speaker": "lena",
      "text": "Du kennst Nabil, aber du weißt das nicht?",
      "direction": "تضحك مستغربة"
    },
    {
      "id": "wer-12",
      "speaker": "yusuf",
      "text": "Genau! Und du, Lena — bist du Studentin?",
      "direction": "يضحك ثم يقلب السؤال عليها"
    },
    {
      "id": "wer-13",
      "speaker": "lena",
      "text": "Nein, ich bin Schülerin. Wie Nabil!",
      "direction": "مرحة"
    }
  ]
}
