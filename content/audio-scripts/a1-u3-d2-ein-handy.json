{
  "schemaVersion": "1.0.0",
  "id": "a1-u3-d2-ein-handy",
  "kind": "dialogue",
  "level": "A1",
  "title": {
    "de": "Was kostet das Handy?",
    "ar": "بكم الهاتف؟ — أسعار حتى 1000"
  },
  "usedIn": [
    "a1-u3-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "hd-1",
      "speaker": "yusuf",
      "text": "Lena, ich kaufe heute ein Handy.",
      "direction": "قبل الدرس عبر الإنترنت — يوسف يشارك شاشته: صفحة متجر هواتف. متحمس"
    },
    {
      "id": "hd-2",
      "speaker": "lena",
      "text": "Ein Handy? Was kostet es?",
      "direction": "فضول عملي"
    },
    {
      "id": "hd-3",
      "speaker": "yusuf",
      "text": "Das hier kostet neunhundertneunundneunzig Euro.",
      "direction": "يقرأ السعر ببطء ووضوح — مذهول قليلاً"
    },
    {
      "id": "hd-4",
      "speaker": "lena",
      "text": "Neunhundertneunundneunzig? Das ist zu teuer!",
      "direction": "دهشة — تهز رأسها"
    },
    {
      "id": "hd-5",
      "speaker": "yusuf",
      "text": "Ja. Und das hier kostet nur zweihundertneunundsiebzig Euro.",
      "direction": "ينتقل إلى هاتف آخر — النبر على nur"
    },
    {
      "id": "hd-6",
      "speaker": "lena",
      "text": "Das ist billig! Wie viel Geld hast du?",
      "direction": "مرتاحة ثم سؤال عملي"
    },
    {
      "id": "hd-7",
      "speaker": "yusuf",
      "text": "Ich habe vierhundert Euro.",
      "direction": "هادئ"
    },
    {
      "id": "hd-8",
      "speaker": "lena",
      "text": "Also hast du noch hunderteinundzwanzig Euro!",
      "direction": "تحسب بسرعة وتفرح بالنتيجة"
    },
    {
      "id": "hd-9",
      "speaker": "yusuf",
      "text": "Genau! Für ein Essen im Restaurant.",
      "direction": "يبتسم — عنده خطة"
    },
    {
      "id": "hd-10",
      "speaker": "lena",
      "text": "Und wie bezahlst du das Handy?",
      "direction": "سؤال بنبرة صاعدة"
    },
    {
      "id": "hd-11",
      "speaker": "yusuf",
      "text": "Mit Karte. Das ist leicht.",
      "direction": "واثق"
    },
    {
      "id": "hd-12",
      "speaker": "lena",
      "text": "Der Preis ist super!",
      "direction": "راضية"
    },
    {
      "id": "hd-13",
      "speaker": "yusuf",
      "text": "Tausend Dank, Lena!",
      "direction": "امتنان دافئ"
    },
    {
      "id": "hd-14",
      "speaker": "lena",
      "text": "Gern, Yusuf!",
      "direction": "ودودة"
    }
  ]
}
