{
  "schemaVersion": "1.0.0",
  "id": "a1-u3-d3-um-halb-acht",
  "kind": "dialogue",
  "level": "A1",
  "title": {
    "de": "Um halb acht im Restaurant",
    "ar": "في السابعة والنصف في المطعم — halb للساعة التالية"
  },
  "usedIn": [
    "a1-u3-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "ab-1",
      "speaker": "ayse",
      "text": "Yusuf, wann ist das Essen im Restaurant?",
      "direction": "بعد الدرس عبر الإنترنت — Ayşe تسكن في برلين مثل يوسف، وتسأله عن موعد العشاء في المطعم"
    },
    {
      "id": "ab-2",
      "speaker": "yusuf",
      "text": "Heute Abend um halb acht.",
      "direction": "واضح وهادئ"
    },
    {
      "id": "ab-3",
      "speaker": "ayse",
      "text": "Halb acht? Also sieben Uhr dreißig?",
      "direction": "تتحقق — halb تربكها قليلاً"
    },
    {
      "id": "ab-4",
      "speaker": "yusuf",
      "text": "Genau! Und jetzt ist es halb sieben.",
      "direction": "ينظر إلى الساعة"
    },
    {
      "id": "ab-5",
      "speaker": "ayse",
      "text": "Wir haben also noch eine Stunde.",
      "direction": "تحسب — مرتاحة"
    },
    {
      "id": "ab-6",
      "speaker": "yusuf",
      "text": "Ja. Das Restaurant ist von sechs bis elf Uhr geöffnet.",
      "direction": "يقرأ مواعيد المطعم من الشاشة"
    },
    {
      "id": "ab-7",
      "speaker": "ayse",
      "text": "Ist es morgen auch geöffnet?",
      "direction": "سؤال بنبرة صاعدة"
    },
    {
      "id": "ab-8",
      "speaker": "yusuf",
      "text": "Nein, morgen ist es geschlossen.",
      "direction": "يهز رأسه"
    },
    {
      "id": "ab-9",
      "speaker": "ayse",
      "text": "Und der nächste Kurs? Wann ist er?",
      "direction": "تتذكر الدرس"
    },
    {
      "id": "ab-10",
      "speaker": "yusuf",
      "text": "Morgen früh um neun Uhr.",
      "direction": "عادي"
    },
    {
      "id": "ab-11",
      "speaker": "ayse",
      "text": "Um neun? Das ist früh!",
      "direction": "تتأفف مازحة"
    },
    {
      "id": "ab-12",
      "speaker": "yusuf",
      "text": "Für mich ist das spät!",
      "direction": "يضحك — يوسف يستيقظ باكراً"
    },
    {
      "id": "ab-13",
      "speaker": "ayse",
      "text": "Also bis halb acht im Restaurant!",
      "direction": "ودّية"
    },
    {
      "id": "ab-14",
      "speaker": "yusuf",
      "text": "Bis später, Ayşe!",
      "direction": "وداع"
    }
  ]
}
