{
  "schemaVersion": "1.0.0",
  "id": "a1-u3-d5-am-telefon",
  "kind": "dialogue",
  "level": "A1",
  "title": {
    "de": "Noch einmal, bitte! — Nummern am Telefon",
    "ar": "مرة أخرى من فضلك — الأرقام في مكالمة تدريبية"
  },
  "usedIn": [
    "a1-u3-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "h5-1",
      "speaker": "ayse",
      "text": "Yusuf, hast du die Aufgabe?",
      "direction": "في تمرين الدورة عبر الإنترنت — تسأل بهدوء إن كان مستعداً"
    },
    {
      "id": "h5-2",
      "speaker": "yusuf",
      "text": "Ja. Ich höre die Nachricht.",
      "direction": "يركز في الرسالة الصوتية"
    },
    {
      "id": "h5-3",
      "speaker": "ayse",
      "text": "Die Stimme ist leise.",
      "direction": "تلاحظ أن الصوت في التسجيل منخفض"
    },
    {
      "id": "h5-4",
      "speaker": "yusuf",
      "text": "Ich verstehe die Nummer nicht.",
      "direction": "يشرح ما الذي لم يفهمه"
    },
    {
      "id": "h5-5",
      "speaker": "yusuf",
      "text": "Noch einmal, bitte!",
      "direction": "طلب مهذب لإعادة الرقم"
    },
    {
      "id": "h5-6",
      "speaker": "ayse",
      "text": "Null, fünf, zwei, drei, neun.",
      "direction": "تقرأ رقماً تدريبياً خانةً خانة"
    },
    {
      "id": "h5-7",
      "speaker": "yusuf",
      "text": "Bitte nicht so schnell!",
      "direction": "يطلب تمهلاً، من دون لوم"
    },
    {
      "id": "h5-8",
      "speaker": "ayse",
      "text": "Langsam: null, fünf, zwei, drei, neun.",
      "direction": "تعيد الخانات بوضوح وهدوء"
    },
    {
      "id": "h5-9",
      "speaker": "yusuf",
      "text": "Null, fünf, zwei, drei, neun?",
      "direction": "يعيد الرقم ليتأكد"
    },
    {
      "id": "h5-10",
      "speaker": "ayse",
      "text": "Ja, genau!",
      "direction": "تؤكد بإيجاز"
    },
    {
      "id": "h5-11",
      "speaker": "yusuf",
      "text": "Und die Zeit? Um halb acht?",
      "direction": "ينتقل إلى وقت الموعد"
    },
    {
      "id": "h5-12",
      "speaker": "ayse",
      "text": "Ja, sieben Uhr dreißig.",
      "direction": "تؤكد الوقت بالطريقة الرسمية"
    },
    {
      "id": "h5-13",
      "speaker": "yusuf",
      "text": "Jetzt verstehe ich die Aufgabe.",
      "direction": "ارتاح بعد أن فهم الرقم والوقت"
    },
    {
      "id": "h5-14",
      "speaker": "ayse",
      "text": "Bis später, Yusuf!",
      "direction": "وداع ودّي بعد التمرين"
    }
  ]
}
