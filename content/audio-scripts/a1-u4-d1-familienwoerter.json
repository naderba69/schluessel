{
  "schemaVersion": "1.0.0",
  "id": "a1-u4-d1-familienwoerter",
  "kind": "dialogue",
  "level": "A1",
  "title": {
    "de": "Wer ist das? — die Großeltern",
    "ar": "أسرة تدريبية خيالية: التعرّف على أفراد الأسرة"
  },
  "usedIn": [
    "a1-u4-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "f4-1",
      "speaker": "ayse",
      "text": "Wer ist die Frau?",
      "direction": "تسأل عن الشخص في الرسم التدريبي"
    },
    {
      "id": "f4-2",
      "speaker": "yusuf",
      "text": "Die Frau ist die Mutter.",
      "direction": "يسميها بالألمانية"
    },
    {
      "id": "f4-3",
      "speaker": "ayse",
      "text": "Und der Mann?",
      "direction": "تنتقل إلى الشخص الآخر"
    },
    {
      "id": "f4-4",
      "speaker": "yusuf",
      "text": "Der Mann ist der Vater.",
      "direction": "يسميه بالألمانية",
      "lengthScale": 1.5
    },
    {
      "id": "f4-5",
      "speaker": "ayse",
      "text": "Wer ist der Junge?",
      "direction": "تسأل عن الولد في الرسم"
    },
    {
      "id": "f4-6",
      "speaker": "yusuf",
      "text": "Der Junge ist der Sohn.",
      "direction": "يربط الوصف بالاسم الأسري"
    },
    {
      "id": "f4-7",
      "speaker": "ayse",
      "text": "Und die Tochter?",
      "direction": "تسأل عن الابنة"
    },
    {
      "id": "f4-8",
      "speaker": "yusuf",
      "text": "Das ist die Tochter.",
      "direction": "يجيب بجملة تعريف بسيطة"
    },
    {
      "id": "f4-9",
      "speaker": "ayse",
      "text": "Und der Bruder?",
      "direction": "تسأل عن الأخ"
    },
    {
      "id": "f4-10",
      "speaker": "yusuf",
      "text": "Das ist der Bruder.",
      "direction": "يسميه بالألمانية"
    },
    {
      "id": "f4-11",
      "speaker": "ayse",
      "text": "Und die Schwester?",
      "direction": "تسأل عن الأخت"
    },
    {
      "id": "f4-12",
      "speaker": "yusuf",
      "text": "Das ist die Schwester.",
      "direction": "يسميها بالألمانية"
    },
    {
      "id": "f4-13",
      "speaker": "ayse",
      "text": "Sind das die Eltern?",
      "direction": "تتحقق من صيغة الجمع"
    },
    {
      "id": "f4-14",
      "speaker": "yusuf",
      "text": "Ja, das sind die Eltern.",
      "direction": "يؤكد أن الكلمة جمع"
    },
    {
      "id": "f4-15",
      "speaker": "ayse",
      "text": "Und die Kinder?",
      "direction": "تسأل عن الأبناء"
    },
    {
      "id": "f4-16",
      "speaker": "yusuf",
      "text": "Das sind der Sohn und die Tochter.",
      "direction": "يسمي الابن والابنة"
    },
    {
      "id": "f4-17",
      "speaker": "ayse",
      "text": "Und die Großeltern?",
      "direction": "تسأل عن الجدين"
    },
    {
      "id": "f4-18",
      "speaker": "yusuf",
      "text": "Der Opa ist der Großvater. Die Oma ist die Großmutter.",
      "direction": "يوضح الاسمين اليومي والرسمي لكل من الجد والجدة"
    },
    {
      "id": "f4-19",
      "speaker": "ayse",
      "text": "Das Kind?",
      "direction": "تستعيد الاسم المفرد"
    },
    {
      "id": "f4-20",
      "speaker": "yusuf",
      "text": "Das ist das Kind.",
      "direction": "يؤكد صيغة المفرد"
    }
  ]
}
