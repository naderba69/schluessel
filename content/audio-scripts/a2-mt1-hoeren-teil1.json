{
  "schemaVersion": "1.0.0",
  "id": "a2-mt1-hoeren-teil1",
  "kind": "announcement",
  "level": "A2",
  "title": {
    "de": "Hören Teil 1 — Fünf Durchsagen",
    "ar": "الاستماع — القسم 1: خمس مناشير"
  },
  "usedIn": [
    "a2-modelltest-1#hoeren-teil1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2mt1-h1-d1-l1",
      "speaker": "announcer",
      "text": "Achtung, bitte! Der Zug nach Hamburg fährt um zehn Uhr.",
      "direction": "مذيع محطة — رسمي"
    },
    {
      "id": "a2mt1-h1-d1-l2",
      "speaker": "announcer",
      "text": "Er kommt um zwölf Uhr an.",
      "direction": "مذيع محطة — رسمي"
    },
    {
      "id": "a2mt1-h1-d2-l1",
      "speaker": "announcer",
      "text": "Achtung! Das Kaufhaus ist am Montag geschlossen.",
      "direction": "مذيع — رسمي"
    },
    {
      "id": "a2mt1-h1-d2-l2",
      "speaker": "announcer",
      "text": "Am Dienstag ist alles billiger.",
      "direction": "مذيع — رسمي"
    },
    {
      "id": "a2mt1-h1-d3-l1",
      "speaker": "announcer",
      "text": "Der Kurs beginnt am Montag.",
      "direction": "مذيع مدرسة — رسمي"
    },
    {
      "id": "a2mt1-h1-d3-l2",
      "speaker": "announcer",
      "text": "Der Kurs ist um neun Uhr.",
      "direction": "مذيع مدرسة — رسمي"
    },
    {
      "id": "a2mt1-h1-d4-l1",
      "speaker": "announcer",
      "text": "Guten Morgen! Das Wetter heute: kalt und windig.",
      "direction": "مذيع الطقس — وديّ"
    },
    {
      "id": "a2mt1-h1-d4-l2",
      "speaker": "announcer",
      "text": "Am Abend wird es warm.",
      "direction": "مذيع الطقس — وديّ"
    },
    {
      "id": "a2mt1-h1-d5-l1",
      "speaker": "announcer",
      "text": "Achtung! Das Fest ist am Samstag.",
      "direction": "مذيع — رسمي"
    },
    {
      "id": "a2mt1-h1-d5-l2",
      "speaker": "announcer",
      "text": "Es ist um acht Uhr.",
      "direction": "مذيع — رسمي"
    }
  ]
}