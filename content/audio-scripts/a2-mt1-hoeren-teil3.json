{
  "schemaVersion": "1.0.0",
  "id": "a2-mt1-hoeren-teil3",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Hören Teil 3 — Fünf kurze Gespräche",
    "ar": "الاستماع — القسم 3: خمسة حوارات قصيرة"
  },
  "usedIn": [
    "a2-modelltest-1#hoeren-teil3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2mt1-h3-d1-l1",
      "speaker": "thomas",
      "text": "Guten Morgen! Ein Brot, bitte.",
      "direction": "توماس — مهذب"
    },
    {
      "id": "a2mt1-h3-d1-l2",
      "speaker": "frau-berg",
      "text": "Gern. Sonst noch etwas?",
      "direction": "السيدة بيرغ — ودّية"
    },
    {
      "id": "a2mt1-h3-d2-l1",
      "speaker": "yusuf",
      "text": "Wie spät ist es?",
      "direction": "يوسف — مستعجل"
    },
    {
      "id": "a2mt1-h3-d2-l2",
      "speaker": "ayse",
      "text": "Es ist halb neun.",
      "direction": "عائشة — هادئة"
    },
    {
      "id": "a2mt1-h3-d3-l1",
      "speaker": "dr-weber",
      "text": "Haben Sie am Dienstag Zeit?",
      "direction": "الدكتور فيبر — مهذب"
    },
    {
      "id": "a2mt1-h3-d3-l2",
      "speaker": "lena",
      "text": "Am Dienstag leider nicht. Aber am Mittwoch!",
      "direction": "لينا — آسفة"
    },
    {
      "id": "a2mt1-h3-d4-l1",
      "speaker": "mueller",
      "text": "Es ist kalt heute!",
      "direction": "مولر — دردشة"
    },
    {
      "id": "a2mt1-h3-d4-l2",
      "speaker": "frau-schmidt",
      "text": "Ja! Und morgen wird es wärmer.",
      "direction": "السيدة شميدت — ودّية"
    },
    {
      "id": "a2mt1-h3-d5-l1",
      "speaker": "lena",
      "text": "War die Party gut?",
      "direction": "لينا — فضولية"
    },
    {
      "id": "a2mt1-h3-d5-l2",
      "speaker": "yusuf",
      "text": "Ja, sehr gut! Und die Musik war laut.",
      "direction": "يوسف — سعيد"
    }
  ]
}