{
  "schemaVersion": "1.0.0",
  "id": "a2-mt1-hoeren-teil4",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Hören Teil 4 — Ein Radiointerview",
    "ar": "الاستماع — القسم 4: مقابلة إذاعية"
  },
  "usedIn": [
    "a2-modelltest-1#hoeren-teil4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2mt1-h4-d1-l1",
      "speaker": "mueller",
      "text": "Guten Abend! Ich spreche mit Frau Berg. Frau Berg, was machen Sie?",
      "direction": "مقدّم راديو — رسمي"
    },
    {
      "id": "a2mt1-h4-d1-l2",
      "speaker": "frau-berg",
      "text": "Ich arbeite in einer Bäckerei. Am Samstag arbeite ich immer.",
      "direction": "السيدة بيرغ — ودّية"
    },
    {
      "id": "a2mt1-h4-d1-l3",
      "speaker": "mueller",
      "text": "Und wann haben Sie frei?",
      "direction": "مقدّم راديو — فضولي"
    },
    {
      "id": "a2mt1-h4-d1-l4",
      "speaker": "frau-berg",
      "text": "Am Montag und am Dienstag. Da koche ich und lese.",
      "direction": "السيدة بيرغ — هادئة"
    },
    {
      "id": "a2mt1-h4-d1-l5",
      "speaker": "mueller",
      "text": "Was kochen Sie gern?",
      "direction": "مقدّم راديو — ودّي"
    },
    {
      "id": "a2mt1-h4-d1-l6",
      "speaker": "frau-berg",
      "text": "Ich koche gern Suppe. Und die Kinder essen gern Kuchen!",
      "direction": "السيدة بيرغ — مرحة"
    },
    {
      "id": "a2mt1-h4-d1-l7",
      "speaker": "mueller",
      "text": "Danke, Frau Berg!",
      "direction": "مقدّم راديو — مهذب"
    }
  ]
}