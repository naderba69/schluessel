{
  "schemaVersion": "1.0.0",
  "id": "a2-u1-d3-urlaub-am-strand",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Unser Urlaub",
    "ar": "عطلتنا"
  },
  "usedIn": [
    "a2-u1-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u1d3-l1",
      "speaker": "ayse",
      "text": "Wie war euer Urlaub? Erzähl!",
      "direction": "عائشة متحمسة"
    },
    {
      "id": "a2u1d3-l2",
      "speaker": "yusuf",
      "text": "Wunderbar! Wir haben in einem Zelt geschlafen.",
      "direction": "يوسف يتذكر العطلة"
    },
    {
      "id": "a2u1d3-l3",
      "speaker": "ayse",
      "text": "In einem Zelt? Das ist ja aufregend!",
      "direction": "عائشة متعجبة"
    },
    {
      "id": "a2u1d3-l4",
      "speaker": "yusuf",
      "text": "Ich bin am Strand geritten und wir haben uns gut unterhalten.",
      "direction": "يوسف يحكي بحماس"
    },
    {
      "id": "a2u1d3-l5",
      "speaker": "ayse",
      "text": "Habt ihr euch auch geärgert?",
      "direction": "عائشة تسأل بابتسامة"
    },
    {
      "id": "a2u1d3-l6",
      "speaker": "yusuf",
      "text": "Einmal! Ich habe mich dann beim Zelt bedankt.",
      "direction": "يوسف يضحك"
    },
    {
      "id": "a2u1d3-l7",
      "speaker": "ayse",
      "text": "Sogar im Meer geschwommen?",
      "direction": "عائشة تكمل التفاصيل"
    },
    {
      "id": "a2u1d3-l8",
      "speaker": "yusuf",
      "text": "Sogar im Meer! Und du? Was hast du gemacht?",
      "direction": "يوسف يحكي ثم يسأل"
    }
  ]
}
