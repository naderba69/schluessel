{
  "schemaVersion": "1.0.0",
  "id": "a2-u1-d4-meine-ferien",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Meine Ferien im Heft",
    "ar": "عطلتي في الكراس"
  },
  "usedIn": [
    "a2-u1-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u1d4-l1",
      "speaker": "lena",
      "text": "Schreibst du Sätze über deine Ferien?",
      "direction": "لينا ترى الكراس"
    },
    {
      "id": "a2u1d4-l2",
      "speaker": "yusuf",
      "text": "Ja! Sechs Sätze für mein Heft.",
      "direction": "يوسف يمسك القلم"
    },
    {
      "id": "a2u1d4-l3",
      "speaker": "lena",
      "text": "Was war schön?",
      "direction": "لينا تسأل"
    },
    {
      "id": "a2u1d4-l4",
      "speaker": "yusuf",
      "text": "Meine Ferien waren sehr schön. Wir haben uns einmal gestritten.",
      "direction": "يوسف يكتب وهو يحكي"
    },
    {
      "id": "a2u1d4-l5",
      "speaker": "lena",
      "text": "Gestritten? Wegen was?",
      "direction": "لينا تضحك قليلاً"
    },
    {
      "id": "a2u1d4-l6",
      "speaker": "yusuf",
      "text": "Wegen des Hundes! Ich hatte Angst, aber mein Wunsch war ein Hund.",
      "direction": "يوسف يشرح القصة"
    },
    {
      "id": "a2u1d4-l7",
      "speaker": "lena",
      "text": "Und jetzt?",
      "direction": "لينا تسأل عن النهاية"
    },
    {
      "id": "a2u1d4-l8",
      "speaker": "yusuf",
      "text": "Jetzt hoffe ich: nächstes Jahr wieder! Ich habe wirklich viel gelernt.",
      "direction": "يوسف يختم بتفاؤل"
    }
  ]
}
