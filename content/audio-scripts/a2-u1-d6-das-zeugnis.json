{
  "schemaVersion": "1.0.0",
  "id": "a2-u1-d6-das-zeugnis",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Mein Zeugnis für die Woche",
    "ar": "شهادتي الأسبوعية"
  },
  "usedIn": [
    "a2-u1-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u1d6-l1",
      "speaker": "yusuf",
      "text": "Hier! Das ist mein Zeugnis für die Woche.",
      "direction": "يوسف يُظهر الورقة"
    },
    {
      "id": "a2u1d6-l2",
      "speaker": "lena",
      "text": "Was steht da?",
      "direction": "لينا تنظر إليها"
    },
    {
      "id": "a2u1d6-l3",
      "speaker": "yusuf",
      "text": "Fünf Tage: Erst Arbeit, dann Lernen, dann Sport.",
      "direction": "يوسف يقرأ النقاط"
    },
    {
      "id": "a2u1d6-l4",
      "speaker": "lena",
      "text": "Und der Stift? Ist er noch da?",
      "direction": "لينا تسأل عن القلم"
    },
    {
      "id": "a2u1d6-l5",
      "speaker": "yusuf",
      "text": "Ja! Ich habe ihn nicht verloren. Ich bin stolz!",
      "direction": "يوسف يضحك"
    },
    {
      "id": "a2u1d6-l6",
      "speaker": "lena",
      "text": "Und wie war die Woche?",
      "direction": "لينا تسأل عن التقييم"
    },
    {
      "id": "a2u1d6-l7",
      "speaker": "yusuf",
      "text": "Schön! Ich habe mich beeilt und war fleißig.",
      "direction": "يوسف يشعر بالفخر"
    },
    {
      "id": "a2u1d6-l8",
      "speaker": "lena",
      "text": "Das Zeugnis ist gut!",
      "direction": "لينا تؤكد بابتسامة"
    }
  ]
}
