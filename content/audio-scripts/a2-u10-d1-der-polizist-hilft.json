{
  "schemaVersion": "1.0.0",
  "id": "a2-u10-d1-der-polizist-hilft",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Der Polizist hilft",
    "ar": "الشرطي يساعد"
  },
  "usedIn": [
    "a2-u10-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u10d1-l1",
      "speaker": "yusuf",
      "text": "Entschuldigung, Herr Polizist!",
      "direction": "يوسف يطلب المساعدة"
    },
    {
      "id": "a2u10d1-l2",
      "speaker": "thomas",
      "text": "Ja? Was kann ich für Sie tun?",
      "direction": "توماس بشخصية الشرطي"
    },
    {
      "id": "a2u10d1-l3",
      "speaker": "yusuf",
      "text": "Wo ist die Bank? Ich bin hier neu.",
      "direction": "يوسف يسأل عن البنك"
    },
    {
      "id": "a2u10d1-l4",
      "speaker": "thomas",
      "text": "Geradeaus! Die Angestellten helfen gern.",
      "direction": "الشرطي يدلّه على الطريق"
    },
    {
      "id": "a2u10d1-l5",
      "speaker": "yusuf",
      "text": "Und die Auszubildenden?",
      "direction": "يوسف يسأل عن المتدربين"
    },
    {
      "id": "a2u10d1-l6",
      "speaker": "thomas",
      "text": "Die sind auch da! Gehen Sie durch die Tür.",
      "direction": "الشرطي يشرح"
    },
    {
      "id": "a2u10d1-l7",
      "speaker": "yusuf",
      "text": "Danke für die Hilfe!",
      "direction": "يوسف يشكره"
    },
    {
      "id": "a2u10d1-l8",
      "speaker": "thomas",
      "text": "Gern! Willkommen in der Stadt.",
      "direction": "الشرطي يرحب به"
    }
  ]
}
