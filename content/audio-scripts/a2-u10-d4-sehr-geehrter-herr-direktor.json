{
  "schemaVersion": "1.0.0",
  "id": "a2-u10-d4-sehr-geehrter-herr-direktor",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Sehr geehrter Herr Direktor",
    "ar": "سيدي المدير المحترم"
  },
  "usedIn": [
    "a2-u10-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u10d4-l1",
      "speaker": "yusuf",
      "text": "Lena, wie schreibe ich einen Brief?",
      "direction": "يوسف يسأل عن كتابة الخطاب"
    },
    {
      "id": "a2u10d4-l2",
      "speaker": "lena",
      "text": "Schreib: Sehr geehrter Herr Direktor!",
      "direction": "لينا تعلّمه الصيغة"
    },
    {
      "id": "a2u10d4-l3",
      "speaker": "yusuf",
      "text": "Und dann? Z. B. die Gründe?",
      "direction": "يوسف يسأل عن المحتوى"
    },
    {
      "id": "a2u10d4-l4",
      "speaker": "lena",
      "text": "Ja! Und am Ende: Mit freundlichen Grüßen.",
      "direction": "لينا تكمل التعليمات"
    },
    {
      "id": "a2u10d4-l5",
      "speaker": "yusuf",
      "text": "Schreibe ich alles am PC?",
      "direction": "يوسف يسأل عن الوسيلة"
    },
    {
      "id": "a2u10d4-l6",
      "speaker": "lena",
      "text": "Ja! Und dann druckst du es.",
      "direction": "لينا تجيب"
    },
    {
      "id": "a2u10d4-l7",
      "speaker": "yusuf",
      "text": "Und usw.?",
      "direction": "يوسف يسأل عن الاختصارات"
    },
    {
      "id": "a2u10d4-l8",
      "speaker": "lena",
      "text": "Das schreibt man nur in Notizen!",
      "direction": "لينا تصحح له"
    }
  ]
}
