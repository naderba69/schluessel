{
  "schemaVersion": "1.0.0",
  "id": "a2-u10-d6-ist-das-erlaubt",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Ist das erlaubt?",
    "ar": "هل هذا مسموح؟"
  },
  "usedIn": [
    "a2-u10-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u10d6-l1",
      "speaker": "thomas",
      "text": "Ist das hier erlaubt?",
      "direction": "توماس يسأل عن القاعدة"
    },
    {
      "id": "a2u10d6-l2",
      "speaker": "yusuf",
      "text": "Ja! Aber nicht hier.",
      "direction": "يوسف يجيب"
    },
    {
      "id": "a2u10d6-l3",
      "speaker": "thomas",
      "text": "Und wo ist das WC?",
      "direction": "توماس يسأل عن دورة المياه"
    },
    {
      "id": "a2u10d6-l4",
      "speaker": "yusuf",
      "text": "Dort drüben, neben der Tür.",
      "direction": "يوسف يدلّه على المكان"
    },
    {
      "id": "a2u10d6-l5",
      "speaker": "thomas",
      "text": "Danke! Und das Parken?",
      "direction": "توماس يسأل عن المواقف"
    },
    {
      "id": "a2u10d6-l6",
      "speaker": "yusuf",
      "text": "Auch erlaubt, aber nur eine Stunde.",
      "direction": "يوسف يوضح القاعدة"
    },
    {
      "id": "a2u10d6-l7",
      "speaker": "thomas",
      "text": "Verstehe! Das ist wichtig.",
      "direction": "توماس يعلّق"
    },
    {
      "id": "a2u10d6-l8",
      "speaker": "yusuf",
      "text": "Aber sie sind wichtig!",
      "direction": "يوسف يبرر القواعد"
    }
  ]
}
