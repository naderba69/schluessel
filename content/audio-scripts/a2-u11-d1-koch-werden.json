{
  "schemaVersion": "1.0.0",
  "id": "a2-u11-d1-koch-werden",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Ich würde gern Koch werden!",
    "ar": "أريد أن أصير طاهياً!"
  },
  "usedIn": [
    "a2-u11-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u11d1-l1",
      "speaker": "lena",
      "text": "Was möchtest du werden?",
      "direction": "لينا تسأل عن الطموح"
    },
    {
      "id": "a2u11d1-l2",
      "speaker": "yusuf",
      "text": "Ich würde gern Koch werden!",
      "direction": "يوسف يحلم بالطبخ"
    },
    {
      "id": "a2u11d1-l3",
      "speaker": "lena",
      "text": "Und Thomas?",
      "direction": "لينا تسأل عن توماس"
    },
    {
      "id": "a2u11d1-l4",
      "speaker": "yusuf",
      "text": "Er will Musiker werden. Und der Techniker?",
      "direction": "يوسف يجيب ثم يسأل"
    },
    {
      "id": "a2u11d1-l5",
      "speaker": "lena",
      "text": "Der bleibt Techniker!",
      "direction": "لينا تمزح"
    },
    {
      "id": "a2u11d1-l6",
      "speaker": "yusuf",
      "text": "Und du? Was ist dein Traum?",
      "direction": "يوسف يسألها عن حلمها"
    },
    {
      "id": "a2u11d1-l7",
      "speaker": "lena",
      "text": "Ich möchte Lehrerin werden.",
      "direction": "لينا تجيب عن طموحها"
    },
    {
      "id": "a2u11d1-l8",
      "speaker": "yusuf",
      "text": "Wunderbar! Wir haben gute Träume.",
      "direction": "يوسف يختم بتفاؤل"
    }
  ]
}
