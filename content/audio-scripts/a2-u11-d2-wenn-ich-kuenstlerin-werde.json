{
  "schemaVersion": "1.0.0",
  "id": "a2-u11-d2-wenn-ich-kuenstlerin-werde",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Wenn ich Künstlerin werde",
    "ar": "إذا صرت فنانة"
  },
  "usedIn": [
    "a2-u11-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u11d2-l1",
      "speaker": "ayse",
      "text": "Wenn ich Künstlerin werde, male ich!",
      "direction": "عائشة تحلم بالفن"
    },
    {
      "id": "a2u11d2-l2",
      "speaker": "yusuf",
      "text": "Und wenn ich Zeit habe, spiele ich!",
      "direction": "يوسف يشاركها الحلم"
    },
    {
      "id": "a2u11d2-l3",
      "speaker": "ayse",
      "text": "Die Schauspielerin ist auch nett.",
      "direction": "عائشة تذكر مهنة أخرى"
    },
    {
      "id": "a2u11d2-l4",
      "speaker": "yusuf",
      "text": "Und die Handwerkerin?",
      "direction": "يوسف يسأل عن الحرفية"
    },
    {
      "id": "a2u11d2-l5",
      "speaker": "ayse",
      "text": "Die repariert alles! Sehr praktisch.",
      "direction": "عائشة تمدح المهنة"
    },
    {
      "id": "a2u11d2-l6",
      "speaker": "yusuf",
      "text": "Also: jeder macht, was er liebt!",
      "direction": "يوسف يستنتج"
    },
    {
      "id": "a2u11d2-l7",
      "speaker": "ayse",
      "text": "Genau! Und wir üben jeden Tag.",
      "direction": "عائشة تؤكد"
    },
    {
      "id": "a2u11d2-l8",
      "speaker": "yusuf",
      "text": "Dann machen wir das!",
      "direction": "يوسف يتفاءل"
    }
  ]
}
