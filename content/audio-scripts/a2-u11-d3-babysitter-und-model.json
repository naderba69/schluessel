{
  "schemaVersion": "1.0.0",
  "id": "a2-u11-d3-babysitter-und-model",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Babysitter und Model",
    "ar": "جليسة أطفال وعارضة أزياء"
  },
  "usedIn": [
    "a2-u11-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u11d3-l1",
      "speaker": "lena",
      "text": "Ich will Babysitter werden!",
      "direction": "لينا تعلن عن رغبتها"
    },
    {
      "id": "a2u11d3-l2",
      "speaker": "yusuf",
      "text": "Und deine Schwester?",
      "direction": "يوسف يسأل عن أختها"
    },
    {
      "id": "a2u11d3-l3",
      "speaker": "lena",
      "text": "Sie wird Model! Ihr Fach ist Mode.",
      "direction": "لينا تجيب عن أختها"
    },
    {
      "id": "a2u11d3-l4",
      "speaker": "yusuf",
      "text": "Und welches Fach magst du am besten?",
      "direction": "يوسف يسأل عن مادتها المفضلة"
    },
    {
      "id": "a2u11d3-l5",
      "speaker": "lena",
      "text": "Sprachen! Und deine Zukunft?",
      "direction": "لينا تجيب ثم تسأل"
    },
    {
      "id": "a2u11d3-l6",
      "speaker": "yusuf",
      "text": "Gut! Ich werde viel arbeiten.",
      "direction": "يوسف يخطط للمستقبل"
    },
    {
      "id": "a2u11d3-l7",
      "speaker": "lena",
      "text": "Aber auch Spaß haben!",
      "direction": "لينا تذكّره بالحياة"
    },
    {
      "id": "a2u11d3-l8",
      "speaker": "yusuf",
      "text": "Wirklich!",
      "direction": "يوسف يوعد"
    }
  ]
}
