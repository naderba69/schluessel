{
  "schemaVersion": "1.0.0",
  "id": "a2-u11-d4-urlaub-im-juli",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Urlaub im Juli",
    "ar": "عطلة في يوليو"
  },
  "usedIn": [
    "a2-u11-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u11d4-l1",
      "speaker": "thomas",
      "text": "Im Juli habe ich Urlaub!",
      "direction": "توماس يعلن عن عطلته"
    },
    {
      "id": "a2u11d4-l2",
      "speaker": "yusuf",
      "text": "Schön! Und im August?",
      "direction": "يوسف يسأل عن الشهر التالي"
    },
    {
      "id": "a2u11d4-l3",
      "speaker": "thomas",
      "text": "Da arbeite ich wieder. Aber September ist frei.",
      "direction": "توماس يخطط"
    },
    {
      "id": "a2u11d4-l4",
      "speaker": "yusuf",
      "text": "Wohin fährst du im Juli?",
      "direction": "يوسف يسأل عن الوجهة"
    },
    {
      "id": "a2u11d4-l5",
      "speaker": "thomas",
      "text": "An die See! Ich möchte baden.",
      "direction": "توماس يحلم بالبحر"
    },
    {
      "id": "a2u11d4-l6",
      "speaker": "yusuf",
      "text": "Und im August?",
      "direction": "يوسف يسأل مرة أخرى"
    },
    {
      "id": "a2u11d4-l7",
      "speaker": "thomas",
      "text": "Da besuche ich meine Familie.",
      "direction": "توماس يجيب"
    },
    {
      "id": "a2u11d4-l8",
      "speaker": "yusuf",
      "text": "Das ist gut!",
      "direction": "يوسف يتمنى له قضاء وقت جميل"
    }
  ]
}
