{
  "schemaVersion": "1.0.0",
  "id": "a2-u11-d5-urlaub-im-oktober",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Urlaub im Oktober",
    "ar": "عطلة في أكتوبر"
  },
  "usedIn": [
    "a2-u11-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u11d5-l1",
      "speaker": "ayse",
      "text": "Im Oktober hätte ich gern Urlaub!",
      "direction": "عائشة تتمنى العطلة"
    },
    {
      "id": "a2u11d5-l2",
      "speaker": "yusuf",
      "text": "Und im November?",
      "direction": "يوسف يسأل عن الشهر التالي"
    },
    {
      "id": "a2u11d5-l3",
      "speaker": "ayse",
      "text": "Da ist es kalt. Aber im Dezember feiern wir!",
      "direction": "عائشة تصف الشتاء"
    },
    {
      "id": "a2u11d5-l4",
      "speaker": "yusuf",
      "text": "Weihnachten!",
      "direction": "يوسف يتذكر العيد"
    },
    {
      "id": "a2u11d5-l5",
      "speaker": "ayse",
      "text": "Genau! Und das neue Jahr.",
      "direction": "عائشة تضيف"
    },
    {
      "id": "a2u11d5-l6",
      "speaker": "yusuf",
      "text": "Was wünschst du dir?",
      "direction": "يوسف يسأل عن الأمنيات"
    },
    {
      "id": "a2u11d5-l7",
      "speaker": "ayse",
      "text": "Gesundheit und Glück!",
      "direction": "عائشة تتمنى الخير"
    },
    {
      "id": "a2u11d5-l8",
      "speaker": "yusuf",
      "text": "Das wünsche ich dir auch!",
      "direction": "يوسف يرد التمني"
    }
  ]
}
