{
  "schemaVersion": "1.0.0",
  "id": "a2-u11-d6-der-arbeitstag",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Der Arbeitstag",
    "ar": "يوم العمل"
  },
  "usedIn": [
    "a2-u11-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u11d6-l1",
      "speaker": "yusuf",
      "text": "Am Arbeitstag arbeite ich!",
      "direction": "يوسف يتحدث عن يومه"
    },
    {
      "id": "a2u11d6-l2",
      "speaker": "lena",
      "text": "Und am Werktag?",
      "direction": "لينا تسأل عن أيام الأسبوع"
    },
    {
      "id": "a2u11d6-l3",
      "speaker": "yusuf",
      "text": "Auch! Aber abends ruhe ich mich aus.",
      "direction": "يوسف يجيب"
    },
    {
      "id": "a2u11d6-l4",
      "speaker": "lena",
      "text": "Und deine Zukunft?",
      "direction": "لينا تسأل عن المستقبل"
    },
    {
      "id": "a2u11d6-l5",
      "speaker": "yusuf",
      "text": "Die ist gut! Ich lerne viel.",
      "direction": "يوسف متفائل"
    },
    {
      "id": "a2u11d6-l6",
      "speaker": "lena",
      "text": "Das glaube ich dir!",
      "direction": "لينا تصدقه"
    },
    {
      "id": "a2u11d6-l7",
      "speaker": "yusuf",
      "text": "Und deine Pläne?",
      "direction": "يوسف يسألها عن خططها"
    },
    {
      "id": "a2u11d6-l8",
      "speaker": "lena",
      "text": "Auch gut! Wir arbeiten zusammen.",
      "direction": "لينا تخطط معه"
    }
  ]
}
