{
  "schemaVersion": "1.0.0",
  "id": "a2-u12-d1-die-pruefung",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Die Prüfung",
    "ar": "الامتحان"
  },
  "usedIn": [
    "a2-u12-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u12d1-l1",
      "speaker": "yusuf",
      "text": "Die Prüfung ist auf Deutsch!",
      "direction": "يوسف قلق من الامتحان"
    },
    {
      "id": "a2u12d1-l2",
      "speaker": "lena",
      "text": "Kein Problem! Schreib auf den Antwortbogen.",
      "direction": "لينا تطمئنه"
    },
    {
      "id": "a2u12d1-l3",
      "speaker": "yusuf",
      "text": "Und wenn ich eine Frage nicht verstehe?",
      "direction": "يوسف يسأل عن الصعوبات"
    },
    {
      "id": "a2u12d1-l4",
      "speaker": "lena",
      "text": "Dann frage den Prüfer!",
      "direction": "لينا تعطي نصيحة"
    },
    {
      "id": "a2u12d1-l5",
      "speaker": "yusuf",
      "text": "Kann ich das Wörterbuch benutzen?",
      "direction": "يوسف يسأل عن القاموس"
    },
    {
      "id": "a2u12d1-l6",
      "speaker": "lena",
      "text": "Nein! Aber du machst das Abitur bald.",
      "direction": "لينا تشجعه"
    },
    {
      "id": "a2u12d1-l7",
      "speaker": "yusuf",
      "text": "Du hast recht. Ich bin bereit!",
      "direction": "يوسف يشعر بالثقة"
    },
    {
      "id": "a2u12d1-l8",
      "speaker": "lena",
      "text": "So ist es richtig!",
      "direction": "لينا تؤكد"
    }
  ]
}
