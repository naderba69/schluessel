{
  "schemaVersion": "1.0.0",
  "id": "a2-u12-d2-meine-faecher",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Meine Fächer",
    "ar": "موادي الدراسية"
  },
  "usedIn": [
    "a2-u12-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u12d2-l1",
      "speaker": "thomas",
      "text": "Magst du Biologie?",
      "direction": "توماس يسأل عن المواد"
    },
    {
      "id": "a2u12d2-l2",
      "speaker": "yusuf",
      "text": "Ja! Aber Chemie ist schwer.",
      "direction": "يوسف يجيب"
    },
    {
      "id": "a2u12d2-l3",
      "speaker": "thomas",
      "text": "Und Physik?",
      "direction": "توماس يسأل عن الفيزياء"
    },
    {
      "id": "a2u12d2-l4",
      "speaker": "yusuf",
      "text": "Die ist auch schwer. Aber ich helfe gern.",
      "direction": "يوسف يعترف بصعوبتها"
    },
    {
      "id": "a2u12d2-l5",
      "speaker": "thomas",
      "text": "Ich baue gern Häuser.",
      "direction": "توماس يشاركه هوايته"
    },
    {
      "id": "a2u12d2-l6",
      "speaker": "yusuf",
      "text": "Gut! Welches Fach magst du am besten?",
      "direction": "يوسف يسأل عن مادته المفضلة"
    },
    {
      "id": "a2u12d2-l7",
      "speaker": "thomas",
      "text": "Sport!",
      "direction": "توماس يجيب بسرعة"
    },
    {
      "id": "a2u12d2-l8",
      "speaker": "yusuf",
      "text": "Natürlich!",
      "direction": "يوسف يضحك"
    }
  ]
}
