{
  "schemaVersion": "1.0.0",
  "id": "a2-u12-d3-mathe-und-mehr",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Mathe und mehr",
    "ar": "الرياضيات وغيرها"
  },
  "usedIn": [
    "a2-u12-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u12d3-l1",
      "speaker": "lena",
      "text": "Ich weiß, dass Mathematik schwer ist!",
      "direction": "لينا تعترف بالصعوبة"
    },
    {
      "id": "a2u12d3-l2",
      "speaker": "yusuf",
      "text": "Aber interessant! Und Latein?",
      "direction": "يوسف يسأل عن اللاتينية"
    },
    {
      "id": "a2u12d3-l3",
      "speaker": "lena",
      "text": "Latein ist alt. Magst du Geografie?",
      "direction": "لينا تجيب ثم تسأل"
    },
    {
      "id": "a2u12d3-l4",
      "speaker": "yusuf",
      "text": "Ja! Und Religion?",
      "direction": "يوسف يجيب ويسأل"
    },
    {
      "id": "a2u12d3-l5",
      "speaker": "lena",
      "text": "Die ist ruhig. Und Sozialkunde?",
      "direction": "لينا تصف المواد"
    },
    {
      "id": "a2u12d3-l6",
      "speaker": "yusuf",
      "text": "Die mag ich! Man lernt viel über Leute.",
      "direction": "يوسف يعبر عن رأيه"
    },
    {
      "id": "a2u12d3-l7",
      "speaker": "lena",
      "text": "Also: jedes Fach hat etwas Gutes!",
      "direction": "لينا تستنتج"
    },
    {
      "id": "a2u12d3-l8",
      "speaker": "yusuf",
      "text": "Genau so sehe ich es auch!",
      "direction": "يوسف يتفق"
    }
  ]
}
