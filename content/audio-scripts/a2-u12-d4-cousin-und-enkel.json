{
  "schemaVersion": "1.0.0",
  "id": "a2-u12-d4-cousin-und-enkel",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Cousin und Enkel",
    "ar": "الابن العم والحفيد"
  },
  "usedIn": [
    "a2-u12-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u12d4-l1",
      "speaker": "yusuf",
      "text": "Mein Cousin ist wirklich nett!",
      "direction": "يوسف يتحدث عن ابن عمه"
    },
    {
      "id": "a2u12d4-l2",
      "speaker": "lena",
      "text": "Und deine Cousine?",
      "direction": "لينا تسأل عن ابنة عمه"
    },
    {
      "id": "a2u12d4-l3",
      "speaker": "yusuf",
      "text": "Sie ist auch nett! Manche Leute sind einfach so.",
      "direction": "يوسف يجيب"
    },
    {
      "id": "a2u12d4-l4",
      "speaker": "lena",
      "text": "Und deine Großeltern?",
      "direction": "لينا تسأل عن الأجداد"
    },
    {
      "id": "a2u12d4-l5",
      "speaker": "yusuf",
      "text": "Mein Opa ruft immer: Komm her, Enkel!",
      "direction": "يوسف يقلد جده"
    },
    {
      "id": "a2u12d4-l6",
      "speaker": "lena",
      "text": "Er ist lustig.",
      "direction": "لينا تضحك"
    },
    {
      "id": "a2u12d4-l7",
      "speaker": "yusuf",
      "text": "Ja! Manche Omas und Opas sind die Besten.",
      "direction": "يوسف يحب جديه"
    },
    {
      "id": "a2u12d4-l8",
      "speaker": "lena",
      "text": "Das stimmt!",
      "direction": "لينا توافق"
    }
  ]
}
