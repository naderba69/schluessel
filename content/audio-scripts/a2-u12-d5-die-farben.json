{
  "schemaVersion": "1.0.0",
  "id": "a2-u12-d5-die-farben",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Die Farben",
    "ar": "الألوان"
  },
  "usedIn": [
    "a2-u12-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u12d5-l1",
      "speaker": "ayse",
      "text": "Da! Das graue Haus.",
      "direction": "عائشة تشير إلى المنزل"
    },
    {
      "id": "a2u12d5-l2",
      "speaker": "yusuf",
      "text": "Und das lila Auto daneben!",
      "direction": "يوسف يضيف تفاصيل"
    },
    {
      "id": "a2u12d5-l3",
      "speaker": "ayse",
      "text": "Rosa ist auch schön.",
      "direction": "عائشة تحب اللون الوردي"
    },
    {
      "id": "a2u12d5-l4",
      "speaker": "yusuf",
      "text": "Aber mir gefällt blau am besten.",
      "direction": "يوسف يفضل الأزرق"
    },
    {
      "id": "a2u12d5-l5",
      "speaker": "ayse",
      "text": "Du bist wirklich anders!",
      "direction": "عائشة تمزح"
    },
    {
      "id": "a2u12d5-l6",
      "speaker": "yusuf",
      "text": "Danke! Und die Schule ist offen.",
      "direction": "يوسف يغير الموضوع"
    },
    {
      "id": "a2u12d5-l7",
      "speaker": "ayse",
      "text": "Komm! Wir gehen durch die Tür.",
      "direction": "عائشة تقترح الدخول"
    },
    {
      "id": "a2u12d5-l8",
      "speaker": "yusuf",
      "text": "Gern! Der Tag ist schön.",
      "direction": "يوسف يوافق"
    }
  ]
}
