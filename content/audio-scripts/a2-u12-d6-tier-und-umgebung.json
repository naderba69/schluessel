{
  "schemaVersion": "1.0.0",
  "id": "a2-u12-d6-tier-und-umgebung",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Die Tiere und die Umgebung",
    "ar": "الحيوانات والمحيط"
  },
  "usedIn": [
    "a2-u12-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u12d6-l1",
      "speaker": "thomas",
      "text": "Der Vogel ist klein!",
      "direction": "توماس يراقب الطائر"
    },
    {
      "id": "a2u12d6-l2",
      "speaker": "yusuf",
      "text": "Und das Pferd ist groß!",
      "direction": "يوسف ينظر إلى الحصان"
    },
    {
      "id": "a2u12d6-l3",
      "speaker": "thomas",
      "text": "Die See! Sie ist blau.",
      "direction": "توماس يشير إلى البحر"
    },
    {
      "id": "a2u12d6-l4",
      "speaker": "yusuf",
      "text": "Sehr schön! Und dort ist ein armes Tier.",
      "direction": "يوسف يلاحظ الحيوان"
    },
    {
      "id": "a2u12d6-l5",
      "speaker": "thomas",
      "text": "Es will essen!",
      "direction": "توماس يشعر بالشفقة"
    },
    {
      "id": "a2u12d6-l6",
      "speaker": "yusuf",
      "text": "Gib ihm etwas Brot!",
      "direction": "يوسف يقترح المساعدة"
    },
    {
      "id": "a2u12d6-l7",
      "speaker": "thomas",
      "text": "Gute Idee! Tiere sind unsere Freunde.",
      "direction": "توماس يتفق"
    },
    {
      "id": "a2u12d6-l8",
      "speaker": "yusuf",
      "text": "Und wir leben in der Natur.",
      "direction": "يوسف يختم بحكمة"
    }
  ]
}
