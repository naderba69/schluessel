{
  "schemaVersion": "1.0.0",
  "id": "a2-u13-d1-tageszeiten",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Meine Tageszeiten",
    "ar": "أوقاتي اليومية"
  },
  "usedIn": [
    "a2-u13-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u13d1-l1",
      "speaker": "lena",
      "text": "Am Vormittag lerne ich Deutsch!",
      "direction": "لينا تبدأ يومها"
    },
    {
      "id": "a2u13d1-l2",
      "speaker": "yusuf",
      "text": "Und am Mittag?",
      "direction": "يوسف يسأل عن الظهيرة"
    },
    {
      "id": "a2u13d1-l3",
      "speaker": "lena",
      "text": "Da esse ich Brot. Am Nachmittag spiele ich Fußball.",
      "direction": "لينا تسرد يومها"
    },
    {
      "id": "a2u13d1-l4",
      "speaker": "yusuf",
      "text": "Und am Abend?",
      "direction": "يوسف يسأل عن المساء"
    },
    {
      "id": "a2u13d1-l5",
      "speaker": "lena",
      "text": "Da lese ich ein Buch. Und du?",
      "direction": "لينا تجيب ثم تسأل"
    },
    {
      "id": "a2u13d1-l6",
      "speaker": "yusuf",
      "text": "Ich arbeite am Vormittag und ruhe mich am Abend aus.",
      "direction": "يوسف يصف يومه"
    },
    {
      "id": "a2u13d1-l7",
      "speaker": "lena",
      "text": "So ist es gut!",
      "direction": "لينا تعجب بالتنظيم"
    },
    {
      "id": "a2u13d1-l8",
      "speaker": "yusuf",
      "text": "Ja! Jede Zeit ist wichtig.",
      "direction": "يوسف يوافقها"
    }
  ]
}
