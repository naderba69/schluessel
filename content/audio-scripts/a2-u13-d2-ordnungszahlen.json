{
  "schemaVersion": "1.0.0",
  "id": "a2-u13-d2-ordnungszahlen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Der erste Tag, die zweite Woche",
    "ar": "اليوم الأول والأسبوع الثاني"
  },
  "usedIn": [
    "a2-u13-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u13d2-l1",
      "speaker": "yusuf",
      "text": "Der erste Tag ist schön!",
      "direction": "يوسف يعدّ الأيام"
    },
    {
      "id": "a2u13d2-l2",
      "speaker": "lena",
      "text": "Die zweite Stunde ist kurz!",
      "direction": "لينا تعلّق على الدراسة"
    },
    {
      "id": "a2u13d2-l3",
      "speaker": "yusuf",
      "text": "Das dritte Buch ist gut.",
      "direction": "يوسف يتحدث عن الكتب"
    },
    {
      "id": "a2u13d2-l4",
      "speaker": "lena",
      "text": "Und die vierte Woche ist lang!",
      "direction": "لينا تعلّق على الأسبوع"
    },
    {
      "id": "a2u13d2-l5",
      "speaker": "yusuf",
      "text": "Der fünfte Monat kommt bald.",
      "direction": "يوسف يتحدث عن الوقت"
    },
    {
      "id": "a2u13d2-l6",
      "speaker": "lena",
      "text": "Und das sechste Mal lernen wir wieder!",
      "direction": "لينا تتحدث عن التكرار"
    },
    {
      "id": "a2u13d2-l7",
      "speaker": "yusuf",
      "text": "Die Ordnung hilft beim Lernen.",
      "direction": "يوسف يوضح الفائدة"
    },
    {
      "id": "a2u13d2-l8",
      "speaker": "lena",
      "text": "Stimmt! Erst das Erste, dann das Zweite.",
      "direction": "لينا توافق"
    }
  ]
}
