{
  "schemaVersion": "1.0.0",
  "id": "a2-u13-d3-zweimal-am-tag",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Zweimal am Tag",
    "ar": "مرتين في اليوم"
  },
  "usedIn": [
    "a2-u13-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u13d3-l1",
      "speaker": "thomas",
      "text": "Ich trinke zweimal Kaffee!",
      "direction": "توماس يتحدث عن عاداته"
    },
    {
      "id": "a2u13d3-l2",
      "speaker": "yusuf",
      "text": "Und ich esse dreimal am Tag.",
      "direction": "يوسف يتحدث عن أكله"
    },
    {
      "id": "a2u13d3-l3",
      "speaker": "thomas",
      "text": "Ich spiele viermal pro Woche Fußball.",
      "direction": "توماس يتحدث عن رياضته"
    },
    {
      "id": "a2u13d3-l4",
      "speaker": "yusuf",
      "text": "Und noch einmal, bitte!",
      "direction": "يوسف يطلب إضافة"
    },
    {
      "id": "a2u13d3-l5",
      "speaker": "thomas",
      "text": "Noch einmal? Du isst viel!",
      "direction": "توماس يضحك"
    },
    {
      "id": "a2u13d3-l6",
      "speaker": "yusuf",
      "text": "Ja! Und dann trainiere ich.",
      "direction": "يوسف يبرر"
    },
    {
      "id": "a2u13d3-l7",
      "speaker": "thomas",
      "text": "Wie oft?",
      "direction": "توماس يسأل عن عدد المرات"
    },
    {
      "id": "a2u13d3-l8",
      "speaker": "yusuf",
      "text": "Zweimal! Genug für heute.",
      "direction": "يوسف يجيب"
    }
  ]
}
