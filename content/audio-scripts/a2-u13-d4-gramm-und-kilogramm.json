{
  "schemaVersion": "1.0.0",
  "id": "a2-u13-d4-gramm-und-kilogramm",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Ein Gramm Salz",
    "ar": "غرام من الملح"
  },
  "usedIn": [
    "a2-u13-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u13d4-l1",
      "speaker": "lena",
      "text": "Ein Gramm Salz ist genug!",
      "direction": "لينا تتحدث عن الطبخ"
    },
    {
      "id": "a2u13d4-l2",
      "speaker": "yusuf",
      "text": "Und ein Kilogramm Äpfel?",
      "direction": "يوسف يسأل عن التفاح"
    },
    {
      "id": "a2u13d4-l3",
      "speaker": "lena",
      "text": "Das ist zu viel! Ein halbes reicht.",
      "direction": "لينا تعطي رأيها"
    },
    {
      "id": "a2u13d4-l4",
      "speaker": "yusuf",
      "text": "Gut. Und eine Flasche Milch?",
      "direction": "يوسف يسأل عن الحليب"
    },
    {
      "id": "a2u13d4-l5",
      "speaker": "lena",
      "text": "Das stimmt! So kochen wir richtig.",
      "direction": "لينا توافق"
    },
    {
      "id": "a2u13d4-l6",
      "speaker": "yusuf",
      "text": "Wie viel kostet ein Kilogramm Brot?",
      "direction": "يوسف يسأل عن السعر"
    },
    {
      "id": "a2u13d4-l7",
      "speaker": "lena",
      "text": "Nicht viel! Gehen wir einkaufen.",
      "direction": "لينا تقترح التسوق"
    },
    {
      "id": "a2u13d4-l8",
      "speaker": "yusuf",
      "text": "Mit einem Zettel!",
      "direction": "يوسف ينظم المشتريات"
    }
  ]
}
