{
  "schemaVersion": "1.0.0",
  "id": "a2-u13-d5-nationalitaeten",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Ich bin Luxemburger!",
    "ar": "أنا لوكسمبورغي!"
  },
  "usedIn": [
    "a2-u13-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u13d5-l1",
      "speaker": "thomas",
      "text": "Ich bin Luxemburger!",
      "direction": "توماس يتحدث عن جنسيته"
    },
    {
      "id": "a2u13d5-l2",
      "speaker": "yusuf",
      "text": "Und ich bin Tunesier.",
      "direction": "يوسف يتحدث عن جنسيته"
    },
    {
      "id": "a2u13d5-l3",
      "speaker": "thomas",
      "text": "Er ist Deutscher und sie ist Deutsche.",
      "direction": "توماس يصف الآخرين"
    },
    {
      "id": "a2u13d5-l4",
      "speaker": "yusuf",
      "text": "Und sprichst du Luxemburgisch?",
      "direction": "يوسف يسأل عن اللغة"
    },
    {
      "id": "a2u13d5-l5",
      "speaker": "thomas",
      "text": "Ein bisschen! Aber Deutsch ist besser.",
      "direction": "توماس يجيب"
    },
    {
      "id": "a2u13d5-l6",
      "speaker": "yusuf",
      "text": "Ich spreche auch Arabisch.",
      "direction": "يوسف يتحدث عن لغاته"
    },
    {
      "id": "a2u13d5-l7",
      "speaker": "thomas",
      "text": "Stark! Viele Sprachen, viele Freunde.",
      "direction": "توماس يعجب"
    },
    {
      "id": "a2u13d5-l8",
      "speaker": "yusuf",
      "text": "Das ist sehr gut!",
      "direction": "يوسف يختم"
    }
  ]
}
