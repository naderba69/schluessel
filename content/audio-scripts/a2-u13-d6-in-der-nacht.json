{
  "schemaVersion": "1.0.0",
  "id": "a2-u13-d6-in-der-nacht",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "In der Nacht",
    "ar": "في الليل"
  },
  "usedIn": [
    "a2-u13-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u13d6-l1",
      "speaker": "ayse",
      "text": "In der Nacht schlafe ich!",
      "direction": "عائشة تتحدث عن ليلها"
    },
    {
      "id": "a2u13d6-l2",
      "speaker": "yusuf",
      "text": "Und um Mitternacht?",
      "direction": "يوسف يسأل عن منتصف الليل"
    },
    {
      "id": "a2u13d6-l3",
      "speaker": "ayse",
      "text": "Da schlafe ich schon! Und du?",
      "direction": "عائشة تسأله"
    },
    {
      "id": "a2u13d6-l4",
      "speaker": "yusuf",
      "text": "Manchmal lese ich bis spät.",
      "direction": "يوسف يعترف"
    },
    {
      "id": "a2u13d6-l5",
      "speaker": "ayse",
      "text": "Das ist nicht gesund!",
      "direction": "عائشة تحذره"
    },
    {
      "id": "a2u13d6-l6",
      "speaker": "yusuf",
      "text": "Du hast recht. Aber die Nacht ist ruhig.",
      "direction": "يوسف يبرر عادته"
    },
    {
      "id": "a2u13d6-l7",
      "speaker": "ayse",
      "text": "Der erste Tag ist besser mit Schlaf!",
      "direction": "عائشة تعطي نصيحة"
    },
    {
      "id": "a2u13d6-l8",
      "speaker": "yusuf",
      "text": "Gut! Heute gehe ich früh ins Bett.",
      "direction": "يوسف يعد بالتغيير"
    }
  ]
}
