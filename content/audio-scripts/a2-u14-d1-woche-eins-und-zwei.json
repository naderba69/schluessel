{
  "schemaVersion": "1.0.0",
  "id": "a2-u14-d1-woche-eins-und-zwei",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Woche eins und zwei",
    "ar": "الأسبوعان الأول والثاني"
  },
  "usedIn": [
    "a2-u14-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u14d1-l1",
      "speaker": "yusuf",
      "text": "Woche eins und zwei: alles noch einmal!",
      "direction": "يوسف يراجع ما سبق"
    },
    {
      "id": "a2u14d1-l2",
      "speaker": "lena",
      "text": "Ja! Dein Morgen, dein Tag.",
      "direction": "لينا تتذكر الدروس"
    },
    {
      "id": "a2u14d1-l3",
      "speaker": "yusuf",
      "text": "Und mein Zeugnis und mein Stift!",
      "direction": "يوسف يضحك"
    },
    {
      "id": "a2u14d1-l4",
      "speaker": "lena",
      "text": "Der Stift ist noch da!",
      "direction": "لينا تمزح"
    },
    {
      "id": "a2u14d1-l5",
      "speaker": "yusuf",
      "text": "Gut! Und die Ferien und die Feier.",
      "direction": "يوسف يكمل المراجعة"
    },
    {
      "id": "a2u14d1-l6",
      "speaker": "lena",
      "text": "Und haben und sein!",
      "direction": "لينا تتذكر القواعد"
    },
    {
      "id": "a2u14d1-l7",
      "speaker": "yusuf",
      "text": "Das Beste: üben, üben, üben!",
      "direction": "يوسف يلخص القاعدة"
    },
    {
      "id": "a2u14d1-l8",
      "speaker": "lena",
      "text": "So ist es richtig!",
      "direction": "لينا تؤكد"
    }
  ]
}
