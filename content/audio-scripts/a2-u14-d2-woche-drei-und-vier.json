{
  "schemaVersion": "1.0.0",
  "id": "a2-u14-d2-woche-drei-und-vier",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Woche drei und vier",
    "ar": "الأسبوعان الثالث والرابع"
  },
  "usedIn": [
    "a2-u14-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u14d2-l1",
      "speaker": "thomas",
      "text": "Woche drei und vier: was können wir?",
      "direction": "توماس يبدأ المراجعة"
    },
    {
      "id": "a2u14d2-l2",
      "speaker": "yusuf",
      "text": "Wir können Aufgaben beschreiben!",
      "direction": "يوسف يجيب"
    },
    {
      "id": "a2u14d2-l3",
      "speaker": "thomas",
      "text": "Und Meinungen sagen!",
      "direction": "توماس يضيف"
    },
    {
      "id": "a2u14d2-l4",
      "speaker": "yusuf",
      "text": "Und E-Mails schreiben!",
      "direction": "يوسف يكمل القائمة"
    },
    {
      "id": "a2u14d2-l5",
      "speaker": "thomas",
      "text": "Und moderne Sachen kaufen!",
      "direction": "توماس يذكر التسوق"
    },
    {
      "id": "a2u14d2-l6",
      "speaker": "yusuf",
      "text": "Drinnen und draußen!",
      "direction": "يوسف يصف الأماكن"
    },
    {
      "id": "a2u14d2-l7",
      "speaker": "thomas",
      "text": "Wir haben viel gelernt!",
      "direction": "توماس يشعر بالتقدم"
    },
    {
      "id": "a2u14d2-l8",
      "speaker": "yusuf",
      "text": "Und noch mehr zu lernen!",
      "direction": "يوسف يتفاءل"
    }
  ]
}
