{
  "schemaVersion": "1.0.0",
  "id": "a2-u14-d3-woche-fuenf-und-sechs",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Woche fünf und sechs",
    "ar": "الأسبوعان الخامس والسادس"
  },
  "usedIn": [
    "a2-u14-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u14d3-l1",
      "speaker": "lena",
      "text": "Woche fünf und sechs: die Party!",
      "direction": "لينا تتذكر الحفلة"
    },
    {
      "id": "a2u14d3-l2",
      "speaker": "yusuf",
      "text": "Ja! Die Party war gut.",
      "direction": "يوسف يتذكر"
    },
    {
      "id": "a2u14d3-l3",
      "speaker": "lena",
      "text": "Und das Leben zu Hause!",
      "direction": "لينا تتذكر القواعد"
    },
    {
      "id": "a2u14d3-l4",
      "speaker": "yusuf",
      "text": "Wenigstens haben wir sie gelernt!",
      "direction": "يوسف يمزح"
    },
    {
      "id": "a2u14d3-l5",
      "speaker": "lena",
      "text": "Und die Sache mit dem Kochen!",
      "direction": "لينا تتذكر الطبخ"
    },
    {
      "id": "a2u14d3-l6",
      "speaker": "yusuf",
      "text": "Die Bohnen waren weich!",
      "direction": "يوسف يضحك"
    },
    {
      "id": "a2u14d3-l7",
      "speaker": "lena",
      "text": "Alles war wichtig.",
      "direction": "لينا تعلّق"
    },
    {
      "id": "a2u14d3-l8",
      "speaker": "yusuf",
      "text": "Jede Sache ist wichtig!",
      "direction": "يوسف يختم"
    }
  ]
}
