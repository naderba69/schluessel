  "id": "a2-u14-d4-woche-sieben-und-acht",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Woche sieben und acht",
    "ar": "الأسبوعان السابع والثامن"
  },
  "usedIn": [
    "a2-u14-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u14d4-l1",
      "speaker": "ayse",
      "text": "Wetter und Aussehen: das war Woche sieben!",
      "direction": "عائشة تراجع الدروس"
    },
    {
      "id": "a2u14d4-l2",
      "speaker": "yusuf",
      "text": "Der kühle Abend und die blonde Frau!",
      "direction": "يوسف يتذكر الأمثلة"
    },
    {
      "id": "a2u14d4-l3",
      "speaker": "ayse",
      "text": "Und Woche acht?",
      "direction": "عائشة تنتقل للأسبوع التالي"
    },
    {
      "id": "a2u14d4-l4",
      "speaker": "yusuf",
      "text": "Das Blatt und die Nachrichten!",
      "direction": "يوسف يجيب"
    },
    {
      "id": "a2u14d4-l5",
      "speaker": "ayse",
      "text": "Und der eigene Blog!",
      "direction": "عائشة تتذكر التقنية"
    },
    {
      "id": "a2u14d4-l6",
      "speaker": "yusuf",
      "text": "Ja! Ich schreibe jetzt gern.",
      "direction": "يوسف يشعر بالتطور"
    },
    {
      "id": "a2u14d4-l7",
      "speaker": "ayse",
      "text": "Dein Deutsch wird besser!",
      "direction": "عائشة تمدح تقدمه"
    },
    {
      "id": "a2u14d4-l8",
      "speaker": "yusuf",
      "text": "Danke! Und deine Hilfe auch.",
      "direction": "يوسف يشكرها"
    }
  ]
}
