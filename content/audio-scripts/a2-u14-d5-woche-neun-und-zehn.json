{
  "schemaVersion": "1.0.0",
  "id": "a2-u14-d5-woche-neun-und-zehn",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Woche neun und zehn",
    "ar": "الأسبوعان التاسع والعاشر"
  },
  "usedIn": [
    "a2-u14-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u14d5-l1",
      "speaker": "lena",
      "text": "Wir werden fahren — auf jeden Fall!",
      "direction": "لينا تتذكر الجملة"
    },
    {
      "id": "a2u14d5-l2",
      "speaker": "yusuf",
      "text": "Und der Kunde und der Polizist!",
      "direction": "يوسف يتذكر الشخصيات"
    },
    {
      "id": "a2u14d5-l3",
      "speaker": "lena",
      "text": "Und die Länder und die Reisen!",
      "direction": "لينا تكمل"
    },
    {
      "id": "a2u14d5-l4",
      "speaker": "yusuf",
      "text": "Der Europäer und der Franke!",
      "direction": "يوسف يضحك"
    },
    {
      "id": "a2u14d5-l5",
      "speaker": "lena",
      "text": "Und das WC und die Hilfe!",
      "direction": "لينا تتذكر التفاصيل"
    },
    {
      "id": "a2u14d5-l6",
      "speaker": "yusuf",
      "text": "Alles war nützlich.",
      "direction": "يوسف يقيّم الدروس"
    },
    {
      "id": "a2u14d5-l7",
      "speaker": "lena",
      "text": "Besonders die Reisen!",
      "direction": "لينا تحب السفر"
    },
    {
      "id": "a2u14d5-l8",
      "speaker": "yusuf",
      "text": "Nächste Woche: neue Sachen!",
      "direction": "يوسف يتفاءل"
    }
  ]
}
