{
  "schemaVersion": "1.0.0",
  "id": "a2-u14-d6-woche-bis-dreizehn",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Woche elf bis dreizehn",
    "ar": "الأسبوع 11 إلى 13"
  },
  "usedIn": [
    "a2-u14-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u14d6-l1",
      "speaker": "thomas",
      "text": "Der letzte Tag! Woche elf bis dreizehn.",
      "direction": "توماس يعلن نهاية الدورة"
    },
    {
      "id": "a2u14d6-l2",
      "speaker": "yusuf",
      "text": "Ich würde gern Koch werden!",
      "direction": "يوسف يتذكر حلمه"
    },
    {
      "id": "a2u14d6-l3",
      "speaker": "thomas",
      "text": "Und die Fächer und die Prüfung!",
      "direction": "توماس يتذكر المدرسة"
    },
    {
      "id": "a2u14d6-l4",
      "speaker": "yusuf",
      "text": "Und die Tiere und die Natur!",
      "direction": "يوسف يتذكر الطبيعة"
    },
    {
      "id": "a2u14d6-l5",
      "speaker": "thomas",
      "text": "Die Arbeitstage und die Pferde!",
      "direction": "توماس يمزح"
    },
    {
      "id": "a2u14d6-l6",
      "speaker": "yusuf",
      "text": "In der Nacht und am Morgen!",
      "direction": "يوسف يكمل"
    },
    {
      "id": "a2u14d6-l7",
      "speaker": "thomas",
      "text": "Wir haben alles gelernt!",
      "direction": "توماس يشعر بالفخر"
    },
    {
      "id": "a2u14d6-l8",
      "speaker": "yusuf",
      "text": "Bis zum nächsten Mal!",
      "direction": "يوسف يختم الدورة"
    }
  ]
}
