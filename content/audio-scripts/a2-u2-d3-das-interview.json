{
  "schemaVersion": "1.0.0",
  "id": "a2-u2-d3-das-interview",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Das Interview für die Ausbildung",
    "ar": "مقابلة التدريب"
  },
  "usedIn": [
    "a2-u2-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u2d3-l1",
      "speaker": "dr-weber",
      "text": "Guten Tag! Erzählen Sie über sich.",
      "direction": "الدكتور ويبر يفتح المقابلة"
    },
    {
      "id": "a2u2d3-l2",
      "speaker": "yusuf",
      "text": "Gern! Ich habe Erfahrung gesammelt und kenne viele Leute.",
      "direction": "يوسف يجيب بثقة"
    },
    {
      "id": "a2u2d3-l3",
      "speaker": "dr-weber",
      "text": "Was können Sie gut?",
      "direction": "الدكتور يسأل عن نقاط القوة"
    },
    {
      "id": "a2u2d3-l4",
      "speaker": "yusuf",
      "text": "Ich bin sympathisch und kann gut antworten.",
      "direction": "يوسف يبسم"
    },
    {
      "id": "a2u2d3-l5",
      "speaker": "dr-weber",
      "text": "Warum möchten Sie bei uns arbeiten?",
      "direction": "الدكتور يسأل عن الدافع"
    },
    {
      "id": "a2u2d3-l6",
      "speaker": "yusuf",
      "text": "Weil ich hier arbeiten möchte!",
      "direction": "يوسف يشرح دوافعه"
    },
    {
      "id": "a2u2d3-l7",
      "speaker": "dr-weber",
      "text": "Gut! Wir geben Ihnen dann Bescheid.",
      "direction": "الدكتور يختم المقابلة"
    },
    {
      "id": "a2u2d3-l8",
      "speaker": "yusuf",
      "text": "Danke! Das Interview war nett.",
      "direction": "يوسف يشكره ويخرج"
    }
  ]
}
