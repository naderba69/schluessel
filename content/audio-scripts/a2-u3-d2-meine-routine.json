{
  "schemaVersion": "1.0.0",
  "id": "a2-u3-d2-meine-routine",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Meine Routine am Tag",
    "ar": "روتيني اليومي"
  },
  "usedIn": [
    "a2-u3-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u3d2-l1",
      "speaker": "ayse",
      "text": "Was machst du am Tag?",
      "direction": "عائشة تسأل عن الروتين"
    },
    {
      "id": "a2u3d2-l2",
      "speaker": "lena",
      "text": "Morgens wasche ich mir das Gesicht.",
      "direction": "لينا تبدأ من الصباح"
    },
    {
      "id": "a2u3d2-l3",
      "speaker": "ayse",
      "text": "Und mittags?",
      "direction": "عائشة تسأل عن الظهيرة"
    },
    {
      "id": "a2u3d2-l4",
      "speaker": "lena",
      "text": "Mittags esse ich, abends lese ich.",
      "direction": "لينا تسرد يومها"
    },
    {
      "id": "a2u3d2-l5",
      "speaker": "ayse",
      "text": "Und nachts? Schläfst du gut?",
      "direction": "عائشة تسأل عن الليل"
    },
    {
      "id": "a2u3d2-l6",
      "speaker": "lena",
      "text": "Nachts schlafe ich gut.",
      "direction": "لينا تجيب بصراحة"
    },
    {
      "id": "a2u3d2-l7",
      "speaker": "ayse",
      "text": "Dann brauchst du Creme!",
      "direction": "عائشة تعطي نصيحة"
    },
    {
      "id": "a2u3d2-l8",
      "speaker": "lena",
      "text": "Täglich! Jeden Tag.",
      "direction": "لينا تؤكد عادتها"
    }
  ]
}
