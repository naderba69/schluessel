{
  "schemaVersion": "1.0.0",
  "id": "a2-u3-d4-tipps-schreiben",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Tipps schreiben",
    "ar": "كتابة النصائح"
  },
  "usedIn": [
    "a2-u3-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u3d4-l1",
      "speaker": "yusuf",
      "text": "Erstens: Markiere die neuen Wörter!",
      "direction": "يوسف يملي النصيحة الأولى"
    },
    {
      "id": "a2u3d4-l2",
      "speaker": "lena",
      "text": "Zweitens: Schreib die Wörter!",
      "direction": "لينا تضيف الثانية"
    },
    {
      "id": "a2u3d4-l3",
      "speaker": "yusuf",
      "text": "Drittens: Kontrolliere deine Sätze!",
      "direction": "يوسف يكمل القائمة"
    },
    {
      "id": "a2u3d4-l4",
      "speaker": "lena",
      "text": "Viertens: Diskutiere mit den Freunden!",
      "direction": "لينا تختم القائمة"
    },
    {
      "id": "a2u3d4-l5",
      "speaker": "yusuf",
      "text": "Und genug üben! Unbedingt jeden Tag.",
      "direction": "يوسف يشدد على الممارسة"
    },
    {
      "id": "a2u3d4-l6",
      "speaker": "lena",
      "text": "Egal ob schwer oder leicht!",
      "direction": "لينا تطمئنه"
    },
    {
      "id": "a2u3d4-l7",
      "speaker": "yusuf",
      "text": "Die Menge ist wichtig: wenig aber täglich.",
      "direction": "يوسف يلخص الفكرة"
    },
    {
      "id": "a2u3d4-l8",
      "speaker": "lena",
      "text": "Das ist ein guter Tipp!",
      "direction": "لينا توافق"
    }
  ]
}
