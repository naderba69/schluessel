{
  "schemaVersion": "1.0.0",
  "id": "a2-u4-d1-wo-ist-es",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Wo ist das Theater?",
    "ar": "أين المسرح؟"
  },
  "usedIn": [
    "a2-u4-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u4d1-l1",
      "speaker": "lena",
      "text": "Entschuldigung, wo ist das Theater?",
      "direction": "لينا تسأل عن الطريق"
    },
    {
      "id": "a2u4d1-l2",
      "speaker": "yusuf",
      "text": "Das Theater ist in der Stadt, neben dem Zoo.",
      "direction": "يوسف يشرح المكان"
    },
    {
      "id": "a2u4d1-l3",
      "speaker": "lena",
      "text": "Und die Bibliothek?",
      "direction": "لينا تسأل عن المكتبة"
    },
    {
      "id": "a2u4d1-l4",
      "speaker": "yusuf",
      "text": "Auch in der Stadt! Aber die Straße ist eng.",
      "direction": "يوسف يصف الطريق"
    },
    {
      "id": "a2u4d1-l5",
      "speaker": "lena",
      "text": "Ist da auch ein Flohmarkt?",
      "direction": "لينا تسأل عن السوق"
    },
    {
      "id": "a2u4d1-l6",
      "speaker": "yusuf",
      "text": "Ja, und das Rathaus ist ganz in der Nähe.",
      "direction": "يوسف يكمل الوصف"
    },
    {
      "id": "a2u4d1-l7",
      "speaker": "lena",
      "text": "Die Garage ist voll, oder?",
      "direction": "لينا تتذكر موقف السيارات"
    },
    {
      "id": "a2u4d1-l8",
      "speaker": "yusuf",
      "text": "Voll! Nimm lieber das Fahrrad.",
      "direction": "يوسف ينصحها"
    }
  ]
}
