{
  "schemaVersion": "1.0.0",
  "id": "a2-u4-d3-nach-dem-weg-fragen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Nach dem Weg fragen",
    "ar": "السؤال عن الطريق"
  },
  "usedIn": [
    "a2-u4-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u4d3-l1",
      "speaker": "lena",
      "text": "Entschuldigung, wo ist das Konzert?",
      "direction": "لينا تسأل عن الصالة"
    },
    {
      "id": "a2u4d3-l2",
      "speaker": "yusuf",
      "text": "Hören Sie zu: geradeaus, dann links!",
      "direction": "يوسف يصف الطريق بدقة"
    },
    {
      "id": "a2u4d3-l3",
      "speaker": "lena",
      "text": "Und das Kaufhaus?",
      "direction": "لينا تسأل عن المتجر"
    },
    {
      "id": "a2u4d3-l4",
      "speaker": "yusuf",
      "text": "Das ist vorn, am Verkehr.",
      "direction": "يوسف يشير للأمام"
    },
    {
      "id": "a2u4d3-l5",
      "speaker": "lena",
      "text": "Kann ich hier ein Fahrrad leihen?",
      "direction": "لينا تسأل عن كرائ"
    },
    {
      "id": "a2u4d3-l6",
      "speaker": "yusuf",
      "text": "Ja! Aber der Verkehr ist heute stark.",
      "direction": "يوسف ينصحها بالحذر"
    },
    {
      "id": "a2u4d3-l7",
      "speaker": "lena",
      "text": "Ach, ich möchte noch in den Club!",
      "direction": "لينا تحزن قليلاً"
    },
    {
      "id": "a2u4d3-l8",
      "speaker": "yusuf",
      "text": "Kein Problem! Der Rundgang dauert eine Stunde.",
      "direction": "يوسف يطمئنها"
    }
  ]
}
