{
  "schemaVersion": "1.0.0",
  "id": "a2-u4-d5-das-fest-planen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Das Fest planen",
    "ar": "تخطيط الحفلة"
  },
  "usedIn": [
    "a2-u4-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u4d5-l1",
      "speaker": "lena",
      "text": "Übermorgen ist das Fest! Bist du verabredet?",
      "direction": "لينا تذكر الحفلة"
    },
    {
      "id": "a2u4d5-l2",
      "speaker": "yusuf",
      "text": "Nein, ich bin freiwillig dabei!",
      "direction": "يوسف يتطوع"
    },
    {
      "id": "a2u4d5-l3",
      "speaker": "lena",
      "text": "Gut! Ich backe eine Torte.",
      "direction": "لينا تخبره بخططها"
    },
    {
      "id": "a2u4d5-l4",
      "speaker": "yusuf",
      "text": "Und ich bringe die Gitarre mit!",
      "direction": "يوسف يعرض المساعدة"
    },
    {
      "id": "a2u4d5-l5",
      "speaker": "lena",
      "text": "Gut! Und ein Quiz für die Gäste?",
      "direction": "لينا تقترح لعبة"
    },
    {
      "id": "a2u4d5-l6",
      "speaker": "yusuf",
      "text": "Gute Idee! Ich schenke dem Gewinner etwas.",
      "direction": "يوسف يتحمس"
    },
    {
      "id": "a2u4d5-l7",
      "speaker": "lena",
      "text": "Der Star des Abends bist du!",
      "direction": "لينا تمزح"
    },
    {
      "id": "a2u4d5-l8",
      "speaker": "yusuf",
      "text": "Ach was! Das Fest wird toll.",
      "direction": "يوسف يضحك"
    }
  ]
}
