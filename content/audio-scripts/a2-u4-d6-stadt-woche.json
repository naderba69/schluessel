{
  "schemaVersion": "1.0.0",
  "id": "a2-u4-d6-stadt-woche",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Meine Stadt-Woche",
    "ar": "أسبوعي في المدينة"
  },
  "usedIn": [
    "a2-u4-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u4d6-l1",
      "speaker": "thomas",
      "text": "Was hast du in der Stadt gemacht?",
      "direction": "توماس يسأل عن الأسبوع"
    },
    {
      "id": "a2u4d6-l2",
      "speaker": "yusuf",
      "text": "Am Montag war ich im Zoo.",
      "direction": "يوسف يبدأ من الاثنين"
    },
    {
      "id": "a2u4d6-l3",
      "speaker": "thomas",
      "text": "Und am Dienstag?",
      "direction": "توماس يسأل"
    },
    {
      "id": "a2u4d6-l4",
      "speaker": "yusuf",
      "text": "Da war der Flohmarkt im Zoo! Ich habe alles gesehen.",
      "direction": "يوسف يحكي عن السوق"
    },
    {
      "id": "a2u4d6-l5",
      "speaker": "thomas",
      "text": "Und drüben? Was war da?",
      "direction": "توماس يسأل عن الجهة الأخرى"
    },
    {
      "id": "a2u4d6-l6",
      "speaker": "yusuf",
      "text": "Drüben war eine Ausstellung. Sie war wirklich gut.",
      "direction": "يوسف يصف المعرض"
    },
    {
      "id": "a2u4d6-l7",
      "speaker": "thomas",
      "text": "Deine Woche war also voll!",
      "direction": "توماس يعلّق"
    },
    {
      "id": "a2u4d6-l8",
      "speaker": "yusuf",
      "text": "Voll! Aber schön.",
      "direction": "يوسف يختم بابتسامة"
    }
  ]
}
