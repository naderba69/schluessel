{
  "schemaVersion": "1.0.0",
  "id": "a2-u5-d1-geburtstagsparty",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Die Geburtstagsparty",
    "ar": "حفلة عيد الميلاد"
  },
  "usedIn": [
    "a2-u5-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u5d1-l1",
      "speaker": "lena",
      "text": "Die Party war gestern! Wie war sie?",
      "direction": "لينا تسأل عن الحفلة"
    },
    {
      "id": "a2u5d1-l2",
      "speaker": "yusuf",
      "text": "Toll! Die Band hat gespielt und wir haben getanzt.",
      "direction": "يوسف يحكي بحماس"
    },
    {
      "id": "a2u5d1-l3",
      "speaker": "lena",
      "text": "Und das Radio? Die Plakate?",
      "direction": "لينا تسأل عن التجهيزات"
    },
    {
      "id": "a2u5d1-l4",
      "speaker": "yusuf",
      "text": "Ich habe alles schön gemacht und alles gepackt.",
      "direction": "يوسف يصف تجهيزاته"
    },
    {
      "id": "a2u5d1-l5",
      "speaker": "lena",
      "text": "War da ein Rätsel?",
      "direction": "لينا تحب الألعاب"
    },
    {
      "id": "a2u5d1-l6",
      "speaker": "yusuf",
      "text": "Ja! Und Pizza natürlich. Der Kontakt war kostenlos.",
      "direction": "يوسف يختم القائمة"
    },
    {
      "id": "a2u5d1-l7",
      "speaker": "lena",
      "text": "Und das Programm?",
      "direction": "لينا تسأل عن برنامج الحفل"
    },
    {
      "id": "a2u5d1-l8",
      "speaker": "yusuf",
      "text": "Gut! Das Instrument war mein Geschenk.",
      "direction": "يوسف يفخر بخطته"
    }
  ]
}
