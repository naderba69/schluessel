{
  "schemaVersion": "1.0.0",
  "id": "a2-u5-d2-frohe-weihnachten",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Frohe Weihnachten!",
    "ar": "عيد ميلاد سعيد!"
  },
  "usedIn": [
    "a2-u5-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u5d2-l1",
      "speaker": "ayse",
      "text": "Frohe Weihnachten, Yusuf!",
      "direction": "عائشة تهنئه"
    },
    {
      "id": "a2u5d2-l2",
      "speaker": "yusuf",
      "text": "Danke! Frohe Weihnachten dir auch!",
      "direction": "يوسف يرد التهنئة"
    },
    {
      "id": "a2u5d2-l3",
      "speaker": "ayse",
      "text": "Und Silvester? Was machst du?",
      "direction": "عائشة تسأل عن رأس السنة"
    },
    {
      "id": "a2u5d2-l4",
      "speaker": "yusuf",
      "text": "Zu Hause! Es schneit und das Feuer ist romantisch.",
      "direction": "يوسف يصف جو العيد"
    },
    {
      "id": "a2u5d2-l5",
      "speaker": "ayse",
      "text": "Schön! Ich war im Urlaub und habe Ski gefahren.",
      "direction": "عائشة تحكي عن عطلتها"
    },
    {
      "id": "a2u5d2-l6",
      "speaker": "yusuf",
      "text": "Echt? Und Karneval und Ostern?",
      "direction": "يوسف يسأل عن الأعياد"
    },
    {
      "id": "a2u5d2-l7",
      "speaker": "ayse",
      "text": "Da gibt es einen Umzug! Die Kultur hier ist bunt.",
      "direction": "عائشة تصف الاحتفالات"
    },
    {
      "id": "a2u5d2-l8",
      "speaker": "yusuf",
      "text": "Ich nehme die Kamera mit!",
      "direction": "يوسف يتحمس للتصوير"
    }
  ]
}
