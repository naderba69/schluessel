{
  "schemaVersion": "1.0.0",
  "id": "a2-u5-d3-der-witz",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Der Witz ist komisch!",
    "ar": "النكتة مضحكة!"
  },
  "usedIn": [
    "a2-u5-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u5d3-l1",
      "speaker": "thomas",
      "text": "Hör mal: Der Witz ist wirklich komisch!",
      "direction": "توماس يحكي نكتة"
    },
    {
      "id": "a2u5d3-l2",
      "speaker": "yusuf",
      "text": "Du erzählst gut!",
      "direction": "يوسف يضحك"
    },
    {
      "id": "a2u5d3-l3",
      "speaker": "thomas",
      "text": "Ich hätte gern ein Klavier. Und du?",
      "direction": "توماس يشاركه حلمه"
    },
    {
      "id": "a2u5d3-l4",
      "speaker": "yusuf",
      "text": "Ich? Ich chatte gern online.",
      "direction": "يوسف يجيب عن هوايته"
    },
    {
      "id": "a2u5d3-l5",
      "speaker": "thomas",
      "text": "Ich spiele Tennis mit der Mannschaft.",
      "direction": "توماس يتحدث عن الرياضة"
    },
    {
      "id": "a2u5d3-l6",
      "speaker": "yusuf",
      "text": "Spannend! Und der Sänger im Radio?",
      "direction": "يوسف يسأل عن المغني"
    },
    {
      "id": "a2u5d3-l7",
      "speaker": "thomas",
      "text": "Er ist interessant! Aber sein Training ist schwer.",
      "direction": "توماس يعطي رأيه"
    },
    {
      "id": "a2u5d3-l8",
      "speaker": "yusuf",
      "text": "Ein Paar Lieder und alles ist gut!",
      "direction": "يوسف يختم بابتسامة"
    }
  ]
}
