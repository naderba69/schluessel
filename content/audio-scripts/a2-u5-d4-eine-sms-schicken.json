{
  "schemaVersion": "1.0.0",
  "id": "a2-u5-d4-eine-sms-schicken",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Eine SMS schicken",
    "ar": "إرسال رسالة"
  },
  "usedIn": [
    "a2-u5-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u5d4-l1",
      "speaker": "lena",
      "text": "Warte! Ich schicke dir eine SMS.",
      "direction": "لينا ترسل رسالة"
    },
    {
      "id": "a2u5d4-l2",
      "speaker": "yusuf",
      "text": "Gut! Ich schreibe auch meinen Stundenplan.",
      "direction": "يوسف يدوّن جدوله"
    },
    {
      "id": "a2u5d4-l3",
      "speaker": "lena",
      "text": "Und die Note für den Test?",
      "direction": "لينا تسأل عن الدرجة"
    },
    {
      "id": "a2u5d4-l4",
      "speaker": "yusuf",
      "text": "Gut! Aber ich musste gestern helfen.",
      "direction": "يوسف يحكي عن امبارح"
    },
    {
      "id": "a2u5d4-l5",
      "speaker": "lena",
      "text": "Helfen? Ja!",
      "direction": "لينا تسأل"
    },
    {
      "id": "a2u5d4-l6",
      "speaker": "yusuf",
      "text": "Meiner Mutter in der Küche. Geschirr, Töpfe, alles!",
      "direction": "يوسف يصف العمل المنزلي"
    },
    {
      "id": "a2u5d4-l7",
      "speaker": "lena",
      "text": "Und das Gewitter am Nachmittag?",
      "direction": "لينا تتذكر الطقس"
    },
    {
      "id": "a2u5d4-l8",
      "speaker": "yusuf",
      "text": "Da bin ich mit der Mütze in die Baustelle gelaufen!",
      "direction": "يوسف يحكي بمزاح"
    }
  ]
}
