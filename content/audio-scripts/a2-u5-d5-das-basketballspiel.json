{
  "schemaVersion": "1.0.0",
  "id": "a2-u5-d5-das-basketballspiel",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Das Basketballspiel",
    "ar": "مباراة كرة السلة"
  },
  "usedIn": [
    "a2-u5-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u5d5-l1",
      "speaker": "thomas",
      "text": "Das Spiel war gestern hart!",
      "direction": "توماس يتحدث عن المباراة"
    },
    {
      "id": "a2u5d5-l2",
      "speaker": "yusuf",
      "text": "Ja? Auf dem Sportplatz?",
      "direction": "يوسف يسأل"
    },
    {
      "id": "a2u5d5-l3",
      "speaker": "thomas",
      "text": "Ja! Basketball gegen die Mannschaft aus der Stadt.",
      "direction": "توماس يشرح الخصم"
    },
    {
      "id": "a2u5d5-l4",
      "speaker": "yusuf",
      "text": "Und der Titel? Die Punkte?",
      "direction": "يوسف يسأل عن النتيجة"
    },
    {
      "id": "a2u5d5-l5",
      "speaker": "thomas",
      "text": "Wir haben in der letzten Reihe gewonnen!",
      "direction": "توماس يفرح بالفوز"
    },
    {
      "id": "a2u5d5-l6",
      "speaker": "yusuf",
      "text": "Stark! Und die Veranstaltung danach?",
      "direction": "يوسف يسأل عن الاحتفال"
    },
    {
      "id": "a2u5d5-l7",
      "speaker": "thomas",
      "text": "Eine Sendung im Radio! Typisch für uns.",
      "direction": "توماس يضحك"
    },
    {
      "id": "a2u5d5-l8",
      "speaker": "yusuf",
      "text": "Der Rest feiert mit!",
      "direction": "يوسف يشاركه الفرح"
    }
  ]
}
