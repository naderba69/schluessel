{
  "schemaVersion": "1.0.0",
  "id": "a2-u5-d6-ein-paar-freunde",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Die Party und ein paar Freunde",
    "ar": "الحفلة وبعض الأصدقاء"
  },
  "usedIn": [
    "a2-u5-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u5d6-l1",
      "speaker": "yusuf",
      "text": "Die Party war gut! Ich habe ein paar Freunde eingeladen.",
      "direction": "يوسف يحكي عن الحفلة"
    },
    {
      "id": "a2u5d6-l2",
      "speaker": "lena",
      "text": "Wie viele?",
      "direction": "لينا تسأل عن العدد"
    },
    {
      "id": "a2u5d6-l3",
      "speaker": "yusuf",
      "text": "Wenigstens zehn! Und alle haben getanzt.",
      "direction": "يوسف يجيب"
    },
    {
      "id": "a2u5d6-l4",
      "speaker": "lena",
      "text": "Und die Musik?",
      "direction": "لينا تسأل عن الموسيقى"
    },
    {
      "id": "a2u5d6-l5",
      "speaker": "yusuf",
      "text": "Laut und schön! Die Party war gut.",
      "direction": "يوسف يصف الأجواء"
    },
    {
      "id": "a2u5d6-l6",
      "speaker": "lena",
      "text": "Schade, ich war nicht dabei!",
      "direction": "لينا تتأسف"
    },
    {
      "id": "a2u5d6-l7",
      "speaker": "yusuf",
      "text": "Kein Problem! Nächste Party bist du dabei.",
      "direction": "يوسف يطمئنها"
    },
    {
      "id": "a2u5d6-l8",
      "speaker": "lena",
      "text": "Wirklich?",
      "direction": "لينا تؤكد الوعد"
    }
  ]
}
