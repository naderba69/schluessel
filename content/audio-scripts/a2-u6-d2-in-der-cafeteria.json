{
  "schemaVersion": "1.0.0",
  "id": "a2-u6-d2-in-der-cafeteria",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "In der Cafeteria",
    "ar": "في المقصف"
  },
  "usedIn": [
    "a2-u6-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u6d2-l1",
      "speaker": "mueller",
      "text": "Guten Tag! Was möchten Sie?",
      "direction": "مولر يستقبل الزبون"
    },
    {
      "id": "a2u6d2-l2",
      "speaker": "yusuf",
      "text": "Ein Gericht, bitte. Ist der Service gut?",
      "direction": "يوسف يسأل عن الخدمة"
    },
    {
      "id": "a2u6d2-l3",
      "speaker": "mueller",
      "text": "Der beste! Und alles ist preiswert.",
      "direction": "مولر يمدح المطعم"
    },
    {
      "id": "a2u6d2-l4",
      "speaker": "yusuf",
      "text": "Gut! Ich koche selbst, aber heute habe ich keine Lust.",
      "direction": "يوسف يبرر طلبه"
    },
    {
      "id": "a2u6d2-l5",
      "speaker": "mueller",
      "text": "Probieren Sie die Suppe! Die Qualität ist hoch.",
      "direction": "مولر ينصحه"
    },
    {
      "id": "a2u6d2-l6",
      "speaker": "yusuf",
      "text": "Danke! Und ein Mineralwasser auch.",
      "direction": "يوسف يطلب المشروب"
    },
    {
      "id": "a2u6d2-l7",
      "speaker": "mueller",
      "text": "Gern! Der Preis ist auch gut.",
      "direction": "مولر يؤكد"
    },
    {
      "id": "a2u6d2-l8",
      "speaker": "yusuf",
      "text": "Gut! Ich komme wieder.",
      "direction": "يوسف يختم الطلب"
    }
  ]
}
