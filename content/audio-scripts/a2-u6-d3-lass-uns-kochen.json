{
  "schemaVersion": "1.0.0",
  "id": "a2-u6-d3-lass-uns-kochen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Lass uns kochen!",
    "ar": "لنطبخ!"
  },
  "usedIn": [
    "a2-u6-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u6d3-l1",
      "speaker": "lena",
      "text": "Lass uns kochen! Aber richtig.",
      "direction": "لينا تقترح الطبخ"
    },
    {
      "id": "a2u6d3-l2",
      "speaker": "yusuf",
      "text": "Gern! Koch die Bohnen weich.",
      "direction": "يوسف يعطي التعليمات"
    },
    {
      "id": "a2u6d3-l3",
      "speaker": "lena",
      "text": "Wie lange?",
      "direction": "لينا تسأل عن الوقت"
    },
    {
      "id": "a2u6d3-l4",
      "speaker": "yusuf",
      "text": "Mindestens eine Stunde. Meistens länger.",
      "direction": "يوسف يجيب"
    },
    {
      "id": "a2u6d3-l5",
      "speaker": "lena",
      "text": "Und wenn es schmeckt?",
      "direction": "لينا تتوقع النتيجة"
    },
    {
      "id": "a2u6d3-l6",
      "speaker": "yusuf",
      "text": "Dann essen wir! Sonst ist es schrecklich.",
      "direction": "يوسف يمزح"
    },
    {
      "id": "a2u6d3-l7",
      "speaker": "lena",
      "text": "Ich mache das Fenster auf.",
      "direction": "لينا تهتم بالتهوية"
    },
    {
      "id": "a2u6d3-l8",
      "speaker": "yusuf",
      "text": "Gut! Und dann: Guten Appetit!",
      "direction": "يوسف يختم"
    }
  ]
}
