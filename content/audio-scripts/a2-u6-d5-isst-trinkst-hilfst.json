{
  "schemaVersion": "1.0.0",
  "id": "a2-u6-d5-isst-trinkst-hilfst",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Isst, trinkst, hilfst!",
    "ar": "تأكل وتشرب وتساعد!"
  },
  "usedIn": [
    "a2-u6-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u6d5-l1",
      "speaker": "thomas",
      "text": "Du isst gern, oder?",
      "direction": "توماس يمزح"
    },
    {
      "id": "a2u6d5-l2",
      "speaker": "yusuf",
      "text": "Ja! Und ich trinke gern Tee.",
      "direction": "يوسف يوافق"
    },
    {
      "id": "a2u6d5-l3",
      "speaker": "thomas",
      "text": "Und du hilfst deinen Nachbarn?",
      "direction": "توماس يسأل عن الجيران"
    },
    {
      "id": "a2u6d5-l4",
      "speaker": "yusuf",
      "text": "Manchmal! Sie renovieren die Wohnung.",
      "direction": "يوسف يحكي عن الجيران"
    },
    {
      "id": "a2u6d5-l5",
      "speaker": "thomas",
      "text": "Und das Tier im Garten?",
      "direction": "توماس يسأل عن الحيوان"
    },
    {
      "id": "a2u6d5-l6",
      "speaker": "yusuf",
      "text": "Das ist die Katze! Sie liest keine Zeitschrift.",
      "direction": "يوسف يضحك من نكتته"
    },
    {
      "id": "a2u6d5-l7",
      "speaker": "thomas",
      "text": "Du lässt mich immer lachen.",
      "direction": "توماس يضحك"
    },
    {
      "id": "a2u6d5-l8",
      "speaker": "yusuf",
      "text": "Das lasse ich mir nicht nehmen!",
      "direction": "يوسف يختم بمرح"
    }
  ]
}
