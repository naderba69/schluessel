{
  "schemaVersion": "1.0.0",
  "id": "a2-u6-d6-das-essen-erzaehlen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Das Essen erzählen",
    "ar": "حكاية الطعام"
  },
  "usedIn": [
    "a2-u6-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u6d6-l1",
      "speaker": "ayse",
      "text": "Erzähl! Wie war das Essen?",
      "direction": "عائشة تسأل عن الطعام"
    },
    {
      "id": "a2u6d6-l2",
      "speaker": "yusuf",
      "text": "Gut! Ich habe die Bohnen gekocht.",
      "direction": "يوسف يحكي عن الطبخ"
    },
    {
      "id": "a2u6d6-l3",
      "speaker": "ayse",
      "text": "Und die Sache mit dem Salz?",
      "direction": "عائشة تتذكر القصة"
    },
    {
      "id": "a2u6d6-l4",
      "speaker": "yusuf",
      "text": "Ach! Ich habe zu viel Salz genommen.",
      "direction": "يوسف يعترف بخطئه"
    },
    {
      "id": "a2u6d6-l5",
      "speaker": "ayse",
      "text": "Und dann?",
      "direction": "عائشة تتابع القصة"
    },
    {
      "id": "a2u6d6-l6",
      "speaker": "yusuf",
      "text": "Dann habe ich Wasser getrunken! Die Dinge sind einfach.",
      "direction": "يوسف يضحك"
    },
    {
      "id": "a2u6d6-l7",
      "speaker": "ayse",
      "text": "Das Essen ist also eine gute Sache!",
      "direction": "عائشة تعلّق"
    },
    {
      "id": "a2u6d6-l8",
      "speaker": "yusuf",
      "text": "Immer! Besonders mit Freunden.",
      "direction": "يوسف يختم"
    }
  ]
}
