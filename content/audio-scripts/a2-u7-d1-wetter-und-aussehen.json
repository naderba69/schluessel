{
  "schemaVersion": "1.0.0",
  "id": "a2-u7-d1-wetter-und-aussehen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Wetter und Aussehen",
    "ar": "الطقس والشكل"
  },
  "usedIn": [
    "a2-u7-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u7d1-l1",
      "speaker": "lena",
      "text": "Der Abend ist kühl!",
      "direction": "لينا تلاحظ الطقس"
    },
    {
      "id": "a2u7d1-l2",
      "speaker": "yusuf",
      "text": "Ja, und der Himmel ist bewölkt.",
      "direction": "يوسف يصف السماء"
    },
    {
      "id": "a2u7d1-l3",
      "speaker": "lena",
      "text": "Morgen ist ein nebliger Tag.",
      "direction": "لينا تتوقع الطقس"
    },
    {
      "id": "a2u7d1-l4",
      "speaker": "yusuf",
      "text": "Und windig! Da ist eine blonde Frau.",
      "direction": "يوسف يلاحظ المارة"
    },
    {
      "id": "a2u7d1-l5",
      "speaker": "lena",
      "text": "Sie ist schön und reich, oder?",
      "direction": "لينا تمزح"
    },
    {
      "id": "a2u7d1-l6",
      "speaker": "yusuf",
      "text": "Ich weiß nicht! Aber der Tag ist schön.",
      "direction": "يوسف يضحك"
    },
    {
      "id": "a2u7d1-l7",
      "speaker": "lena",
      "text": "Komm! Wir gehen spazieren.",
      "direction": "لينا تقترح النزهة"
    },
    {
      "id": "a2u7d1-l8",
      "speaker": "yusuf",
      "text": "Gern! Aber ich ziehe meine Jacke an.",
      "direction": "يوسف يجهز نفسه"
    }
  ]
}
