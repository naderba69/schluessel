{
  "schemaVersion": "1.0.0",
  "id": "a2-u7-d2-der-zweite-artikel",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Der erste, zweite, dritte!",
    "ar": "الأول والثاني والثالث!"
  },
  "usedIn": [
    "a2-u7-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u7d2-l1",
      "speaker": "yusuf",
      "text": "Der erste Artikel ist die Bluse!",
      "direction": "يوسف يعدّ القطع"
    },
    {
      "id": "a2u7d2-l2",
      "speaker": "lena",
      "text": "Die zweite Bluse ist neu!",
      "direction": "لينا تكمل العد"
    },
    {
      "id": "a2u7d2-l3",
      "speaker": "yusuf",
      "text": "Das dritte Poster ist für dich.",
      "direction": "يوسف يهديها البوستر"
    },
    {
      "id": "a2u7d2-l4",
      "speaker": "lena",
      "text": "Und die vierte Webseite?",
      "direction": "لينا تسأل عن الموقع"
    },
    {
      "id": "a2u7d2-l5",
      "speaker": "yusuf",
      "text": "Da gibt es T-Shirts und Jeans!",
      "direction": "يوسف يصف المحتوى"
    },
    {
      "id": "a2u7d2-l6",
      "speaker": "lena",
      "text": "Zeig mir das fünfte Bild!",
      "direction": "لينا تطلب رؤية الصورة"
    },
    {
      "id": "a2u7d2-l7",
      "speaker": "yusuf",
      "text": "Hier! Das sechste ist das beste.",
      "direction": "يوسف يعرض الصور"
    },
    {
      "id": "a2u7d2-l8",
      "speaker": "lena",
      "text": "Gut! Ich nehme die zweite Bluse.",
      "direction": "لينا تختار قطعتها"
    }
  ]
}
