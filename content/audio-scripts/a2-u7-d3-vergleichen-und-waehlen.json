{
  "schemaVersion": "1.0.0",
  "id": "a2-u7-d3-vergleichen-und-waehlen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Vergleichen und wählen",
    "ar": "المقارنة والاختيار"
  },
  "usedIn": [
    "a2-u7-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u7d3-l1",
      "speaker": "thomas",
      "text": "Wer ist klüger: du oder ich?",
      "direction": "توماس يبدأ المقارنة"
    },
    {
      "id": "a2u7d3-l2",
      "speaker": "yusuf",
      "text": "Du bist intelligenter! Aber ich bin praktischer.",
      "direction": "يوسف يجيب بمرح"
    },
    {
      "id": "a2u7d3-l3",
      "speaker": "thomas",
      "text": "Und wer ist dümmer?",
      "direction": "توماس يمزح"
    },
    {
      "id": "a2u7d3-l4",
      "speaker": "yusuf",
      "text": "Keine! Aber das Meer ist tiefer als der Berg.",
      "direction": "يوسف يغير الموضوع"
    },
    {
      "id": "a2u7d3-l5",
      "speaker": "thomas",
      "text": "Und privat? Was ist besser?",
      "direction": "توماس يسأل عن الحياة الخاصة"
    },
    {
      "id": "a2u7d3-l6",
      "speaker": "yusuf",
      "text": "Privat bin ich sehr glücklich!",
      "direction": "يوسف يجيب بصدق"
    },
    {
      "id": "a2u7d3-l7",
      "speaker": "thomas",
      "text": "Und am klügsten?",
      "direction": "توماس يسأل"
    },
    {
      "id": "a2u7d3-l8",
      "speaker": "yusuf",
      "text": "Das ist meine Schwester!",
      "direction": "يوسف يضحك"
    }
  ]
}
