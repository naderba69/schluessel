{
  "schemaVersion": "1.0.0",
  "id": "a2-u7-d5-tauschen-und-herstellen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Tauschen und herstellen",
    "ar": "التبديل والتصنيع"
  },
  "usedIn": [
    "a2-u7-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u7d5-l1",
      "speaker": "mueller",
      "text": "Wir tauschen die Waren aus.",
      "direction": "مولر يشرح العمل"
    },
    {
      "id": "a2u7d5-l2",
      "speaker": "yusuf",
      "text": "Und einzelne Stücke?",
      "direction": "يوسف يسأل عن القطع"
    },
    {
      "id": "a2u7d5-l3",
      "speaker": "mueller",
      "text": "Einige Kunden wollen das so.",
      "direction": "مولر يوضح السبب"
    },
    {
      "id": "a2u7d5-l4",
      "speaker": "yusuf",
      "text": "Verstehe! Und wir stellen neue Produkte her.",
      "direction": "يوسف يكمل الفكرة"
    },
    {
      "id": "a2u7d5-l5",
      "speaker": "mueller",
      "text": "Genau! Tauschen und herstellen: das ist unsere Arbeit.",
      "direction": "مولر يلخص المهنة"
    },
    {
      "id": "a2u7d5-l6",
      "speaker": "yusuf",
      "text": "Ich lerne jeden Tag etwas Neues.",
      "direction": "يوسف يشعر بالتقدم"
    },
    {
      "id": "a2u7d5-l7",
      "speaker": "mueller",
      "text": "Gut! Und morgen tauschen wir die Regale.",
      "direction": "مولر يعطي الخطة"
    },
    {
      "id": "a2u7d5-l8",
      "speaker": "yusuf",
      "text": "Alles klar, Chef!",
      "direction": "يوسف يؤكد التنفيذ"
    }
  ]
}
