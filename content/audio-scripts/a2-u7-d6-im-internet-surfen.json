{
  "schemaVersion": "1.0.0",
  "id": "a2-u7-d6-im-internet-surfen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Im Internet surfen",
    "ar": "التصفح في الإنترنت"
  },
  "usedIn": [
    "a2-u7-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u7d6-l1",
      "speaker": "lena",
      "text": "Ich surfe im Internet!",
      "direction": "لينا تتصفح المواقع"
    },
    {
      "id": "a2u7d6-l2",
      "speaker": "yusuf",
      "text": "Was suchst du?",
      "direction": "يوسف يسأل"
    },
    {
      "id": "a2u7d6-l3",
      "speaker": "lena",
      "text": "Ein eigenes Zimmer für dich!",
      "direction": "لينا تبحث عن سكن"
    },
    {
      "id": "a2u7d6-l4",
      "speaker": "yusuf",
      "text": "Echt? Zeig mir die Bilder!",
      "direction": "يوسف يتحمس"
    },
    {
      "id": "a2u7d6-l5",
      "speaker": "lena",
      "text": "Hier! Das Zimmer ist klein aber gemütlich.",
      "direction": "لينا تعرض النتائج"
    },
    {
      "id": "a2u7d6-l6",
      "speaker": "yusuf",
      "text": "Und der Preis?",
      "direction": "يوسف يسأل عن السعر"
    },
    {
      "id": "a2u7d6-l7",
      "speaker": "lena",
      "text": "Gut! Aber du musst schnell sein.",
      "direction": "لينا تحذره"
    },
    {
      "id": "a2u7d6-l8",
      "speaker": "yusuf",
      "text": "Ich schreibe sofort eine E-Mail!",
      "direction": "يوسف يتحرك بسرعة"
    }
  ]
}
