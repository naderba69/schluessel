{
  "schemaVersion": "1.0.0",
  "id": "a2-u8-d1-das-blatt-austragen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Das Blatt austragen",
    "ar": "توزيع الجريدة"
  },
  "usedIn": [
    "a2-u8-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u8d1-l1",
      "speaker": "yusuf",
      "text": "Ich habe das Blatt ausgetragen!",
      "direction": "يوسف يخبر عن عمله"
    },
    {
      "id": "a2u8d1-l2",
      "speaker": "lena",
      "text": "Und? War es schwer?",
      "direction": "لينا تسأل"
    },
    {
      "id": "a2u8d1-l3",
      "speaker": "yusuf",
      "text": "Nein! Aber die Situation war interessant.",
      "direction": "يوسف يحكي عن التجربة"
    },
    {
      "id": "a2u8d1-l4",
      "speaker": "lena",
      "text": "Was ist passiert?",
      "direction": "لينا تسأل عن التفاصيل"
    },
    {
      "id": "a2u8d1-l5",
      "speaker": "yusuf",
      "text": "Eine Person hat mir Fragen gestellt.",
      "direction": "يوسف يسرد الموقف"
    },
    {
      "id": "a2u8d1-l6",
      "speaker": "lena",
      "text": "Und hast du sie geteilt?",
      "direction": "لينا تسأل عن إجابته"
    },
    {
      "id": "a2u8d1-l7",
      "speaker": "yusuf",
      "text": "Ja! Und sie hatte Interesse an der Zeitung.",
      "direction": "يوسف يختم القصة"
    },
    {
      "id": "a2u8d1-l8",
      "speaker": "lena",
      "text": "Gute Arbeit!",
      "direction": "لينا تشجعه"
    }
  ]
}
