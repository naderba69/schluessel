{
  "schemaVersion": "1.0.0",
  "id": "a2-u8-d3-uebersetzen-und-helfen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Übersetzen und helfen",
    "ar": "الترجمة والمساعدة"
  },
  "usedIn": [
    "a2-u8-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u8d3-l1",
      "speaker": "ayse",
      "text": "Kannst du diese Datei übersetzen?",
      "direction": "عائشة تطلب خدمة"
    },
    {
      "id": "a2u8d3-l2",
      "speaker": "yusuf",
      "text": "Gern! Aber zuerst muss ich sie herunterladen.",
      "direction": "يوسف يقبل المهمة"
    },
    {
      "id": "a2u8d3-l3",
      "speaker": "ayse",
      "text": "Und dann? Sprichst du die Wörter aus?",
      "direction": "عائشة تسأل عن النطق"
    },
    {
      "id": "a2u8d3-l4",
      "speaker": "yusuf",
      "text": "Ja! Aber die Übersetzung ist nicht leicht.",
      "direction": "يوسف يشرح الصعوبة"
    },
    {
      "id": "a2u8d3-l5",
      "speaker": "ayse",
      "text": "Ich helfe dir!",
      "direction": "عائشة تعرض المساعدة"
    },
    {
      "id": "a2u8d3-l6",
      "speaker": "yusuf",
      "text": "Danke! Gemeinsam schaffen wir es.",
      "direction": "يوسف يشكرها"
    },
    {
      "id": "a2u8d3-l7",
      "speaker": "ayse",
      "text": "Und die Datei für den Kurs?",
      "direction": "عائشة تذكر الملف الآخر"
    },
    {
      "id": "a2u8d3-l8",
      "speaker": "yusuf",
      "text": "Kommt sofort! Ich bin fast fertig.",
      "direction": "يوسف يؤكد الجاهزية"
    }
  ]
}
