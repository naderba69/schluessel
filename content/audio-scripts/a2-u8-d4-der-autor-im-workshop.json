{
  "schemaVersion": "1.0.0",
  "id": "a2-u8-d4-der-autor-im-workshop",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Der Autor im Workshop",
    "ar": "الكاتب في الورشة"
  },
  "usedIn": [
    "a2-u8-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u8d4-l1",
      "speaker": "lena",
      "text": "Der Autor war gestern im Workshop!",
      "direction": "لينا تخبر عن الحدث"
    },
    {
      "id": "a2u8d4-l2",
      "speaker": "yusuf",
      "text": "Und? War es gut?",
      "direction": "يوسف يسأل"
    },
    {
      "id": "a2u8d4-l3",
      "speaker": "lena",
      "text": "Doch! Er hat über die Kunst geschrieben.",
      "direction": "لينا تمدح اللقاء"
    },
    {
      "id": "a2u8d4-l4",
      "speaker": "yusuf",
      "text": "Und der Journalist?",
      "direction": "يوسف يسأل عن الصحفي"
    },
    {
      "id": "a2u8d4-l5",
      "speaker": "lena",
      "text": "Er war auch da. Und ein Mann mit Comics.",
      "direction": "لينا تعدد الحاضرين"
    },
    {
      "id": "a2u8d4-l6",
      "speaker": "yusuf",
      "text": "Spannend! Was hast du gelernt?",
      "direction": "يوسف يسأل عن الفائدة"
    },
    {
      "id": "a2u8d4-l7",
      "speaker": "lena",
      "text": "Dass Schreiben Spaß macht!",
      "direction": "لينا تجيب بحماس"
    },
    {
      "id": "a2u8d4-l8",
      "speaker": "yusuf",
      "text": "Dann schreib auch du!",
      "direction": "يوسف يشجعها"
    }
  ]
}
