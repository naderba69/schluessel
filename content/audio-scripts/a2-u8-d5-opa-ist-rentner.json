{
  "schemaVersion": "1.0.0",
  "id": "a2-u8-d5-opa-ist-rentner",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Opa ist Rentner",
    "ar": "الجد متقاعد"
  },
  "usedIn": [
    "a2-u8-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u8d5-l1",
      "speaker": "yusuf",
      "text": "Mein Opa ist jetzt Rentner.",
      "direction": "يوسف يخبر عن جده"
    },
    {
      "id": "a2u8d5-l2",
      "speaker": "lena",
      "text": "Schön! Und was macht er?",
      "direction": "لينا تسأل"
    },
    {
      "id": "a2u8d5-l3",
      "speaker": "yusuf",
      "text": "Er liest und arbeitet im Garten. Aber sein Vater ist gestorben.",
      "direction": "يوسف يحكي عن العائلة"
    },
    {
      "id": "a2u8d5-l4",
      "speaker": "lena",
      "text": "Ach, das tut mir leid.",
      "direction": "لينا تتعاطف"
    },
    {
      "id": "a2u8d5-l5",
      "speaker": "yusuf",
      "text": "Danke. Aber er hat die Krankenkasse.",
      "direction": "يوسف يطمئنها"
    },
    {
      "id": "a2u8d5-l6",
      "speaker": "lena",
      "text": "Und dein Stipendium?",
      "direction": "لينا تغير الموضوع"
    },
    {
      "id": "a2u8d5-l7",
      "speaker": "yusuf",
      "text": "Kommt bald! Ich hoffe es.",
      "direction": "يوسف يتطلع للمستقبل"
    },
    {
      "id": "a2u8d5-l8",
      "speaker": "lena",
      "text": "Das wird gut!",
      "direction": "لينا تتفاءل"
    }
  ]
}
