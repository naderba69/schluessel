{
  "schemaVersion": "1.0.0",
  "id": "a2-u8-d6-ich-bin-journalist",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Ich bin Journalist",
    "ar": "أنا صحفي"
  },
  "usedIn": [
    "a2-u8-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u8d6-l1",
      "speaker": "thomas",
      "text": "Ich bin Journalist!",
      "direction": "توماس يعلن عمله"
    },
    {
      "id": "a2u8d6-l2",
      "speaker": "yusuf",
      "text": "Echt? Und hier sind deine Nachrichten?",
      "direction": "يوسف يرى الورق"
    },
    {
      "id": "a2u8d6-l3",
      "speaker": "thomas",
      "text": "Ja! Ich schreibe für den Blog.",
      "direction": "توماس يشرح عمله"
    },
    {
      "id": "a2u8d6-l4",
      "speaker": "yusuf",
      "text": "Und das E-Book?",
      "direction": "يوسف يسأل عن الكتاب الإلكتروني"
    },
    {
      "id": "a2u8d6-l5",
      "speaker": "thomas",
      "text": "Das kommt nächste Woche.",
      "direction": "توماس يجيب"
    },
    {
      "id": "a2u8d6-l6",
      "speaker": "yusuf",
      "text": "Stark! Kann ich es lesen?",
      "direction": "يوسف يطلب نسخة"
    },
    {
      "id": "a2u8d6-l7",
      "speaker": "thomas",
      "text": "Natürlich! Für Freunde kostenlos.",
      "direction": "توماس يعطيه وعداً"
    },
    {
      "id": "a2u8d6-l8",
      "speaker": "yusuf",
      "text": "Du bist wirklich Journalist!",
      "direction": "يوسف يمزح"
    }
  ]
}
