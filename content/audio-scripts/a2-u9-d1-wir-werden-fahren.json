{
  "schemaVersion": "1.0.0",
  "id": "a2-u9-d1-wir-werden-fahren",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Wir werden fahren!",
    "ar": "سنسافر!"
  },
  "usedIn": [
    "a2-u9-d1"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u9d1-l1",
      "speaker": "lena",
      "text": "Am Morgen werden wir fahren!",
      "direction": "لينا تعلن عن الرحلة"
    },
    {
      "id": "a2u9d1-l2",
      "speaker": "yusuf",
      "text": "Mit dem ICE oder mit dem Schiff?",
      "direction": "يوسف يسأل عن وسيلة السفر"
    },
    {
      "id": "a2u9d1-l3",
      "speaker": "lena",
      "text": "Mit dem ICE! Und Thomas mit dem Motorroller.",
      "direction": "لينا تحدد الوسائل"
    },
    {
      "id": "a2u9d1-l4",
      "speaker": "yusuf",
      "text": "Auf jeden Fall! Wir schließen die Tür ab.",
      "direction": "يوسف يؤكد الجاهزية"
    },
    {
      "id": "a2u9d1-l5",
      "speaker": "lena",
      "text": "Und die Karten?",
      "direction": "لينا تذكر التذاكر"
    },
    {
      "id": "a2u9d1-l6",
      "speaker": "yusuf",
      "text": "Hier! Ich habe sie schon gekauft.",
      "direction": "يوسف يُظهر التذاكر"
    },
    {
      "id": "a2u9d1-l7",
      "speaker": "lena",
      "text": "Gut! Die Reise wird schön.",
      "direction": "لينا تتفاءل"
    },
    {
      "id": "a2u9d1-l8",
      "speaker": "yusuf",
      "text": "Sicher!",
      "direction": "يوسف يوافق"
    }
  ]
}
