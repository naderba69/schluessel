{
  "schemaVersion": "1.0.0",
  "id": "a2-u9-d2-laender-und-leute",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Länder und Leute",
    "ar": "البلدان والناس"
  },
  "usedIn": [
    "a2-u9-d2"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u9d2-l1",
      "speaker": "ayse",
      "text": "Der Österreicher ist wirklich nett!",
      "direction": "عائشة تمدح النمساوياً"
    },
    {
      "id": "a2u9d2-l2",
      "speaker": "yusuf",
      "text": "Und der Schweizer?",
      "direction": "يوسف يسأل عن السويسري"
    },
    {
      "id": "a2u9d2-l3",
      "speaker": "ayse",
      "text": "Auch! Er kommt aus der Schweiz.",
      "direction": "عائشة تجيب"
    },
    {
      "id": "a2u9d2-l4",
      "speaker": "yusuf",
      "text": "Und ein Franke? Was ist das?",
      "direction": "يوسف يسأل عن الفرانكي"
    },
    {
      "id": "a2u9d2-l5",
      "speaker": "ayse",
      "text": "Ein Mann aus Franken! Er hat hundert Rappen.",
      "direction": "عائشة تشرح"
    },
    {
      "id": "a2u9d2-l6",
      "speaker": "yusuf",
      "text": "Rappen? Das ist Schweizer Geld!",
      "direction": "يوسف يعرف العملة"
    },
    {
      "id": "a2u9d2-l7",
      "speaker": "ayse",
      "text": "Genau! Du kennst dich aus.",
      "direction": "عائشة تمدح معرفته"
    },
    {
      "id": "a2u9d2-l8",
      "speaker": "yusuf",
      "text": "Ich lese gern über Länder.",
      "direction": "يوسف يفسر معرفته"
    }
  ]
}
