{
  "schemaVersion": "1.0.0",
  "id": "a2-u9-d3-klassenfahrt",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Die Klassenfahrt",
    "ar": "رحلة الصف"
  },
  "usedIn": [
    "a2-u9-d3"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u9d3-l1",
      "speaker": "thomas",
      "text": "Die Klassenfahrt nach Luxemburg wird toll!",
      "direction": "توماس متحمس للرحلة"
    },
    {
      "id": "a2u9d3-l2",
      "speaker": "yusuf",
      "text": "Luxemburg! Das wird spannend.",
      "direction": "يوسف يشاركه الحماس"
    },
    {
      "id": "a2u9d3-l3",
      "speaker": "thomas",
      "text": "Aber wir müssen die Karten kaufen.",
      "direction": "توماس يذكر الواجبات"
    },
    {
      "id": "a2u9d3-l4",
      "speaker": "yusuf",
      "text": "Und das Hotel buchen.",
      "direction": "يوسف يضيف مهمة"
    },
    {
      "id": "a2u9d3-l5",
      "speaker": "thomas",
      "text": "Hast du recht? Wir haben nicht viel Geld.",
      "direction": "توماس يقلق من الميزانية"
    },
    {
      "id": "a2u9d3-l6",
      "speaker": "yusuf",
      "text": "Auf keinen Fall teuer! Es gibt günstige Hotels.",
      "direction": "يوسف يطمئنه"
    },
    {
      "id": "a2u9d3-l7",
      "speaker": "thomas",
      "text": "Außer dem Essen?",
      "direction": "توماس يسأل عن الطعام"
    },
    {
      "id": "a2u9d3-l8",
      "speaker": "yusuf",
      "text": "Das nehmen wir mit! Die Fahrt wird super.",
      "direction": "يوسف يختم بتفاؤل"
    }
  ]
}
