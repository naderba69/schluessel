{
  "schemaVersion": "1.0.0",
  "id": "a2-u9-d4-nimm-den-schirm-mit",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Nimm den Schirm mit!",
    "ar": "خذ المظلة معك!"
  },
  "usedIn": [
    "a2-u9-d4"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u9d4-l1",
      "speaker": "lena",
      "text": "Yusuf, nimm bitte den Schirm mit!",
      "direction": "لينا تنصحه بالمظلة"
    },
    {
      "id": "a2u9d4-l2",
      "speaker": "yusuf",
      "text": "Warum? Es regnet nicht.",
      "direction": "يوسف يرى السماء صافية"
    },
    {
      "id": "a2u9d4-l3",
      "speaker": "lena",
      "text": "Doch! Und hier ist niemand, der hilft.",
      "direction": "لينا تحذره"
    },
    {
      "id": "a2u9d4-l4",
      "speaker": "yusuf",
      "text": "Ach so. Und du?",
      "direction": "يوسف يسأل عنها"
    },
    {
      "id": "a2u9d4-l5",
      "speaker": "lena",
      "text": "Ich bleibe zu Hause. Es ist nirgends warm.",
      "direction": "لينا تفضل البقاء"
    },
    {
      "id": "a2u9d4-l6",
      "speaker": "yusuf",
      "text": "Gut! Dann rufe ich dich an.",
      "direction": "يوسف يوعد بالاتصال"
    },
    {
      "id": "a2u9d4-l7",
      "speaker": "lena",
      "text": "Und nimm auch die Jacke mit!",
      "direction": "لينا تزيد التحذير"
    },
    {
      "id": "a2u9d4-l8",
      "speaker": "yusuf",
      "text": "Alles klar, Mutter!",
      "direction": "يوسف يمزح"
    }
  ]
}
