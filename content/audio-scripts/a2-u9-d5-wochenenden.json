{
  "schemaVersion": "1.0.0",
  "id": "a2-u9-d5-wochenenden",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Die Wochenenden",
    "ar": "عطلات نهاية الأسبوع"
  },
  "usedIn": [
    "a2-u9-d5"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u9d5-l1",
      "speaker": "thomas",
      "text": "Samstags ist der Markt voll!",
      "direction": "توماس يصف السوق"
    },
    {
      "id": "a2u9d5-l2",
      "speaker": "yusuf",
      "text": "Und sonntags gehen wir spazieren.",
      "direction": "يوسف يخطط للأحد"
    },
    {
      "id": "a2u9d5-l3",
      "speaker": "thomas",
      "text": "Um wie viel Uhr?",
      "direction": "توماس يسأل عن الوقت"
    },
    {
      "id": "a2u9d5-l4",
      "speaker": "yusuf",
      "text": "Viertel nach zehn. Oder viertel vor elf?",
      "direction": "يوسف يقترح وقتاً"
    },
    {
      "id": "a2u9d5-l5",
      "speaker": "thomas",
      "text": "Lass uns um zehn gehen!",
      "direction": "توماس يحسم الوقت"
    },
    {
      "id": "a2u9d5-l6",
      "speaker": "yusuf",
      "text": "Einverstanden! Und danach Kaffee.",
      "direction": "يوسف يضيف خطة"
    },
    {
      "id": "a2u9d5-l7",
      "speaker": "thomas",
      "text": "Und Montag? Wieder Arbeit?",
      "direction": "توماس يتنهد"
    },
    {
      "id": "a2u9d5-l8",
      "speaker": "yusuf",
      "text": "Montag ist auch schön!",
      "direction": "يوسف يتفاءل"
    }
  ]
}
