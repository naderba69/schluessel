{
  "schemaVersion": "1.0.0",
  "id": "a2-u9-d6-europaeer-reisen",
  "kind": "dialogue",
  "level": "A2",
  "title": {
    "de": "Die Europäer reisen",
    "ar": "ال الأوروبيون يسافرون"
  },
  "usedIn": [
    "a2-u9-d6"
  ],
  "lengthScale": 1.32,
  "lines": [
    {
      "id": "a2u9d6-l1",
      "speaker": "ayse",
      "text": "Die Europäer reisen gern!",
      "direction": "عائشة تبدأ الحديث"
    },
    {
      "id": "a2u9d6-l2",
      "speaker": "yusuf",
      "text": "Ja! Und europäisches Brot ist gut.",
      "direction": "يوسف يحب الخبز"
    },
    {
      "id": "a2u9d6-l3",
      "speaker": "ayse",
      "text": "Wir werden morgen Brot kaufen.",
      "direction": "عائشة تخطط للشراء"
    },
    {
      "id": "a2u9d6-l4",
      "speaker": "yusuf",
      "text": "Und Käse auch!",
      "direction": "يوسف يضيف طلباً"
    },
    {
      "id": "a2u9d6-l5",
      "speaker": "ayse",
      "text": "Gut! Und am Abend kochen wir.",
      "direction": "عائشة تكمل الخطة"
    },
    {
      "id": "a2u9d6-l6",
      "speaker": "yusuf",
      "text": "Was werden wir kochen?",
      "direction": "يوسف يسأل عن الطعام"
    },
    {
      "id": "a2u9d6-l7",
      "speaker": "ayse",
      "text": "Ein europäisches Gericht!",
      "direction": "عائشة تجيب بابتسامة"
    },
    {
      "id": "a2u9d6-l8",
      "speaker": "yusuf",
      "text": "Ich freue mich sehr!",
      "direction": "يوسف متحمس"
    }
  ]
}
