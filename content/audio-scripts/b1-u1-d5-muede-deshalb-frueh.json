{
  "schemaVersion": "1.0.0",
  "id": "b1-u1-d5-muede-deshalb-frueh",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Müde, deshalb früh",
    "ar": "متعب، لذلك مبكراً"
  },
  "usedIn": [
    "b1-u1-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u1d5-l1",
      "speaker": "lena",
      "text": "Du siehst müde aus.",
      "direction": "ملاحظة"
    },
    {
      "id": "b1u1d5-l2",
      "speaker": "yusuf",
      "text": "Ich bin müde, deshalb schlafe ich früh.",
      "direction": "شرح السبب"
    },
    {
      "id": "b1u1d5-l3",
      "speaker": "lena",
      "text": "Aber du arbeitest viel!",
      "direction": "تعجب"
    },
    {
      "id": "b1u1d5-l4",
      "speaker": "yusuf",
      "text": "Zwar arbeite ich viel, aber ich mag meine Arbeit.",
      "direction": "توازن (zwar … aber)"
    },
    {
      "id": "b1u1d5-l5",
      "speaker": "lena",
      "text": "Übrigens: Wir feiern am Freitag.",
      "direction": "تبديل الموضوع (übrigens)"
    },
    {
      "id": "b1u1d5-l6",
      "speaker": "yusuf",
      "text": "Schade, ich muss früh aufstehen.",
      "direction": "اعتذار"
    },
    {
      "id": "b1u1d5-l7",
      "speaker": "lena",
      "text": "Komm nur kurz!",
      "direction": "مرونة"
    },
    {
      "id": "b1u1d5-l8",
      "speaker": "yusuf",
      "text": "Gut. Aber schließlich muss ich schlafen!",
      "direction": "موافقة + مزاح (schließlich)"
    }
  ]
}
