{
  "schemaVersion": "1.0.0",
  "id": "b1-u1-d6-die-woche-ist-zu-ende",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Woche ist zu Ende",
    "ar": "أنتهت الأسبوع"
  },
  "usedIn": [
    "b1-u1-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u1d6-l1",
      "speaker": "yusuf",
      "text": "Die Woche ist zu Ende: dein Abschluss und deine Planung!",
      "direction": "خطاب للأصدقاء"
    },
    {
      "id": "b1u1d6-l2",
      "speaker": "lena",
      "text": "Mein Abschluss ist gut! Und deine Planung?",
      "direction": "فرح + سؤال"
    },
    {
      "id": "b1u1d6-l3",
      "speaker": "yusuf",
      "text": "Ich plane den nächsten Kurs.",
      "direction": "طموح"
    },
    {
      "id": "b1u1d6-l4",
      "speaker": "lena",
      "text": "Welcher Kurs?",
      "direction": "فضول"
    },
    {
      "id": "b1u1d6-l5",
      "speaker": "yusuf",
      "text": "Deutsch B2. Aber zuerst: Urlaub!",
      "direction": "واقعية"
    },
    {
      "id": "b1u1d6-l6",
      "speaker": "lena",
      "text": "Gute Planung! Erst Ruhe, dann Arbeit.",
      "direction": "موافقة"
    },
    {
      "id": "b1u1d6-l7",
      "speaker": "yusuf",
      "text": "Genau. Und deine Woche?",
      "direction": "تبادل"
    },
    {
      "id": "b1u1d6-l8",
      "speaker": "lena",
      "text": "Schön! Ich habe viel gelernt.",
      "direction": "رضا"
    }
  ]
}
