{
  "schemaVersion": "1.0.0",
  "id": "b1-u10-d4-die-auswertung-ist-klar",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Auswertung ist klar",
    "ar": "التحليل واضح"
  },
  "usedIn": [
    "b1-u10-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u10d4-l1",
      "speaker": "mueller",
      "text": "Die Auswertung ist klar — und die Prognose ist deutlich!",
      "direction": "عرض النتائج"
    },
    {
      "id": "b1u10d4-l2",
      "speaker": "yusuf",
      "text": "Was haben Sie erhoben?",
      "direction": "استفسار"
    },
    {
      "id": "b1u10d4-l3",
      "speaker": "mueller",
      "text": "Daten über die Zufriedenheit. Ich habe alles ausgewertet.",
      "direction": "منهجية"
    },
    {
      "id": "b1u10d4-l4",
      "speaker": "yusuf",
      "text": "Und die Prognose für nächstes Jahr?",
      "direction": "استباق"
    },
    {
      "id": "b1u10d4-l5",
      "speaker": "mueller",
      "text": "Mehr Zufriedenheit. Aber wir müssen weiter arbeiten.",
      "direction": "واقعية"
    },
    {
      "id": "b1u10d4-l6",
      "speaker": "yusuf",
      "text": "Was ist der erste Schritt?",
      "direction": "عملي"
    },
    {
      "id": "b1u10d4-l7",
      "speaker": "mueller",
      "text": "Bessere Gespräche im Team.",
      "direction": "توصية"
    },
    {
      "id": "b1u10d4-l8",
      "speaker": "yusuf",
      "text": "Einverstanden. Die Auswertung hilft wirklich!",
      "direction": "إغلاق"
    }
  ]
}
