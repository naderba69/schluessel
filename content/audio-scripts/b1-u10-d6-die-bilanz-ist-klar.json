{
  "schemaVersion": "1.0.0",
  "id": "b1-u10-d6-die-bilanz-ist-klar",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Bilanz ist klar",
    "ar": "الحصيلة واضحة"
  },
  "usedIn": [
    "b1-u10-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u10d6-l1",
      "speaker": "mueller",
      "text": "Die Bilanz ist klar — und das Fazit ist deutlich!",
      "direction": "خلاصة"
    },
    {
      "id": "b1u10d6-l2",
      "speaker": "yusuf",
      "text": "Was ist das Fazit?",
      "direction": "سؤال"
    },
    {
      "id": "b1u10d6-l3",
      "speaker": "mueller",
      "text": "Wir haben gut gearbeitet. Die Genauigkeit war hoch.",
      "direction": "نتيجة"
    },
    {
      "id": "b1u10d6-l4",
      "speaker": "yusuf",
      "text": "Und die Ziele für nächstes Jahr?",
      "direction": "نظر للأمام"
    },
    {
      "id": "b1u10d6-l5",
      "speaker": "mueller",
      "text": "Mehr Qualität, weniger Fehler.",
      "direction": "تحديد"
    },
    {
      "id": "b1u10d6-l6",
      "speaker": "yusuf",
      "text": "Das ist gut.",
      "direction": "تفاؤل"
    },
    {
      "id": "b1u10d6-l7",
      "speaker": "mueller",
      "text": "Mit einer guten Bilanz beginnt man stark!",
      "direction": "تحفيز"
    },
    {
      "id": "b1u10d6-l8",
      "speaker": "yusuf",
      "text": "Danke für die klare Auswertung!",
      "direction": "إغلاق"
    }
  ]
}
