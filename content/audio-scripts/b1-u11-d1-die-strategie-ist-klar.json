{
  "schemaVersion": "1.0.0",
  "id": "b1-u11-d1-die-strategie-ist-klar",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Strategie ist klar",
    "ar": "الاستراتيجية واضحة"
  },
  "usedIn": [
    "b1-u11-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u11d1-l1",
      "speaker": "lena",
      "text": "Er fliegt den Text über — die Strategie ist klar!",
      "direction": "درس القراءة"
    },
    {
      "id": "b1u11d1-l2",
      "speaker": "yusuf",
      "text": "Was heißt das genau?",
      "direction": "استفسار"
    },
    {
      "id": "b1u11d1-l3",
      "speaker": "lena",
      "text": "Man überfliegt den Text gezielt: Titel, erste Sätze, Wörter.",
      "direction": "شرح"
    },
    {
      "id": "b1u11d1-l4",
      "speaker": "yusuf",
      "text": "Also nicht jedes Wort lesen?",
      "direction": "تأكيد الفهم"
    },
    {
      "id": "b1u11d1-l5",
      "speaker": "lena",
      "text": "Nein. Erst überfliegen, dann genau lesen.",
      "direction": "منهجية"
    },
    {
      "id": "b1u11d1-l6",
      "speaker": "yusuf",
      "text": "Und wenn ich ein Wort nicht kenne?",
      "direction": "حالة"
    },
    {
      "id": "b1u11d1-l7",
      "speaker": "lena",
      "text": "Weiter lesen! Das Verstehen kommt von selbst.",
      "direction": "تشجيع"
    },
    {
      "id": "b1u11d1-l8",
      "speaker": "yusuf",
      "text": "Gute Strategie. Ich probiere es!",
      "direction": "إغلاق عملي"
    }
  ]
}
