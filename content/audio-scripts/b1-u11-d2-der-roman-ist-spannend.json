{
  "schemaVersion": "1.0.0",
  "id": "b1-u11-d2-der-roman-ist-spannend",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Roman ist spannend",
    "ar": "الرواية مشوّقة"
  },
  "usedIn": [
    "b1-u11-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u11d2-l1",
      "speaker": "lena",
      "text": "Der Roman ist spannend — und die Geschichte ist berührend!",
      "direction": "مشاركة قراءة"
    },
    {
      "id": "b1u11d2-l2",
      "speaker": "yusuf",
      "text": "Welches Kapitel liest du?",
      "direction": "اهتمام"
    },
    {
      "id": "b1u11d2-l3",
      "speaker": "lena",
      "text": "Das dritte. Und danach ein Märchen.",
      "direction": "إجابة"
    },
    {
      "id": "b1u11d2-l4",
      "speaker": "yusuf",
      "text": "Ein Märchen? Für Erwachsene?",
      "direction": "تعجب"
    },
    {
      "id": "b1u11d2-l5",
      "speaker": "lena",
      "text": "Ja! Gute Märchen sind für alle.",
      "direction": "رأي"
    },
    {
      "id": "b1u11d2-l6",
      "speaker": "yusuf",
      "text": "Vielleicht hast du recht.",
      "direction": "تفكير"
    },
    {
      "id": "b1u11d2-l7",
      "speaker": "lena",
      "text": "Nimm den Roman! Er ist wirklich gut.",
      "direction": "إعارة"
    },
    {
      "id": "b1u11d2-l8",
      "speaker": "yusuf",
      "text": "Danke! Ich lese das erste Kapitel heute.",
      "direction": "امتنان"
    }
  ]
}
