{
  "schemaVersion": "1.0.0",
  "id": "b1-u11-d3-mein-hobby-praesentieren",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Mein Hobby präsentieren",
    "ar": "أقدّم هوايتي"
  },
  "usedIn": [
    "b1-u11-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u11d3-l1",
      "speaker": "yusuf",
      "text": "Guten Tag! Ich präsentiere mein Hobby — Einleitung, Hauptteil, Schluss!",
      "direction": "تمرين عرض"
    },
    {
      "id": "b1u11d3-l2",
      "speaker": "lena",
      "text": "Zeig uns!",
      "direction": "تشجيع"
    },
    {
      "id": "b1u11d3-l3",
      "speaker": "yusuf",
      "text": "Einleitung: Ich koche gern. Hauptteil: Ich koche dreimal pro Woche.",
      "direction": "هيكل"
    },
    {
      "id": "b1u11d3-l4",
      "speaker": "lena",
      "text": "Und der Schluss?",
      "direction": "متابعة"
    },
    {
      "id": "b1u11d3-l5",
      "speaker": "yusuf",
      "text": "Kochen macht glücklich! Fragen?",
      "direction": "خاتمة"
    },
    {
      "id": "b1u11d3-l6",
      "speaker": "lena",
      "text": "Ja! Welches Gericht magst du am besten?",
      "direction": "سؤال جمهور"
    },
    {
      "id": "b1u11d3-l7",
      "speaker": "yusuf",
      "text": "Brot mit Käse. Ich zeige es mit einer Karteikarte!",
      "direction": "إجابة + أداة"
    },
    {
      "id": "b1u11d3-l8",
      "speaker": "lena",
      "text": "Sehr klar! Das war gut gemacht.",
      "direction": "تعزيز"
    }
  ]
}
