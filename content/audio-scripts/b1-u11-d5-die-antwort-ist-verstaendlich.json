{
  "schemaVersion": "1.0.0",
  "id": "b1-u11-d5-die-antwort-ist-verstaendlich",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Antwort ist verständlich",
    "ar": "الإجابة مفهومة"
  },
  "usedIn": [
    "b1-u11-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u11d5-l1",
      "speaker": "mueller",
      "text": "Die Antwort ist verständlich — und die Frage ist präzise!",
      "direction": "درس التواصل"
    },
    {
      "id": "b1u11d5-l2",
      "speaker": "yusuf",
      "text": "Warum ist das genau so wichtig?",
      "direction": "استفسار"
    },
    {
      "id": "b1u11d5-l3",
      "speaker": "mueller",
      "text": "Weil präzise Fragen klare Antworten bringen.",
      "direction": "تفسير"
    },
    {
      "id": "b1u11d5-l4",
      "speaker": "yusuf",
      "text": "Also: erst den Schwerpunkt nennen?",
      "direction": "تطبيق"
    },
    {
      "id": "b1u11d5-l5",
      "speaker": "mueller",
      "text": "Genau. Und den anderen verstehen.",
      "direction": "تعميق"
    },
    {
      "id": "b1u11d5-l6",
      "speaker": "yusuf",
      "text": "Das ist eine gute Sichtweise!",
      "direction": "مزاح خفيف"
    },
    {
      "id": "b1u11d5-l7",
      "speaker": "mueller",
      "text": "Danke! Verständliche Fragen sind die halbe Antwort.",
      "direction": "خلاصة"
    },
    {
      "id": "b1u11d5-l8",
      "speaker": "yusuf",
      "text": "Ich mache das im nächsten Gespräch.",
      "direction": "عزم"
    }
  ]
}
