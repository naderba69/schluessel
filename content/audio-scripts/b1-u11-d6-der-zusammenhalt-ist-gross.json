{
  "schemaVersion": "1.0.0",
  "id": "b1-u11-d6-der-zusammenhalt-ist-gross",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Zusammenhalt ist groß",
    "ar": "التماسك كبير"
  },
  "usedIn": [
    "b1-u11-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u11d6-l1",
      "speaker": "lena",
      "text": "Der Zusammenhalt ist groß — und die Erfüllung ist da!",
      "direction": "احتفال بالفريق"
    },
    {
      "id": "b1u11d6-l2",
      "speaker": "yusuf",
      "text": "Das Team hat das Projekt verwirklicht!",
      "direction": "اعتراف"
    },
    {
      "id": "b1u11d6-l3",
      "speaker": "lena",
      "text": "Ja! Jeder hat seinen Teil gemacht.",
      "direction": "تقدير"
    },
    {
      "id": "b1u11d6-l4",
      "speaker": "yusuf",
      "text": "Und jetzt? Eine Feier?",
      "direction": "اقتراح"
    },
    {
      "id": "b1u11d6-l5",
      "speaker": "lena",
      "text": "Ja! Zusammen feiern.",
      "direction": "حماس"
    },
    {
      "id": "b1u11d6-l6",
      "speaker": "yusuf",
      "text": "Der Zusammenhalt macht uns stark.",
      "direction": "خلاصة"
    },
    {
      "id": "b1u11d6-l7",
      "speaker": "lena",
      "text": "Und die Erfüllung bleibt.",
      "direction": "إغلاق دافئ"
    },
    {
      "id": "b1u11d6-l8",
      "speaker": "yusuf",
      "text": "Auf das Team!",
      "direction": "نخب"
    }
  ]
}
