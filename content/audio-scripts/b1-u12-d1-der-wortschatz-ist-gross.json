{
  "schemaVersion": "1.0.0",
  "id": "b1-u12-d1-der-wortschatz-ist-gross",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Wortschatz ist groß",
    "ar": "المفردات كبيرة"
  },
  "usedIn": [
    "b1-u12-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u12d1-l1",
      "speaker": "yusuf",
      "text": "Der Wortschatz ist groß — und das Zertifikat ist nah!",
      "direction": "تحفيز دراسي"
    },
    {
      "id": "b1u12d1-l2",
      "speaker": "lena",
      "text": "Wie lernst du neue Wörter?",
      "direction": "تبادل خبرات"
    },
    {
      "id": "b1u12d1-l3",
      "speaker": "yusuf",
      "text": "Mit Karten und Konzentration. Jeden Tag dreißig Minuten.",
      "direction": "منهجية"
    },
    {
      "id": "b1u12d1-l4",
      "speaker": "lena",
      "text": "Das ist viel! Aber es lohnt sich.",
      "direction": "تعجب + تشجيع"
    },
    {
      "id": "b1u12d1-l5",
      "speaker": "yusuf",
      "text": "Ja. Der Wortschatz ist der Schlüssel zum Zertifikat.",
      "direction": "قناعة"
    },
    {
      "id": "b1u12d1-l6",
      "speaker": "lena",
      "text": "Und zum freien Sprechen!",
      "direction": "إضافة"
    },
    {
      "id": "b1u12d1-l7",
      "speaker": "yusuf",
      "text": "Genau. Deshalb lerne ich jeden Tag.",
      "direction": "التزام"
    },
    {
      "id": "b1u12d1-l8",
      "speaker": "lena",
      "text": "Gute Arbeit! Du machst das.",
      "direction": "تعزيز"
    }
  ]
}
