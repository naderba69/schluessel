{
  "schemaVersion": "1.0.0",
  "id": "b1-u12-d4-die-rechtschreibung-ist-richtig",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Rechtschreibung ist richtig",
    "ar": "الإملاء صحيح"
  },
  "usedIn": [
    "b1-u12-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u12d4-l1",
      "speaker": "lena",
      "text": "Die Rechtschreibung ist richtig — und der Stil ist klar!",
      "direction": "مراجعة نص"
    },
    {
      "id": "b1u12d4-l2",
      "speaker": "yusuf",
      "text": "Kannst du meinen Text überarbeiten?",
      "direction": "طلب"
    },
    {
      "id": "b1u12d4-l3",
      "speaker": "lena",
      "text": "Gern. Die Rechtschreibung ist gut, aber der Stil braucht Arbeit.",
      "direction": "تقييم"
    },
    {
      "id": "b1u12d4-l4",
      "speaker": "yusuf",
      "text": "Was genau?",
      "direction": "طلب تفصيل"
    },
    {
      "id": "b1u12d4-l5",
      "speaker": "lena",
      "text": "Kurze Sätze schreiben. Und die Wörter klar wählen.",
      "direction": "نصيحة"
    },
    {
      "id": "b1u12d4-l6",
      "speaker": "yusuf",
      "text": "Also überarbeiten, bis es klar ist?",
      "direction": "تأكيد"
    },
    {
      "id": "b1u12d4-l7",
      "speaker": "lena",
      "text": "Genau. Ein guter Text ist klar und richtig.",
      "direction": "مبدأ"
    },
    {
      "id": "b1u12d4-l8",
      "speaker": "yusuf",
      "text": "Danke! Ich überarbeite alles heute.",
      "direction": "إغلاق"
    }
  ]
}
