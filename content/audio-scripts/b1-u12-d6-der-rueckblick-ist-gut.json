{
  "schemaVersion": "1.0.0",
  "id": "b1-u12-d6-der-rueckblick-ist-gut",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Rückblick ist gut",
    "ar": "الاستجابة طيبة"
  },
  "usedIn": [
    "b1-u12-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u12d6-l1",
      "speaker": "yusuf",
      "text": "Der Rückblick ist gut — und der Ausblick ist klar!",
      "direction": "جلسة ختامية"
    },
    {
      "id": "b1u12d6-l2",
      "speaker": "lena",
      "text": "Was war das Beste im Kurs?",
      "direction": "تأمل"
    },
    {
      "id": "b1u12d6-l3",
      "speaker": "yusuf",
      "text": "Die Gespräche. Und die neue Methode zum Lernen.",
      "direction": "إجابة"
    },
    {
      "id": "b1u12d6-l4",
      "speaker": "lena",
      "text": "Und der Ausblick?",
      "direction": "استباق"
    },
    {
      "id": "b1u12d6-l5",
      "speaker": "yusuf",
      "text": "Nächstes Jahr: mehr Reisen, mehr Deutsch.",
      "direction": "أهداف"
    },
    {
      "id": "b1u12d6-l6",
      "speaker": "lena",
      "text": "Gute Ziele! Und die Freunde hier?",
      "direction": "عطف"
    },
    {
      "id": "b1u12d6-l7",
      "speaker": "yusuf",
      "text": "Die bleiben! Ein guter Rückblick.",
      "direction": "دفء"
    },
    {
      "id": "b1u12d6-l8",
      "speaker": "lena",
      "text": "Und ein schöner Ausblick!",
      "direction": "إغلاق شعري"
    }
  ]
}
