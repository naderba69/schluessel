{
  "schemaVersion": "1.0.0",
  "id": "b1-u13-d2-der-zusammenhang-ist-klar",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Zusammenhang ist klar",
    "ar": "الربط واضح"
  },
  "usedIn": [
    "b1-u13-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u13d2-l1",
      "speaker": "lena",
      "text": "Der Zusammenhang ist klar — und der Satz ist logisch!",
      "direction": "درس قواعد"
    },
    {
      "id": "b1u13d2-l2",
      "speaker": "yusuf",
      "text": "Warum ist der Satz falsch?",
      "direction": "سؤال"
    },
    {
      "id": "b1u13d2-l3",
      "speaker": "lena",
      "text": "Die Bedingung fehlt. „Wenn … dann“.",
      "direction": "تشخيص"
    },
    {
      "id": "b1u13d2-l4",
      "speaker": "yusuf",
      "text": "Ich verstehe den Zusammenhang! Wenn ich Zeit habe, dann komme ich.",
      "direction": "تطبيق"
    },
    {
      "id": "b1u13d2-l5",
      "speaker": "lena",
      "text": "Gut! Logisch und klar.",
      "direction": "تعزيز"
    },
    {
      "id": "b1u13d2-l6",
      "speaker": "yusuf",
      "text": "Also: erst den Zusammenhang suchen?",
      "direction": "منهجية"
    },
    {
      "id": "b1u13d2-l7",
      "speaker": "lena",
      "text": "Genau. Dann wird jeder Satz logisch.",
      "direction": "خلاصة"
    },
    {
      "id": "b1u13d2-l8",
      "speaker": "yusuf",
      "text": "Danke! Jetzt sehe ich alles klar.",
      "direction": "إغلاق"
    }
  ]
}
