{
  "schemaVersion": "1.0.0",
  "id": "b1-u13-d4-die-frist-einhalten",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Frist einhalten",
    "ar": "احترام الموعد"
  },
  "usedIn": [
    "b1-u13-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u13d4-l1",
      "speaker": "mueller",
      "text": "Er verfasst den Text — und hält die Frist ein!",
      "direction": "إشادة"
    },
    {
      "id": "b1u13d4-l2",
      "speaker": "yusuf",
      "text": "Die Frist ist morgen, richtig?",
      "direction": "تأكيد"
    },
    {
      "id": "b1u13d4-l3",
      "speaker": "mueller",
      "text": "Ja. Und die Formulierung muss klar sein.",
      "direction": "تذكير"
    },
    {
      "id": "b1u13d4-l4",
      "speaker": "yusuf",
      "text": "Ich verfasse den Text heute Abend.",
      "direction": "التزام"
    },
    {
      "id": "b1u13d4-l5",
      "speaker": "mueller",
      "text": "Gut. Und alles prüfen!",
      "direction": "تفصيل"
    },
    {
      "id": "b1u13d4-l6",
      "speaker": "yusuf",
      "text": "Natürlich. Die Frist halte ich ein.",
      "direction": "ثقة"
    },
    {
      "id": "b1u13d4-l7",
      "speaker": "mueller",
      "text": "Sehr gut. Pünktlich und klar.",
      "direction": "تعزيز"
    },
    {
      "id": "b1u13d4-l8",
      "speaker": "yusuf",
      "text": "Danke! Morgen bekommen Sie den Text.",
      "direction": "إغلاق"
    }
  ]
}
