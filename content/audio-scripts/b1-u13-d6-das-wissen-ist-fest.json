{
  "schemaVersion": "1.0.0",
  "id": "b1-u13-d6-das-wissen-ist-fest",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Das Wissen ist fest",
    "ar": "المعرفة راسخة"
  },
  "usedIn": [
    "b1-u13-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u13d6-l1",
      "speaker": "yusuf",
      "text": "Das Wissen ist fest — und der Übergang ist klar!",
      "direction": "نهاية مرحلة"
    },
    {
      "id": "b1u13d6-l2",
      "speaker": "lena",
      "text": "Wie hast du alles verfestigt?",
      "direction": "فضول"
    },
    {
      "id": "b1u13d6-l3",
      "speaker": "yusuf",
      "text": "Wiederholen, üben, benutzen.",
      "direction": "ثلاثية"
    },
    {
      "id": "b1u13d6-l4",
      "speaker": "lena",
      "text": "Und der Übergang zu B2?",
      "direction": "استباق"
    },
    {
      "id": "b1u13d6-l5",
      "speaker": "yusuf",
      "text": "Der ist klar: mehr lesen, mehr reden.",
      "direction": "خطة"
    },
    {
      "id": "b1u13d6-l6",
      "speaker": "lena",
      "text": "Das Wissen bleibt fest.",
      "direction": "تأكيد"
    },
    {
      "id": "b1u13d6-l7",
      "speaker": "yusuf",
      "text": "Ja! Gelerntes bleibt immer.",
      "direction": "قناعة"
    },
    {
      "id": "b1u13d6-l8",
      "speaker": "lena",
      "text": "Auf das nächste Mal!",
      "direction": "تحفيز"
    }
  ]
}
