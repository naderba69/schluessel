{
  "schemaVersion": "1.0.0",
  "id": "b1-u14-d1-die-urkunde-ist-das-ziel",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Urkunde ist das Ziel",
    "ar": "الشهادة هي الهدف"
  },
  "usedIn": [
    "b1-u14-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u14d1-l1",
      "speaker": "mueller",
      "text": "Die Urkunde ist das Ziel — und die Punktzahl ist hoch!",
      "direction": "يوم النتائج"
    },
    {
      "id": "b1u14d1-l2",
      "speaker": "yusuf",
      "text": "Wie viele Punkte habe ich?",
      "direction": "ترقب"
    },
    {
      "id": "b1u14d1-l3",
      "speaker": "mueller",
      "text": "Sechsundachtzig! Ein sehr gutes Ergebnis.",
      "direction": "إعلان"
    },
    {
      "id": "b1u14d1-l4",
      "speaker": "yusuf",
      "text": "Und wie habe ich abgeschnitten im Sprechen?",
      "direction": "تفصيل"
    },
    {
      "id": "b1u14d1-l5",
      "speaker": "mueller",
      "text": "Am besten. Die Punktzahl ist hoch.",
      "direction": "إشادة"
    },
    {
      "id": "b1u14d1-l6",
      "speaker": "yusuf",
      "text": "Ich kann es nicht glauben!",
      "direction": "فرح"
    },
    {
      "id": "b1u14d1-l7",
      "speaker": "mueller",
      "text": "Die Urkunde bekommen Sie nächste Woche.",
      "direction": "خطوة عملية"
    },
    {
      "id": "b1u14d1-l8",
      "speaker": "yusuf",
      "text": "Danke für alles! Das Ziel ist erreicht.",
      "direction": "امتنان"
    }
  ]
}
