{
  "schemaVersion": "1.0.0",
  "id": "b1-u14-d2-der-zugang-ist-dort",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Zugang ist dort",
    "ar": "المدخل هناك"
  },
  "usedIn": [
    "b1-u14-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u14d2-l1",
      "speaker": "lena",
      "text": "Der Zugang ist dort und der Sitzplatz ist frei!",
      "direction": "يوم الامتحان"
    },
    {
      "id": "b1u14d2-l2",
      "speaker": "yusuf",
      "text": "Danke! Und die Hilfsmittel? Darf ich ein Wörterbuch haben?",
      "direction": "استفسار"
    },
    {
      "id": "b1u14d2-l3",
      "speaker": "lena",
      "text": "Nein, aber Papier ist da. Hier ist dein Sitzplatz.",
      "direction": "إجابة"
    },
    {
      "id": "b1u14d2-l4",
      "speaker": "yusuf",
      "text": "Alles klar. Der Zugang war leicht.",
      "direction": "ارتياح"
    },
    {
      "id": "b1u14d2-l5",
      "speaker": "lena",
      "text": "Und jetzt: Ruhe und Konzentration.",
      "direction": "تذكير"
    },
    {
      "id": "b1u14d2-l6",
      "speaker": "yusuf",
      "text": "Richtig. Der Sitzplatz ist gut.",
      "direction": "تركيز"
    },
    {
      "id": "b1u14d2-l7",
      "speaker": "lena",
      "text": "Viel Erfolg bei der Prüfung!",
      "direction": "تشجيع"
    },
    {
      "id": "b1u14d2-l8",
      "speaker": "yusuf",
      "text": "Danke! Ich beginne jetzt.",
      "direction": "إغلاق"
    }
  ]
}
