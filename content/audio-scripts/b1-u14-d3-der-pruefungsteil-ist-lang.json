{
  "schemaVersion": "1.0.0",
  "id": "b1-u14-d3-der-pruefungsteil-ist-lang",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Prüfungsteil ist lang",
    "ar": "الجزء طويل"
  },
  "usedIn": [
    "b1-u14-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u14d3-l1",
      "speaker": "yusuf",
      "text": "Der Prüfungsteil ist lang und die Einzelheiten sind wichtig!",
      "direction": "بعد الامتحان"
    },
    {
      "id": "b1u14d3-l2",
      "speaker": "lena",
      "text": "Welcher Teil war schwer?",
      "direction": "استفسار"
    },
    {
      "id": "b1u14d3-l3",
      "speaker": "yusuf",
      "text": "Hören. Die Einzelheiten fehlten mir.",
      "direction": "إجابة صادقة"
    },
    {
      "id": "b1u14d3-l4",
      "speaker": "lena",
      "text": "Und der Block mit den Texten?",
      "direction": "استمرار"
    },
    {
      "id": "b1u14d3-l5",
      "speaker": "yusuf",
      "text": "Der war gut. Aber jeder Prüfungsteil zählt.",
      "direction": "توازن"
    },
    {
      "id": "b1u14d3-l6",
      "speaker": "lena",
      "text": "Stimmt. Die Punkte kommen zusammen.",
      "direction": "مواساة"
    },
    {
      "id": "b1u14d3-l7",
      "speaker": "yusuf",
      "text": "Nächstes Mal höre ich genauer.",
      "direction": "درس مستفاد"
    },
    {
      "id": "b1u14d3-l8",
      "speaker": "lena",
      "text": "Das wird schon! Du hast gut gemacht.",
      "direction": "دعم"
    }
  ]
}
