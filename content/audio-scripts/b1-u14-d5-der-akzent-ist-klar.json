{
  "schemaVersion": "1.0.0",
  "id": "b1-u14-d5-der-akzent-ist-klar",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Akzent ist klar",
    "ar": "اللكنة واضحة"
  },
  "usedIn": [
    "b1-u14-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u14d5-l1",
      "speaker": "lena",
      "text": "Der Akzent ist klar und das Selbstvertrauen ist da!",
      "direction": "تغذية راجعة للنطق"
    },
    {
      "id": "b1u14d5-l2",
      "speaker": "yusuf",
      "text": "Wirklich? Ich habe Angst vor dem Akzent.",
      "direction": "شكوى"
    },
    {
      "id": "b1u14d5-l3",
      "speaker": "lena",
      "text": "Der Akzent ist nicht schlimm! Die Intonation war gut.",
      "direction": "تهدئة"
    },
    {
      "id": "b1u14d5-l4",
      "speaker": "yusuf",
      "text": "Und die Aussprache der Wörter?",
      "direction": "تفصيل"
    },
    {
      "id": "b1u14d5-l5",
      "speaker": "lena",
      "text": "Fast richtig. Und dein Selbstvertrauen hilft.",
      "direction": "تشجيع"
    },
    {
      "id": "b1u14d5-l6",
      "speaker": "yusuf",
      "text": "Danke. Das tut gut.",
      "direction": "أثر"
    },
    {
      "id": "b1u14d5-l7",
      "speaker": "lena",
      "text": "Sprach mit Selbstvertrauen! Das ist alles.",
      "direction": "نصيحة"
    },
    {
      "id": "b1u14d5-l8",
      "speaker": "yusuf",
      "text": "Das tue ich. Wirklich!",
      "direction": "عزم"
    }
  ]
}
