{
  "schemaVersion": "1.0.0",
  "id": "b1-u14-d6-der-mut-ist-da",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Mut ist da",
    "ar": "الشجاعة موجودة"
  },
  "usedIn": [
    "b1-u14-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u14d6-l1",
      "speaker": "yusuf",
      "text": "Der Mut ist da und der Puffer ist wichtig!",
      "direction": "خطاب تحفيزي"
    },
    {
      "id": "b1u14d6-l2",
      "speaker": "lena",
      "text": "Was für ein Puffer?",
      "direction": "استفسار"
    },
    {
      "id": "b1u14d6-l3",
      "speaker": "yusuf",
      "text": "Zeit zum Ruhen. Nicht alles auf einmal.",
      "direction": "شرح"
    },
    {
      "id": "b1u14d6-l4",
      "speaker": "lena",
      "text": "Also: Mut und Ruhe zusammen.",
      "direction": "تلخيص"
    },
    {
      "id": "b1u14d6-l5",
      "speaker": "yusuf",
      "text": "Genau. Und dann kommt die gute Prüfung.",
      "direction": "تفاؤل"
    },
    {
      "id": "b1u14d6-l6",
      "speaker": "lena",
      "text": "Der Mut ist schon da.",
      "direction": "تأكيد"
    },
    {
      "id": "b1u14d6-l7",
      "speaker": "yusuf",
      "text": "Und der Puffer auch!",
      "direction": "مزاح"
    },
    {
      "id": "b1u14d6-l8",
      "speaker": "lena",
      "text": "Auf die Prüfung!",
      "direction": "نخب النهاية"
    }
  ]
}
