{
  "schemaVersion": "1.0.0",
  "id": "b1-u2-d4-ihre-anzeige-habe-ich-gelesen",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Ihre Anzeige habe ich gelesen",
    "ar": "قرأت إعلانكم"
  },
  "usedIn": [
    "b1-u2-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u2d4-l1",
      "speaker": "yusuf",
      "text": "Guten Tag! Ihre Anzeige habe ich gelesen: Ihre Wohnung ist tatsächlich gut!",
      "direction": "اتصال مهني"
    },
    {
      "id": "b1u2d4-l2",
      "speaker": "mueller",
      "text": "Danke! Möchten Sie sie besichtigen?",
      "direction": "رد"
    },
    {
      "id": "b1u2d4-l3",
      "speaker": "yusuf",
      "text": "Gern. Welcher Zeitpunkt passt?",
      "direction": "جدولة"
    },
    {
      "id": "b1u2d4-l4",
      "speaker": "mueller",
      "text": "Morgen um fünf. Spätestens dann.",
      "direction": "اقتراح"
    },
    {
      "id": "b1u2d4-l5",
      "speaker": "yusuf",
      "text": "Um fünf bin ich da. Und die Vorstellung der Wohnung?",
      "direction": "تأكيد + استفسار"
    },
    {
      "id": "b1u2d4-l6",
      "speaker": "mueller",
      "text": "Ich zeige alles: Zimmer, Küche, Balkon.",
      "direction": "عرض"
    },
    {
      "id": "b1u2d4-l7",
      "speaker": "yusuf",
      "text": "Wunderbar! Bis morgen.",
      "direction": "إغلاق"
    },
    {
      "id": "b1u2d4-l8",
      "speaker": "mueller",
      "text": "Bis morgen. Tschüss!",
      "direction": "وداع"
    }
  ]
}
