{
  "schemaVersion": "1.0.0",
  "id": "b1-u2-d6-der-beginn-ist-gut",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Beginn ist gut",
    "ar": "البداية جيدة"
  },
  "usedIn": [
    "b1-u2-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u2d6-l1",
      "speaker": "yusuf",
      "text": "Der Beginn ist gut: der Aufenthalt in der Wohnung!",
      "direction": "استئنار"
    },
    {
      "id": "b1u2d6-l2",
      "speaker": "lena",
      "text": "Wie war die erste Nacht?",
      "direction": "اهتمام"
    },
    {
      "id": "b1u2d6-l3",
      "speaker": "yusuf",
      "text": "Ruhig! Der Aufenthalt beginnt gut.",
      "direction": "إجابة"
    },
    {
      "id": "b1u2d6-l4",
      "speaker": "lena",
      "text": "Und die Nachbarn?",
      "direction": "استفسار"
    },
    {
      "id": "b1u2d6-l5",
      "speaker": "yusuf",
      "text": "Freundlich. Eine Frau hat Kuchen gebracht.",
      "direction": "دفء"
    },
    {
      "id": "b1u2d6-l6",
      "speaker": "lena",
      "text": "Wie schön! Der Beginn ist wirklich gut.",
      "direction": "فرح"
    },
    {
      "id": "b1u2d6-l7",
      "speaker": "yusuf",
      "text": "Ja. Ich bin froh über den Umzug.",
      "direction": "امتنان"
    },
    {
      "id": "b1u2d6-l8",
      "speaker": "lena",
      "text": "Das freut mich. Viel Glück!",
      "direction": "دعم"
    }
  ]
}
