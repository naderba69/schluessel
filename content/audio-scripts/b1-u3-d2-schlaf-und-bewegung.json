{
  "schemaVersion": "1.0.0",
  "id": "b1-u3-d2-schlaf-und-bewegung",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Schlaf und Bewegung",
    "ar": "النوم والحركة"
  },
  "usedIn": [
    "b1-u3-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u3d2-l1",
      "speaker": "lena",
      "text": "Ich achte auf die Gesundheit: der Schlaf und die Bewegung!",
      "direction": "نمط حياة"
    },
    {
      "id": "b1u3d2-l2",
      "speaker": "yusuf",
      "text": "Wie viele Stunden schläfst du?",
      "direction": "استفسار"
    },
    {
      "id": "b1u3d2-l3",
      "speaker": "lena",
      "text": "Acht. Und jeden Tag Bewegung.",
      "direction": "إجابة"
    },
    {
      "id": "b1u3d2-l4",
      "speaker": "yusuf",
      "text": "Ich muss auf Süßes verzichten.",
      "direction": "قرار"
    },
    {
      "id": "b1u3d2-l5",
      "speaker": "lena",
      "text": "Gewöhne dich daran! Es dauert zwei Wochen.",
      "direction": "تشجيع"
    },
    {
      "id": "b1u3d2-l6",
      "speaker": "yusuf",
      "text": "Achte du auch auf das Essen?",
      "direction": "تبادل"
    },
    {
      "id": "b1u3d2-l7",
      "speaker": "lena",
      "text": "Ja. Viel Gemüse, wenig Zucker.",
      "direction": "نصيحة"
    },
    {
      "id": "b1u3d2-l8",
      "speaker": "yusuf",
      "text": "Gut. Gesundheit ist wichtig.",
      "direction": "إغلاق"
    }
  ]
}
