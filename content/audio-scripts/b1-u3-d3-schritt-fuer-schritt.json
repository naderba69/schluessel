{
  "schemaVersion": "1.0.0",
  "id": "b1-u3-d3-schritt-fuer-schritt",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Schritt für Schritt",
    "ar": "خطوة بخطوة"
  },
  "usedIn": [
    "b1-u3-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u3d3-l1",
      "speaker": "mueller",
      "text": "Zuerst misst der Arzt: der Schritt für Schritt!",
      "direction": "في الفحص"
    },
    {
      "id": "b1u3d3-l2",
      "speaker": "yusuf",
      "text": "Was messen Sie genau?",
      "direction": "استفسار"
    },
    {
      "id": "b1u3d3-l3",
      "speaker": "mueller",
      "text": "Ihr Gewicht. Und dann testen wir das Blut.",
      "direction": "خطوات"
    },
    {
      "id": "b1u3d3-l4",
      "speaker": "yusuf",
      "text": "Und das Ergebnis?",
      "direction": "ترقب"
    },
    {
      "id": "b1u3d3-l5",
      "speaker": "mueller",
      "text": "Alles gut! Schritt für Schritt gesund.",
      "direction": "طمأنة"
    },
    {
      "id": "b1u3d3-l6",
      "speaker": "yusuf",
      "text": "Danke. Der Test war nicht schlimm.",
      "direction": "ارتياح"
    },
    {
      "id": "b1u3d3-l7",
      "speaker": "mueller",
      "text": "Kommen Sie nächstes Jahr wieder.",
      "direction": "توصية"
    },
    {
      "id": "b1u3d3-l8",
      "speaker": "yusuf",
      "text": "Mache ich. Auf Wiedersehen!",
      "direction": "إغلاق"
    }
  ]
}
