{
  "schemaVersion": "1.0.0",
  "id": "b1-u3-d4-das-formular-ausfuellen",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Das Formular ausfüllen",
    "ar": "تعبئة الاستمارة"
  },
  "usedIn": [
    "b1-u3-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u3d4-l1",
      "speaker": "lena",
      "text": "Die Angabe ist erforderlich: das Feld und die Zeile!",
      "direction": "في الاستقبال"
    },
    {
      "id": "b1u3d4-l2",
      "speaker": "yusuf",
      "text": "Welche Angabe?",
      "direction": "استفسار"
    },
    {
      "id": "b1u3d4-l3",
      "speaker": "lena",
      "text": "Ihr Name hier, in dem Feld.",
      "direction": "توجيه"
    },
    {
      "id": "b1u3d4-l4",
      "speaker": "yusuf",
      "text": "Und die Zeile für die Adresse?",
      "direction": "تفصيل"
    },
    {
      "id": "b1u3d4-l5",
      "speaker": "lena",
      "text": "Hier. Bitte klar schreiben.",
      "direction": "توجيه"
    },
    {
      "id": "b1u3d4-l6",
      "speaker": "yusuf",
      "text": "Fertig! Alle Angaben sind da.",
      "direction": "إنهاء"
    },
    {
      "id": "b1u3d4-l7",
      "speaker": "lena",
      "text": "Gut. Warten Sie bitte hier.",
      "direction": "إجراء"
    },
    {
      "id": "b1u3d4-l8",
      "speaker": "yusuf",
      "text": "Danke für die Hilfe.",
      "direction": "امتنان"
    }
  ]
}
