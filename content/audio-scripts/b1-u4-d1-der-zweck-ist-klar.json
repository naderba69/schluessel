{
  "schemaVersion": "1.0.0",
  "id": "b1-u4-d1-der-zweck-ist-klar",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Zweck ist klar",
    "ar": "الهدف واضح"
  },
  "usedIn": [
    "b1-u4-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u4d1-l1",
      "speaker": "yusuf",
      "text": "Ich lerne, um erfolgreich zu sein: der Zweck ist klar!",
      "direction": "تحفيز دراسي"
    },
    {
      "id": "b1u4d1-l2",
      "speaker": "lena",
      "text": "Was ist dein Zweck genau?",
      "direction": "استفسار"
    },
    {
      "id": "b1u4d1-l3",
      "speaker": "yusuf",
      "text": "Studieren. Jeder Versuch bringt mich näher.",
      "direction": "إجابة"
    },
    {
      "id": "b1u4d1-l4",
      "speaker": "lena",
      "text": "Und wenn ein Versuch nicht gut geht?",
      "direction": "سؤال أخطاء"
    },
    {
      "id": "b1u4d1-l5",
      "speaker": "yusuf",
      "text": "Dann versuche ich es wieder.",
      "direction": "مثابرة"
    },
    {
      "id": "b1u4d1-l6",
      "speaker": "lena",
      "text": "Gute Sache! Das braucht Zeit.",
      "direction": "تشجيع"
    },
    {
      "id": "b1u4d1-l7",
      "speaker": "yusuf",
      "text": "Der Zweck bleibt klar.",
      "direction": "تأكيد"
    },
    {
      "id": "b1u4d1-l8",
      "speaker": "lena",
      "text": "Und du bleibst erfolgreich!",
      "direction": "دعم"
    }
  ]
}
