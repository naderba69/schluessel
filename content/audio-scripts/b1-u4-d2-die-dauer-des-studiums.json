{
  "schemaVersion": "1.0.0",
  "id": "b1-u4-d2-die-dauer-des-studiums",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Dauer des Studiums",
    "ar": "مدة الدراسة"
  },
  "usedIn": [
    "b1-u4-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u4d2-l1",
      "speaker": "lena",
      "text": "Die Dauer des Studiums ist lang.",
      "direction": "واقعية"
    },
    {
      "id": "b1u4d2-l2",
      "speaker": "yusuf",
      "text": "Wie lang? In Jahren?",
      "direction": "استفسار"
    },
    {
      "id": "b1u4d2-l3",
      "speaker": "lena",
      "text": "Fünf Jahre. Und die Höhe der Kosten ist auch wichtig.",
      "direction": "إجابة + تحذير"
    },
    {
      "id": "b1u4d2-l4",
      "speaker": "yusuf",
      "text": "Die Breite des Themas ist groß auch!",
      "direction": "مزاح"
    },
    {
      "id": "b1u4d2-l5",
      "speaker": "lena",
      "text": "Stimmt! Aber du schaffst es.",
      "direction": "دعم"
    },
    {
      "id": "b1u4d2-l6",
      "speaker": "yusuf",
      "text": "Die Länge des Weges macht mir nichts.",
      "direction": "ثقة"
    },
    {
      "id": "b1u4d2-l7",
      "speaker": "lena",
      "text": "Sehr gut. Dann beginnen wir!",
      "direction": "تشجيع"
    },
    {
      "id": "b1u4d2-l8",
      "speaker": "yusuf",
      "text": "Ja! Der Weg ist das Ziel.",
      "direction": "خلاصة"
    }
  ]
}
