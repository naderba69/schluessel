{
  "schemaVersion": "1.0.0",
  "id": "b1-u4-d3-der-vergleich-ist-wichtig",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Vergleich ist wichtig",
    "ar": "المقارنة مهمة"
  },
  "usedIn": [
    "b1-u4-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u4d3-l1",
      "speaker": "yusuf",
      "text": "Der Vergleich ist wichtig: besser als oder wie?",
      "direction": "درس المقارنة"
    },
    {
      "id": "b1u4d3-l2",
      "speaker": "lena",
      "text": "Also: das ist besser als das andere.",
      "direction": "تطبيق"
    },
    {
      "id": "b1u4d3-l3",
      "speaker": "yusuf",
      "text": "Genau. Und die Unterschiede sind deutlich.",
      "direction": "تأكيد"
    },
    {
      "id": "b1u4d3-l4",
      "speaker": "lena",
      "text": "Die zwei Städte sind unterschiedlich.",
      "direction": "مثال"
    },
    {
      "id": "b1u4d3-l5",
      "speaker": "yusuf",
      "text": "Berlin ist größer als Köln.",
      "direction": "تطبيق ثانٍ"
    },
    {
      "id": "b1u4d3-l6",
      "speaker": "lena",
      "text": "Und Köln ist schöner als Berlin!",
      "direction": "رأي شخصي"
    },
    {
      "id": "b1u4d3-l7",
      "speaker": "yusuf",
      "text": "Das ist deine Meinung!",
      "direction": "مزاح"
    },
    {
      "id": "b1u4d3-l8",
      "speaker": "lena",
      "text": "Stimmt. Aber der Vergleich hilft.",
      "direction": "إغلاق"
    }
  ]
}
