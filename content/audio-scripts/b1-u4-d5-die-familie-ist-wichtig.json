{
  "schemaVersion": "1.0.0",
  "id": "b1-u4-d5-die-familie-ist-wichtig",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Familie ist wichtig",
    "ar": "العائلة مهمة"
  },
  "usedIn": [
    "b1-u4-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u4d5-l1",
      "speaker": "lena",
      "text": "Ich sorge mich um die Familie: der Sinn ist klar!",
      "direction": "هموم عائلية"
    },
    {
      "id": "b1u4d5-l2",
      "speaker": "yusuf",
      "text": "Was ist passiert?",
      "direction": "قلق"
    },
    {
      "id": "b1u4d5-l3",
      "speaker": "lena",
      "text": "Meine Mutter ist krank. Ich konzentriere mich auf sie.",
      "direction": "شرح"
    },
    {
      "id": "b1u4d5-l4",
      "speaker": "yusuf",
      "text": "Das tut mir leid. Kann ich helfen?",
      "direction": "تعاطف"
    },
    {
      "id": "b1u4d5-l5",
      "speaker": "lena",
      "text": "Danke. Es stimmt schon wieder.",
      "direction": "اطمئنان"
    },
    {
      "id": "b1u4d5-l6",
      "speaker": "yusuf",
      "text": "Die Familie ist das Beste.",
      "direction": "مبدأ"
    },
    {
      "id": "b1u4d5-l7",
      "speaker": "lena",
      "text": "Stimmt. Der Sinn des Lebens.",
      "direction": "تأمل"
    },
    {
      "id": "b1u4d5-l8",
      "speaker": "yusuf",
      "text": "Ruf an, wenn du Hilfe brauchst.",
      "direction": "دعم"
    }
  ]
}
