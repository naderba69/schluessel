{
  "schemaVersion": "1.0.0",
  "id": "b1-u4-d6-studium-oder-ausbildung",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Studium oder Ausbildung",
    "ar": "دراسة أم تدريب"
  },
  "usedIn": [
    "b1-u4-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u4d6-l1",
      "speaker": "yusuf",
      "text": "Studium oder Ausbildung: die Herausforderung ist groß!",
      "direction": "حيرة مصيرية"
    },
    {
      "id": "b1u4d6-l2",
      "speaker": "lena",
      "text": "Was ist dein Ziel?",
      "direction": "استفسار"
    },
    {
      "id": "b1u4d6-l3",
      "speaker": "yusuf",
      "text": "Ein guter Betrieb. Aber auch ein Studium.",
      "direction": "تردد"
    },
    {
      "id": "b1u4d6-l4",
      "speaker": "lena",
      "text": "Die Ausbildung ist praktischer.",
      "direction": "رأي"
    },
    {
      "id": "b1u4d6-l5",
      "speaker": "yusuf",
      "text": "Und das Studium ist breiter.",
      "direction": "توازن"
    },
    {
      "id": "b1u4d6-l6",
      "speaker": "lena",
      "text": "Beides hat Sinn.",
      "direction": "حكمة"
    },
    {
      "id": "b1u4d6-l7",
      "speaker": "yusuf",
      "text": "Dann: erst Ausbildung, dann Studium!",
      "direction": "قرار"
    },
    {
      "id": "b1u4d6-l8",
      "speaker": "lena",
      "text": "Gut! Jetzt wissen wir alles.",
      "direction": "إغلاق"
    }
  ]
}
