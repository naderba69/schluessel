{
  "schemaVersion": "1.0.0",
  "id": "b1-u5-d1-die-quelle-ist-wichtig",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Quelle ist wichtig",
    "ar": "المصدر مهم"
  },
  "usedIn": [
    "b1-u5-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u5d1-l1",
      "speaker": "yusuf",
      "text": "Ich möchte wissen, woher die Nachricht kommt: die Quelle ist wichtig!",
      "direction": "درس نقد إعلامي"
    },
    {
      "id": "b1u5d1-l2",
      "speaker": "lena",
      "text": "Stimmt die Meldung wirklich?",
      "direction": "شك"
    },
    {
      "id": "b1u5d1-l3",
      "speaker": "yusuf",
      "text": "Der Bericht hat keine Überschrift und keine Quelle.",
      "direction": "تشخيص"
    },
    {
      "id": "b1u5d1-l4",
      "speaker": "lena",
      "text": "Das ist falsch, glaube ich.",
      "direction": "استنتاج"
    },
    {
      "id": "b1u5d1-l5",
      "speaker": "yusuf",
      "text": "Also: erst die Quelle prüfen.",
      "direction": "قاعدة"
    },
    {
      "id": "b1u5d1-l6",
      "speaker": "lena",
      "text": "Und viele Berichte vergleichen.",
      "direction": "إضافة"
    },
    {
      "id": "b1u5d1-l7",
      "speaker": "yusuf",
      "text": "Genau. Nicht jede Meldung ist wahr.",
      "direction": "خلاصة"
    },
    {
      "id": "b1u5d1-l8",
      "speaker": "lena",
      "text": "Sehr gut gedacht!",
      "direction": "تعزيز"
    }
  ]
}
