{
  "schemaVersion": "1.0.0",
  "id": "b1-u5-d2-die-kritik-ist-wichtig",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Kritik ist wichtig",
    "ar": "النقد مهم"
  },
  "usedIn": [
    "b1-u5-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u5d2-l1",
      "speaker": "lena",
      "text": "Das ist doch klar: die Kritik ist wichtig!",
      "direction": "نقاش أدبي"
    },
    {
      "id": "b1u5d2-l2",
      "speaker": "yusuf",
      "text": "Warum?",
      "direction": "استفسار"
    },
    {
      "id": "b1u5d2-l3",
      "speaker": "lena",
      "text": "Gute Kritik hilft. Der Ausdruck wird besser.",
      "direction": "تفسير"
    },
    {
      "id": "b1u5d2-l4",
      "speaker": "yusuf",
      "text": "Aber die Erzählung war gut!",
      "direction": "رأي معاكس"
    },
    {
      "id": "b1u5d2-l5",
      "speaker": "lena",
      "text": "Ja, aber der Hörer braucht klare Wörter.",
      "direction": "تفصيل"
    },
    {
      "id": "b1u5d2-l6",
      "speaker": "yusuf",
      "text": "Also: Kritik hören, nicht ärgern.",
      "direction": "درس"
    },
    {
      "id": "b1u5d2-l7",
      "speaker": "lena",
      "text": "Genau! Das macht den Text stark.",
      "direction": "تعزيز"
    },
    {
      "id": "b1u5d2-l8",
      "speaker": "yusuf",
      "text": "Danke für die gute Kritik.",
      "direction": "إغلاق"
    }
  ]
}
