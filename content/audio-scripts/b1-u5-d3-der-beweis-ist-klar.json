{
  "schemaVersion": "1.0.0",
  "id": "b1-u5-d3-der-beweis-ist-klar",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Der Beweis ist klar",
    "ar": "الدليل واضح"
  },
  "usedIn": [
    "b1-u5-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u5d3-l1",
      "speaker": "yusuf",
      "text": "Die Kritik ist wichtig, denn der Beweis ist klar!",
      "direction": "درس الحجاج"
    },
    {
      "id": "b1u5d3-l2",
      "speaker": "lena",
      "text": "Welcher Beweis?",
      "direction": "استفسار"
    },
    {
      "id": "b1u5d3-l3",
      "speaker": "yusuf",
      "text": "Die Zahlen. Sie sind eindeutig.",
      "direction": "إجابة"
    },
    {
      "id": "b1u5d3-l4",
      "speaker": "lena",
      "text": "Und ist die Kritik fair?",
      "direction": "مبدأ"
    },
    {
      "id": "b1u5d3-l5",
      "speaker": "yusuf",
      "text": "Ja. Fair und mit Beweisen.",
      "direction": "تأكيد"
    },
    {
      "id": "b1u5d3-l6",
      "speaker": "lena",
      "text": "Gut. Ohne Beweis ist die Kritik nur eine Meinung.",
      "direction": "خلاصة"
    },
    {
      "id": "b1u5d3-l7",
      "speaker": "yusuf",
      "text": "Stimmt. Der Beweis macht alles klar.",
      "direction": "مبدأ"
    },
    {
      "id": "b1u5d3-l8",
      "speaker": "lena",
      "text": "Sehr gut gesagt!",
      "direction": "تعزيز"
    }
  ]
}
