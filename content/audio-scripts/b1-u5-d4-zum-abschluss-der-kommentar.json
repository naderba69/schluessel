{
  "schemaVersion": "1.0.0",
  "id": "b1-u5-d4-zum-abschluss-der-kommentar",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Zum Abschluss der Kommentar",
    "ar": "الخاتمة: التعليق"
  },
  "usedIn": [
    "b1-u5-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u5d4-l1",
      "speaker": "lena",
      "text": "Zum Abschluss schreibe ich den Kommentar!",
      "direction": "درس كتابة"
    },
    {
      "id": "b1u5d4-l2",
      "speaker": "yusuf",
      "text": "Weshalb ist der Kommentar wichtig?",
      "direction": "استفسار"
    },
    {
      "id": "b1u5d4-l3",
      "speaker": "lena",
      "text": "Er zeigt die Meinung. Jedoch kurz und klar.",
      "direction": "تفسير"
    },
    {
      "id": "b1u5d4-l4",
      "speaker": "yusuf",
      "text": "Und trotz der Kürze muss er fair sein?",
      "direction": "تفصيل"
    },
    {
      "id": "b1u5d4-l5",
      "speaker": "lena",
      "text": "Genau! Weshalb? Weil die Leute lesen.",
      "direction": "إعادة تأكيد"
    },
    {
      "id": "b1u5d4-l6",
      "speaker": "yusuf",
      "text": "Also: Meinung und Begründung.",
      "direction": "تلخيص"
    },
    {
      "id": "b1u5d4-l7",
      "speaker": "lena",
      "text": "Gut. Das ist ein guter Kommentar.",
      "direction": "تعزيز"
    },
    {
      "id": "b1u5d4-l8",
      "speaker": "yusuf",
      "text": "Danke! Jetzt schreibe ich meinen.",
      "direction": "إغلاق"
    }
  ]
}
