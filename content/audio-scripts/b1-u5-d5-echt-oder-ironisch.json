{
  "schemaVersion": "1.0.0",
  "id": "b1-u5-d5-echt-oder-ironisch",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Echt oder ironisch?",
    "ar": "جدّ أم سخرية؟"
  },
  "usedIn": [
    "b1-u5-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u5d5-l1",
      "speaker": "yusuf",
      "text": "Toll! — echt oder ironisch?",
      "direction": "درس الفهم الضمني"
    },
    {
      "id": "b1u5d5-l2",
      "speaker": "lena",
      "text": "Wie meinst du das?",
      "direction": "ارتباك"
    },
    {
      "id": "b1u5d5-l3",
      "speaker": "yusuf",
      "text": "Sagst du „Toll!“ ernst oder ironisch?",
      "direction": "توضيح"
    },
    {
      "id": "b1u5d5-l4",
      "speaker": "lena",
      "text": "Ich verstehe! Meistens ehrlich und ernst.",
      "direction": "إجابة"
    },
    {
      "id": "b1u5d5-l5",
      "speaker": "yusuf",
      "text": "Aber manchmal ironisch?",
      "direction": "استمرار"
    },
    {
      "id": "b1u5d5-l6",
      "speaker": "lena",
      "text": "Ja. Die Stimme zeigt es.",
      "direction": "شرح"
    },
    {
      "id": "b1u5d5-l7",
      "speaker": "yusuf",
      "text": "Also: auf die Stimme achten.",
      "direction": "درس"
    },
    {
      "id": "b1u5d5-l8",
      "speaker": "lena",
      "text": "Genau. Ehrlich sein ist am besten!",
      "direction": "إغلاق"
    }
  ]
}
