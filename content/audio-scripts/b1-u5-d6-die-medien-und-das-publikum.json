{
  "schemaVersion": "1.0.0",
  "id": "b1-u5-d6-die-medien-und-das-publikum",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Medien und das Publikum",
    "ar": "الإعلام والجمهور"
  },
  "usedIn": [
    "b1-u5-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u5d6-l1",
      "speaker": "mueller",
      "text": "Ganz im Ernst: Die Medien und das Publikum!",
      "direction": "درس جدّي"
    },
    {
      "id": "b1u5d6-l2",
      "speaker": "yusuf",
      "text": "Was meinen Sie genau?",
      "direction": "استفسار"
    },
    {
      "id": "b1u5d6-l3",
      "speaker": "mueller",
      "text": "Die Medien zeigen die Welt. Das Publikum wählt.",
      "direction": "تفسير"
    },
    {
      "id": "b1u5d6-l4",
      "speaker": "yusuf",
      "text": "Und wenn die Nachricht falsch ist?",
      "direction": "حالة"
    },
    {
      "id": "b1u5d6-l5",
      "speaker": "mueller",
      "text": "Dann muss das Publikum fragen.",
      "direction": "مسؤولية"
    },
    {
      "id": "b1u5d6-l6",
      "speaker": "yusuf",
      "text": "Also: nicht alles glauben.",
      "direction": "خلاصة"
    },
    {
      "id": "b1u5d6-l7",
      "speaker": "mueller",
      "text": "Genau. Ganz im Ernst: denken Sie selbst!",
      "direction": "مبدأ"
    },
    {
      "id": "b1u5d6-l8",
      "speaker": "yusuf",
      "text": "Danke. Das nehme ich mit.",
      "direction": "إغلاق"
    }
  ]
}
