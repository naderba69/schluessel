{
  "schemaVersion": "1.0.0",
  "id": "b1-u6-d1-abschied-ins-tal",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Abschied ins Tal",
    "ar": "وداع نحو الوادي"
  },
  "usedIn": [
    "b1-u6-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u6d1-l1",
      "speaker": "lena",
      "text": "Ich hätte gern einen Ausflug ins Tal!",
      "direction": "خطة رحلة"
    },
    {
      "id": "b1u6d1-l2",
      "speaker": "yusuf",
      "text": "Gute Idee! Wann ist der Abschied von der Stadt?",
      "direction": "مزاح"
    },
    {
      "id": "b1u6d1-l3",
      "speaker": "lena",
      "text": "Morgen früh. Wir verabschieden uns und fahren los.",
      "direction": "خطة"
    },
    {
      "id": "b1u6d1-l4",
      "speaker": "yusuf",
      "text": "Das wird ein schönes Erlebnis!",
      "direction": "تفاؤل"
    },
    {
      "id": "b1u6d1-l5",
      "speaker": "lena",
      "text": "Ja! Das Tal ist grün und ruhig.",
      "direction": "وصف"
    },
    {
      "id": "b1u6d1-l6",
      "speaker": "yusuf",
      "text": "Der Ausflug gefällt mir auch!",
      "direction": "غيران لطيف"
    },
    {
      "id": "b1u6d1-l7",
      "speaker": "lena",
      "text": "Komm mit!",
      "direction": "دعوة"
    },
    {
      "id": "b1u6d1-l8",
      "speaker": "yusuf",
      "text": "Wirklich? Danke! Ich bin dabei.",
      "direction": "فرح"
    }
  ]
}
