{
  "schemaVersion": "1.0.0",
  "id": "b1-u6-d6-die-rueckkehr",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Rückkehr",
    "ar": "العودة"
  },
  "usedIn": [
    "b1-u6-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u6d6-l1",
      "speaker": "lena",
      "text": "Die Rückkehr war unvergesslich!",
      "direction": "إفادة عن رحلة"
    },
    {
      "id": "b1u6d6-l2",
      "speaker": "yusuf",
      "text": "Erzähl!",
      "direction": "فضول"
    },
    {
      "id": "b1u6d6-l3",
      "speaker": "lena",
      "text": "Die Berge, der Fluss, der Himmel. Alles unvergesslich.",
      "direction": "وصف"
    },
    {
      "id": "b1u6d6-l4",
      "speaker": "yusuf",
      "text": "Und die Rückkehr nach Hause?",
      "direction": "استفسار"
    },
    {
      "id": "b1u6d6-l5",
      "speaker": "lena",
      "text": "Schön. Aber ich möchte bleiben!",
      "direction": "عاطفة"
    },
    {
      "id": "b1u6d6-l6",
      "speaker": "yusuf",
      "text": "Das zeigt: eine gute Reise!",
      "direction": "حكمة"
    },
    {
      "id": "b1u6d6-l7",
      "speaker": "lena",
      "text": "Stimmt! Nächstes Mal fährst du mit.",
      "direction": "دعوة"
    },
    {
      "id": "b1u6d6-l8",
      "speaker": "yusuf",
      "text": "Wirklich!",
      "direction": "تأكيد"
    }
  ]
}
