{
  "schemaVersion": "1.0.0",
  "id": "b1-u7-d1-nachdem-wir-getrennt-hatten",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Nachdem wir getrennt hatten",
    "ar": "بعدما فرزنا"
  },
  "usedIn": [
    "b1-u7-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u7d1-l1",
      "speaker": "yusuf",
      "text": "Nachdem wir den Abfall getrennt hatten, wanderten wir los!",
      "direction": "قصة بيئية"
    },
    {
      "id": "b1u7d1-l2",
      "speaker": "lena",
      "text": "Gute Idee! Trennen und wandern.",
      "direction": "موافقة"
    },
    {
      "id": "b1u7d1-l3",
      "speaker": "yusuf",
      "text": "Ja. Die Umwelt schützen macht Spaß.",
      "direction": "قيمة"
    },
    {
      "id": "b1u7d1-l4",
      "speaker": "lena",
      "text": "Und das Klima dankt uns.",
      "direction": "إضافة"
    },
    {
      "id": "b1u7d1-l5",
      "speaker": "yusuf",
      "text": "Der Abfall wird richtig getrennt: Papier, Glas und alles andere.",
      "direction": "تفصيل"
    },
    {
      "id": "b1u7d1-l6",
      "speaker": "lena",
      "text": "Sehr gut! Dann wandern wir im Grünen.",
      "direction": "خطة"
    },
    {
      "id": "b1u7d1-l7",
      "speaker": "yusuf",
      "text": "Los! Die Natur wartet.",
      "direction": "حماس"
    },
    {
      "id": "b1u7d1-l8",
      "speaker": "lena",
      "text": "Und wir schützen sie.",
      "direction": "إغلاق"
    }
  ]
}
