{
  "schemaVersion": "1.0.0",
  "id": "b1-u7-d2-die-aktion",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Aktion",
    "ar": "الحملة"
  },
  "usedIn": [
    "b1-u7-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u7d2-l1",
      "speaker": "lena",
      "text": "Ich freue mich auf die Aktion!",
      "direction": "حماس"
    },
    {
      "id": "b1u7d2-l2",
      "speaker": "yusuf",
      "text": "Welche Aktion?",
      "direction": "استفسار"
    },
    {
      "id": "b1u7d2-l3",
      "speaker": "lena",
      "text": "Gegen den Lärm und die Dürre. Umweltschutz!",
      "direction": "شرح"
    },
    {
      "id": "b1u7d2-l4",
      "speaker": "yusuf",
      "text": "Ich bin dabei! Was machen wir?",
      "direction": "انضمام"
    },
    {
      "id": "b1u7d2-l5",
      "speaker": "lena",
      "text": "Bäume pflanzen und informieren.",
      "direction": "خطة"
    },
    {
      "id": "b1u7d2-l6",
      "speaker": "yusuf",
      "text": "Gut. Die Aktion ist wichtig.",
      "direction": "تأكيد"
    },
    {
      "id": "b1u7d2-l7",
      "speaker": "lena",
      "text": "Ja! Und macht Freude.",
      "direction": "إيجابية"
    },
    {
      "id": "b1u7d2-l8",
      "speaker": "yusuf",
      "text": "Bis Samstag!",
      "direction": "إغلاق"
    }
  ]
}
