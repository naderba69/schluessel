{
  "schemaVersion": "1.0.0",
  "id": "b1-u7-d3-die-ueberschwemmung",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Überschwemmung",
    "ar": "الفيضان"
  },
  "usedIn": [
    "b1-u7-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u7d3-l1",
      "speaker": "yusuf",
      "text": "Als die Überschwemmung kam, sammelten wir das Altglas!",
      "direction": "قصة كارثة"
    },
    {
      "id": "b1u7d3-l2",
      "speaker": "lena",
      "text": "Wirklich? In der Überschwemmung?",
      "direction": "دهشة"
    },
    {
      "id": "b1u7d3-l3",
      "speaker": "yusuf",
      "text": "Ja! Das Wertstoff war noch zu retten.",
      "direction": "شرح"
    },
    {
      "id": "b1u7d3-l4",
      "speaker": "lena",
      "text": "Und die Verpackung?",
      "direction": "تفصيل"
    },
    {
      "id": "b1u7d3-l5",
      "speaker": "yusuf",
      "text": "Auch. Alles trennen, auch im Notfall.",
      "direction": "مبدأ"
    },
    {
      "id": "b1u7d3-l6",
      "speaker": "lena",
      "text": "Das ist stark. Die Umwelt zuerst.",
      "direction": "إعجاب"
    },
    {
      "id": "b1u7d3-l7",
      "speaker": "yusuf",
      "text": "Stimmt. Jeder Wertstoff zählt.",
      "direction": "تأكيد"
    },
    {
      "id": "b1u7d3-l8",
      "speaker": "lena",
      "text": "Hoffentlich kommt keine Überschwemmung wieder.",
      "direction": "أمل"
    }
  ]
}
