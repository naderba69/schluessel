{
  "schemaVersion": "1.0.0",
  "id": "b1-u7-d4-die-umwelt-schuetzen",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Umwelt schützen",
    "ar": "حماية البيئة"
  },
  "usedIn": [
    "b1-u7-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u7d4-l1",
      "speaker": "lena",
      "text": "Ich versuche, die Umwelt zu schützen!",
      "direction": "التزام بيئي"
    },
    {
      "id": "b1u7d4-l2",
      "speaker": "yusuf",
      "text": "Wie genau?",
      "direction": "استفسار"
    },
    {
      "id": "b1u7d4-l3",
      "speaker": "lena",
      "text": "Weniger Plastik. Metall und Glas verwenden.",
      "direction": "خطوات"
    },
    {
      "id": "b1u7d4-l4",
      "speaker": "yusuf",
      "text": "Das ist gut. Und wertvoll für die Erde.",
      "direction": "تأكيد"
    },
    {
      "id": "b1u7d4-l5",
      "speaker": "lena",
      "text": "Ja! Jeder kleine Schritt hilft.",
      "direction": "تشجيع"
    },
    {
      "id": "b1u7d4-l6",
      "speaker": "yusuf",
      "text": "Ich fange heute an.",
      "direction": "عزم"
    },
    {
      "id": "b1u7d4-l7",
      "speaker": "lena",
      "text": "Sehr gut! Zusammen ist es leichter.",
      "direction": "تعاون"
    },
    {
      "id": "b1u7d4-l8",
      "speaker": "yusuf",
      "text": "Für die Umwelt!",
      "direction": "شعار"
    }
  ]
}
