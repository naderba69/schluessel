{
  "schemaVersion": "1.0.0",
  "id": "b1-u7-d6-die-sorge-bleibt",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Sorge bleibt",
    "ar": "القلق يبقى"
  },
  "usedIn": [
    "b1-u7-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u7d6-l1",
      "speaker": "lena",
      "text": "Wir zerstören nichts — die Sorge bleibt!",
      "direction": "هم بيئي"
    },
    {
      "id": "b1u7d6-l2",
      "speaker": "yusuf",
      "text": "Warum die Sorge?",
      "direction": "استفسار"
    },
    {
      "id": "b1u7d6-l3",
      "speaker": "lena",
      "text": "Die Autos, der Müll, die Luft.",
      "direction": "أسباب"
    },
    {
      "id": "b1u7d6-l4",
      "speaker": "yusuf",
      "text": "Aber wir tun viel.",
      "direction": "مواساة"
    },
    {
      "id": "b1u7d6-l5",
      "speaker": "lena",
      "text": "Nicht genug. Die Sorge bleibt.",
      "direction": "إصرار"
    },
    {
      "id": "b1u7d6-l6",
      "speaker": "yusuf",
      "text": "Dann tun wir mehr. Schritt für Schritt.",
      "direction": "تفاؤل"
    },
    {
      "id": "b1u7d6-l7",
      "speaker": "lena",
      "text": "Ja. Hoffentlich wird es besser.",
      "direction": "أمل"
    },
    {
      "id": "b1u7d6-l8",
      "speaker": "yusuf",
      "text": "Es wird. Wir geben nicht auf.",
      "direction": "دعم"
    }
  ]
}
