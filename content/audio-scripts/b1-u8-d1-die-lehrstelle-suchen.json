{
  "schemaVersion": "1.0.0",
  "id": "b1-u8-d1-die-lehrstelle-suchen",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Eine Lehrstelle suchen",
    "ar": "البحث عن تدريب"
  },
  "usedIn": [
    "b1-u8-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u8d1-l1",
      "speaker": "yusuf",
      "text": "Ich suche eine gute Lehrstelle!",
      "direction": "بحث عن عمل"
    },
    {
      "id": "b1u8d1-l2",
      "speaker": "lena",
      "text": "In welcher Tätigkeit?",
      "direction": "استفسار"
    },
    {
      "id": "b1u8d1-l3",
      "speaker": "yusuf",
      "text": "In der Werkstatt. Ich möchte berufstätig sein.",
      "direction": "هدف"
    },
    {
      "id": "b1u8d1-l4",
      "speaker": "lena",
      "text": "Und beruflich wachsen?",
      "direction": "متابعة"
    },
    {
      "id": "b1u8d1-l5",
      "speaker": "yusuf",
      "text": "Ja! Die Lehrstelle ist der erste Schritt.",
      "direction": "خطة"
    },
    {
      "id": "b1u8d1-l6",
      "speaker": "lena",
      "text": "Schau im Internet. Viele suchen Auszubildende.",
      "direction": "نصيحة"
    },
    {
      "id": "b1u8d1-l7",
      "speaker": "yusuf",
      "text": "Gute Idee. Ich schreibe heute Bewerbungen.",
      "direction": "تنفيذ"
    },
    {
      "id": "b1u8d1-l8",
      "speaker": "lena",
      "text": "Viel Erfolg!",
      "direction": "تشجيع"
    }
  ]
}
