{
  "schemaVersion": "1.0.0",
  "id": "b1-u8-d2-bewerbung-um-die-stelle",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Bewerbung um die Stelle",
    "ar": "طلب التوظف"
  },
  "usedIn": [
    "b1-u8-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u8d2-l1",
      "speaker": "yusuf",
      "text": "Guten Tag! Bewerbung um die Stelle als Koch.",
      "direction": "تقديم طلب"
    },
    {
      "id": "b1u8d2-l2",
      "speaker": "mueller",
      "text": "Willkommen! Haben Sie Erfahrung?",
      "direction": "استفسار"
    },
    {
      "id": "b1u8d2-l3",
      "speaker": "yusuf",
      "text": "Ja. Drei Jahre. Ich erwarte eine gute Nachfrage!",
      "direction": "مزاح خفيف"
    },
    {
      "id": "b1u8d2-l4",
      "speaker": "mueller",
      "text": "Die Nachfrage ist tatsächlich hoch.",
      "direction": "رد"
    },
    {
      "id": "b1u8d2-l5",
      "speaker": "yusuf",
      "text": "Und was kann ich von Ihnen erwarten?",
      "direction": "سؤال متبادل"
    },
    {
      "id": "b1u8d2-l6",
      "speaker": "mueller",
      "text": "Faire Arbeit und gute Ausbildung.",
      "direction": "عرض"
    },
    {
      "id": "b1u8d2-l7",
      "speaker": "yusuf",
      "text": "Das ist gut. Danke!",
      "direction": "إعجاب"
    },
    {
      "id": "b1u8d2-l8",
      "speaker": "mueller",
      "text": "Wir melden uns bald.",
      "direction": "إغلاق"
    }
  ]
}
