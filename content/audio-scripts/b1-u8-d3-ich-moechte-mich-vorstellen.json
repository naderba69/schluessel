{
  "schemaVersion": "1.0.0",
  "id": "b1-u8-d3-ich-moechte-mich-vorstellen",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Ich möchte mich vorstellen",
    "ar": "أودّ أن أُعرِّف بنفسي"
  },
  "usedIn": [
    "b1-u8-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u8d3-l1",
      "speaker": "yusuf",
      "text": "Ich möchte mich vorstellen! Ich bin Arbeitnehmer, aber neu.",
      "direction": "يوم أول"
    },
    {
      "id": "b1u8d3-l2",
      "speaker": "lena",
      "text": "Willkommen! Wie sind deine Arbeitszeiten?",
      "direction": "ترحيب"
    },
    {
      "id": "b1u8d3-l3",
      "speaker": "yusuf",
      "text": "Von acht bis fünf. Und Überstunden? Nicht gern!",
      "direction": "مزاح"
    },
    {
      "id": "b1u8d3-l4",
      "speaker": "lena",
      "text": "Verstanden. Wir arbeiten fair.",
      "direction": "طمأنة"
    },
    {
      "id": "b1u8d3-l5",
      "speaker": "yusuf",
      "text": "Danke. Ich freue mich auf die Tätigkeit.",
      "direction": "حماس"
    },
    {
      "id": "b1u8d3-l6",
      "speaker": "lena",
      "text": "Und wir freuen uns auf dich.",
      "direction": "دفء"
    },
    {
      "id": "b1u8d3-l7",
      "speaker": "yusuf",
      "text": "Das ist schön. Bis morgen!",
      "direction": "إغلاق"
    },
    {
      "id": "b1u8d3-l8",
      "speaker": "lena",
      "text": "Bis morgen!",
      "direction": "وداع"
    }
  ]
}
