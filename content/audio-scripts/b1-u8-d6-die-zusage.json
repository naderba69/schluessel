{
  "schemaVersion": "1.0.0",
  "id": "b1-u8-d6-die-zusage",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Zusage",
    "ar": "القبول"
  },
  "usedIn": [
    "b1-u8-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u8d6-l1",
      "speaker": "yusuf",
      "text": "Wir bekommen die Zusage — die Stelle ist besetzt!",
      "direction": "أخبار"
    },
    {
      "id": "b1u8d6-l2",
      "speaker": "lena",
      "text": "Super! Wer bekommt die Stelle?",
      "direction": "استفسار"
    },
    {
      "id": "b1u8d6-l3",
      "speaker": "yusuf",
      "text": "Ich! Die Zusage kam heute.",
      "direction": "فرح"
    },
    {
      "id": "b1u8d6-l4",
      "speaker": "lena",
      "text": "Herzlichen Glückwunsch!",
      "direction": "تهنئة"
    },
    {
      "id": "b1u8d6-l5",
      "speaker": "yusuf",
      "text": "Danke! Die Stelle ist gut für mich.",
      "direction": "رضا"
    },
    {
      "id": "b1u8d6-l6",
      "speaker": "lena",
      "text": "Und wann beginnst du?",
      "direction": "تفصيل"
    },
    {
      "id": "b1u8d6-l7",
      "speaker": "yusuf",
      "text": "Am Montag. Die Zusage ist alles.",
      "direction": "خطة"
    },
    {
      "id": "b1u8d6-l8",
      "speaker": "lena",
      "text": "Viel Erfolg im neuen Job!",
      "direction": "دعم"
    }
  ]
}
