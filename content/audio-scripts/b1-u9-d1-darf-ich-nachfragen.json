{
  "schemaVersion": "1.0.0",
  "id": "b1-u9-d1-darf-ich-nachfragen",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Darf ich nachfragen?",
    "ar": "هل أستفسر؟"
  },
  "usedIn": [
    "b1-u9-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u9d1-l1",
      "speaker": "yusuf",
      "text": "Darf ich nachfragen? — Die Klärung bringt die Einigung!",
      "direction": "درس حوار"
    },
    {
      "id": "b1u9d1-l2",
      "speaker": "lena",
      "text": "Natürlich! Was möchtest du wissen?",
      "direction": "استعداد"
    },
    {
      "id": "b1u9d1-l3",
      "speaker": "yusuf",
      "text": "Eine Rückfrage zum Angebot: Ist das der letzte Preis?",
      "direction": "استفسار مهني"
    },
    {
      "id": "b1u9d1-l4",
      "speaker": "lena",
      "text": "Ja, aber wir können klären: mehr Leistung, mehr Preis.",
      "direction": "تفاوض"
    },
    {
      "id": "b1u9d1-l5",
      "speaker": "yusuf",
      "text": "Gut. Das klären wir gemeinsam.",
      "direction": "تعاون"
    },
    {
      "id": "b1u9d1-l6",
      "speaker": "lena",
      "text": "Und dann gibt es eine Einigung.",
      "direction": "تفاؤل"
    },
    {
      "id": "b1u9d1-l7",
      "speaker": "yusuf",
      "text": "Die Rückfrage war wichtig.",
      "direction": "خلاصة"
    },
    {
      "id": "b1u9d1-l8",
      "speaker": "lena",
      "text": "Immer! Nachfragen hilft.",
      "direction": "إغلاق"
    }
  ]
}
