{
  "schemaVersion": "1.0.0",
  "id": "b1-u9-d2-darf-ich-sie-unterbrechen",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Darf ich Sie unterbrechen?",
    "ar": "هل أقاطع؟"
  },
  "usedIn": [
    "b1-u9-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u9d2-l1",
      "speaker": "yusuf",
      "text": "Darf ich Sie unterbrechen? — Das ist ein Einwand!",
      "direction": "درس اعتراض"
    },
    {
      "id": "b1u9d2-l2",
      "speaker": "mueller",
      "text": "Ja, aber kurz. Was ist Ihr Einwand?",
      "direction": "استقبال"
    },
    {
      "id": "b1u9d2-l3",
      "speaker": "yusuf",
      "text": "Der Preis ist zu hoch. Das ist meine Unterbrechung wert!",
      "direction": "مزاح جدّي"
    },
    {
      "id": "b1u9d2-l4",
      "speaker": "mueller",
      "text": "Verstanden. Ein fairer Einwand.",
      "direction": "اعتراف"
    },
    {
      "id": "b1u9d2-l5",
      "speaker": "yusuf",
      "text": "Danke für die Unterbrechung... für das Verständnis!",
      "direction": "مزاح لغوي"
    },
    {
      "id": "b1u9d2-l6",
      "speaker": "mueller",
      "text": "Aber jetzt weiter: die Lösung.",
      "direction": "توجيه"
    },
    {
      "id": "b1u9d2-l7",
      "speaker": "yusuf",
      "text": "Einverstanden. Der Einwand ist geklärt.",
      "direction": "إغلاق"
    },
    {
      "id": "b1u9d2-l8",
      "speaker": "mueller",
      "text": "Sehr gut gemacht!",
      "direction": "تعزيز"
    }
  ]
}
