{
  "schemaVersion": "1.0.0",
  "id": "b1-u9-d3-das-protokoll",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Das Protokoll",
    "ar": "المحضر"
  },
  "usedIn": [
    "b1-u9-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u9d3-l1",
      "speaker": "mueller",
      "text": "Im Vordergrund steht ein Tisch — und das ist das Protokoll!",
      "direction": "درس تقرير"
    },
    {
      "id": "b1u9d3-l2",
      "speaker": "yusuf",
      "text": "Was steht im Protokoll?",
      "direction": "استفسار"
    },
    {
      "id": "b1u9d3-l3",
      "speaker": "mueller",
      "text": "Die Punkte, die Ideen, die Namen.",
      "direction": "محتوى"
    },
    {
      "id": "b1u9d3-l4",
      "speaker": "yusuf",
      "text": "Und der Hintergrund?",
      "direction": "استفسار"
    },
    {
      "id": "b1u9d3-l5",
      "speaker": "mueller",
      "text": "Die Diskussion. Aber das Protokoll zeigt das Ergebnis.",
      "direction": "تفصيل"
    },
    {
      "id": "b1u9d3-l6",
      "speaker": "yusuf",
      "text": "Also: der Tisch ist der Mittelpunkt.",
      "direction": "تلخيص"
    },
    {
      "id": "b1u9d3-l7",
      "speaker": "mueller",
      "text": "Genau! Protokoll schreiben ist wichtig.",
      "direction": "مبدأ"
    },
    {
      "id": "b1u9d3-l8",
      "speaker": "yusuf",
      "text": "Ich schreibe das nächste Protokoll.",
      "direction": "التزام"
    }
  ]
}
