{
  "schemaVersion": "1.0.0",
  "id": "b1-u9-d4-die-entschaedigung",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Entschädigung",
    "ar": "التعويض"
  },
  "usedIn": [
    "b1-u9-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u9d4-l1",
      "speaker": "yusuf",
      "text": "Ich entschuldige mich für die Unannehmlichkeit — und die Zufriedenheit kommt!",
      "direction": "اعتذار رسمي"
    },
    {
      "id": "b1u9d4-l2",
      "speaker": "mueller",
      "text": "Was ist passiert?",
      "direction": "استفسار"
    },
    {
      "id": "b1u9d4-l3",
      "speaker": "yusuf",
      "text": "Das Paket kam spät. Ich möchte eine Entschädigung.",
      "direction": "شرح + طلب"
    },
    {
      "id": "b1u9d4-l4",
      "speaker": "mueller",
      "text": "Verstanden. Wir erstatten das Geld.",
      "direction": "حل"
    },
    {
      "id": "b1u9d4-l5",
      "speaker": "yusuf",
      "text": "Danke. Die Erstattung reicht.",
      "direction": "رضا"
    },
    {
      "id": "b1u9d4-l6",
      "speaker": "mueller",
      "text": "Und die Zufriedenheit ist wichtig.",
      "direction": "مبدأ"
    },
    {
      "id": "b1u9d4-l7",
      "speaker": "yusuf",
      "text": "Genau. Danke für die schnelle Lösung.",
      "direction": "امتنان"
    },
    {
      "id": "b1u9d4-l8",
      "speaker": "mueller",
      "text": "Kein Problem. Entschuldigung noch einmal.",
      "direction": "إغلاق"
    }
  ]
}
