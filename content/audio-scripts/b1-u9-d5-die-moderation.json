{
  "schemaVersion": "1.0.0",
  "id": "b1-u9-d5-die-moderation",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Moderation",
    "ar": "الإدارة"
  },
  "usedIn": [
    "b1-u9-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u9d5-l1",
      "speaker": "lena",
      "text": "Die Runde ist offen — und der Beschluss wird umgesetzt!",
      "direction": "إدارة اجتماع"
    },
    {
      "id": "b1u9d5-l2",
      "speaker": "yusuf",
      "text": "Moderierst du heute?",
      "direction": "استفسار"
    },
    {
      "id": "b1u9d5-l3",
      "speaker": "lena",
      "text": "Ja! Jeder spricht, dann stimmen wir ab.",
      "direction": "منهجية"
    },
    {
      "id": "b1u9d5-l4",
      "speaker": "yusuf",
      "text": "Und wenn es einen Streit gibt?",
      "direction": "حالة"
    },
    {
      "id": "b1u9d5-l5",
      "speaker": "lena",
      "text": "Dann moderiere ich: erst zuhören, dann entscheiden.",
      "direction": "تهدئة"
    },
    {
      "id": "b1u9d5-l6",
      "speaker": "yusuf",
      "text": "Gute Moderation!",
      "direction": "إشادة"
    },
    {
      "id": "b1u9d5-l7",
      "speaker": "lena",
      "text": "Danke! Und der Beschluss kommt bald.",
      "direction": "خاتمة"
    },
    {
      "id": "b1u9d5-l8",
      "speaker": "yusuf",
      "text": "Ich freue mich.",
      "direction": "مشاركة"
    }
  ]
}
