{
  "schemaVersion": "1.0.0",
  "id": "b1-u9-d6-die-versoehnung",
  "kind": "dialogue",
  "level": "B1",
  "title": {
    "de": "Die Versöhnung",
    "ar": "التصالح"
  },
  "usedIn": [
    "b1-u9-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b1u9d6-l1",
      "speaker": "yusuf",
      "text": "Die Versöhnung kommt — und der Frieden bleibt!",
      "direction": "درس سلام"
    },
    {
      "id": "b1u9d6-l2",
      "speaker": "lena",
      "text": "Über wen sprichst du?",
      "direction": "استفسار"
    },
    {
      "id": "b1u9d6-l3",
      "speaker": "yusuf",
      "text": "Zwei Freunde. Sie haben sich versöhnt.",
      "direction": "قصة"
    },
    {
      "id": "b1u9d6-l4",
      "speaker": "lena",
      "text": "Schön! Versöhnen ist wichtig.",
      "direction": "قيمة"
    },
    {
      "id": "b1u9d6-l5",
      "speaker": "yusuf",
      "text": "Ja. Der Friede ist besser als der Streit.",
      "direction": "حكمة"
    },
    {
      "id": "b1u9d6-l6",
      "speaker": "lena",
      "text": "Und die Versöhnung macht alles leichter.",
      "direction": "إضافة"
    },
    {
      "id": "b1u9d6-l7",
      "speaker": "yusuf",
      "text": "Stimmt. Auf den Frieden!",
      "direction": "نخب"
    },
    {
      "id": "b1u9d6-l8",
      "speaker": "lena",
      "text": "Und auf die Versöhnung!",
      "direction": "إغلاق دافئ"
    }
  ]
}
