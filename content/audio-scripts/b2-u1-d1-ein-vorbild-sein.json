{
  "schemaVersion": "1.0.0",
  "id": "b2-u1-d1-ein-vorbild-sein",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Ein Vorbild sein",
    "ar": "أن تكون قدوة"
  },
  "usedIn": [
    "b2-u1-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u1d1-l1",
      "speaker": "mueller",
      "text": "Ein Vorbild sein und Toleranz zeigen!",
      "direction": "موضوع الأسبوع"
    },
    {
      "id": "b2u1d1-l2",
      "speaker": "yusuf",
      "text": "Was heißt das im Alltag?",
      "direction": "استفسار"
    },
    {
      "id": "b2u1d1-l3",
      "speaker": "mueller",
      "text": "Jeden Tag Toleranz. Und ein Vorbild für die anderen sein.",
      "direction": "تفسير"
    },
    {
      "id": "b2u1d1-l4",
      "speaker": "yusuf",
      "text": "Bei der Begegnung mit neuen Leuten?",
      "direction": "تطبيق"
    },
    {
      "id": "b2u1d1-l5",
      "speaker": "mueller",
      "text": "Genau. Zuhören, verstehen, helfen.",
      "direction": "خطوات"
    },
    {
      "id": "b2u1d1-l6",
      "speaker": "yusuf",
      "text": "Das mache ich schon. Aber nicht jeden Tag.",
      "direction": "صدق"
    },
    {
      "id": "b2u1d1-l7",
      "speaker": "mueller",
      "text": "Heute beginnen! Ein Vorbild wächst mit der Zeit.",
      "direction": "تشجيع"
    },
    {
      "id": "b2u1d1-l8",
      "speaker": "yusuf",
      "text": "Einverstanden. Toleranz zuerst.",
      "direction": "إغلاق"
    }
  ]
}
