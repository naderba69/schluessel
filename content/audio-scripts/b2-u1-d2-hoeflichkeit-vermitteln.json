{
  "schemaVersion": "1.0.0",
  "id": "b2-u1-d2-hoeflichkeit-vermitteln",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Höflichkeit vermitteln",
    "ar": "نقل المهذّبية"
  },
  "usedIn": [
    "b2-u1-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u1d2-l1",
      "speaker": "lena",
      "text": "Mit Höflichkeit vermitteln und Einsatz zeigen!",
      "direction": "درس العلاقات"
    },
    {
      "id": "b2u1d2-l2",
      "speaker": "yusuf",
      "text": "Wie vermittelt man Höflichkeit?",
      "direction": "استفسار"
    },
    {
      "id": "b2u1d2-l3",
      "speaker": "lena",
      "text": "Durch Worte und Taten. Höflichkeit zeigt echten Einsatz.",
      "direction": "إجابة"
    },
    {
      "id": "b2u1d2-l4",
      "speaker": "yusuf",
      "text": "Also: freundlich sein und wirklich helfen?",
      "direction": "تلخيص"
    },
    {
      "id": "b2u1d2-l5",
      "speaker": "lena",
      "text": "Genau. Das vermittelt Respekt.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u1d2-l6",
      "speaker": "yusuf",
      "text": "Im Job ist das wichtig.",
      "direction": "تطبيق"
    },
    {
      "id": "b2u1d2-l7",
      "speaker": "lena",
      "text": "Überall. Höflichkeit öffnet jede Tür.",
      "direction": "حكمة"
    },
    {
      "id": "b2u1d2-l8",
      "speaker": "yusuf",
      "text": "Danke für die Worte!",
      "direction": "إغلاق"
    }
  ]
}
