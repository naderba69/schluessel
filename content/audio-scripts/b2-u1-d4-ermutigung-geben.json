{
  "schemaVersion": "1.0.0",
  "id": "b2-u1-d4-ermutigung-geben",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Ermutigung geben",
    "ar": "التشجيع"
  },
  "usedIn": [
    "b2-u1-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u1d4-l1",
      "speaker": "lena",
      "text": "Ermutigung geben, warnen und Ablehnung verstehen!",
      "direction": "درس الدعم"
    },
    {
      "id": "b2u1d4-l2",
      "speaker": "yusuf",
      "text": "Wann braucht jemand Ermutigung?",
      "direction": "استفسار"
    },
    {
      "id": "b2u1d4-l3",
      "speaker": "lena",
      "text": "Wenn alles schwer ist. Ein gutes Wort hilft auch.",
      "direction": "إجابة"
    },
    {
      "id": "b2u1d4-l4",
      "speaker": "yusuf",
      "text": "Und wenn ich Ablehnung höre?",
      "direction": "حالة"
    },
    {
      "id": "b2u1d4-l5",
      "speaker": "lena",
      "text": "Nicht sofort böse sein. Erst verstehen.",
      "direction": "نصيحة"
    },
    {
      "id": "b2u1d4-l6",
      "speaker": "yusuf",
      "text": "Also: Ermutigung anbieten und vorsichtig sein.",
      "direction": "تلخيص"
    },
    {
      "id": "b2u1d4-l7",
      "speaker": "lena",
      "text": "Genau. Und Ablehnung ist nicht das Ende.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u1d4-l8",
      "speaker": "yusuf",
      "text": "Danke. Das nehme ich mit.",
      "direction": "إغلاق"
    }
  ]
}
