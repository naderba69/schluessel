{
  "schemaVersion": "1.0.0",
  "id": "b2-u1-d5-mit-wuerde-leben",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Mit Würde leben",
    "ar": "العيش بكرامة"
  },
  "usedIn": [
    "b2-u1-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u1d5-l1",
      "speaker": "mueller",
      "text": "Gerechtigkeit schaffen, Geld spenden und mit Würde leben!",
      "direction": "قيم اجتماعية"
    },
    {
      "id": "b2u1d5-l2",
      "speaker": "yusuf",
      "text": "Gerechtigkeit schaffen — wie?",
      "direction": "استفسار"
    },
    {
      "id": "b2u1d5-l3",
      "speaker": "mueller",
      "text": "Fair handeln. Und die Schwachen unterstützen.",
      "direction": "تفسير"
    },
    {
      "id": "b2u1d5-l4",
      "speaker": "yusuf",
      "text": "Mit Geld spenden?",
      "direction": "تطبيق"
    },
    {
      "id": "b2u1d5-l5",
      "speaker": "mueller",
      "text": "Oder mit Zeit. Würde bedeutet: jeder zählt.",
      "direction": "توسيع"
    },
    {
      "id": "b2u1d5-l6",
      "speaker": "yusuf",
      "text": "Ein starkes Wort: Würde.",
      "direction": "تأمل"
    },
    {
      "id": "b2u1d5-l7",
      "speaker": "mueller",
      "text": "Ja. Mit Würde leben ist das Beste.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u1d5-l8",
      "speaker": "yusuf",
      "text": "Und Gerechtigkeit ist der Weg.",
      "direction": "إغلاق"
    }
  ]
}
