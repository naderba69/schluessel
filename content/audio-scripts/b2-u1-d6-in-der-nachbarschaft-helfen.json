{
  "schemaVersion": "1.0.0",
  "id": "b2-u1-d6-in-der-nachbarschaft-helfen",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "In der Nachbarschaft helfen",
    "ar": "المساعدة في الحي"
  },
  "usedIn": [
    "b2-u1-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u1d6-l1",
      "speaker": "lena",
      "text": "In der Nachbarschaft helfen, Anteilnahme zeigen und vergeben!",
      "direction": "حياة المجتمع"
    },
    {
      "id": "b2u1d6-l2",
      "speaker": "yusuf",
      "text": "Was machen wir für die Nachbarschaft?",
      "direction": "استفسار"
    },
    {
      "id": "b2u1d6-l3",
      "speaker": "lena",
      "text": "Alte Leute besuchen. Anteilnahme zeigen.",
      "direction": "خطة"
    },
    {
      "id": "b2u1d6-l4",
      "speaker": "yusuf",
      "text": "Und vergeben? Wann?",
      "direction": "استفسار"
    },
    {
      "id": "b2u1d6-l5",
      "speaker": "lena",
      "text": "Wenn es Streit gibt. Vergeben macht frei.",
      "direction": "حكمة"
    },
    {
      "id": "b2u1d6-l6",
      "speaker": "yusuf",
      "text": "Gut. Ich fange bei den Nachbarn an.",
      "direction": "عزم"
    },
    {
      "id": "b2u1d6-l7",
      "speaker": "lena",
      "text": "Sehr gut! Die Nachbarschaft wird stärker.",
      "direction": "تعزيز"
    },
    {
      "id": "b2u1d6-l8",
      "speaker": "yusuf",
      "text": "Zusammen ist es leichter.",
      "direction": "إغلاق"
    }
  ]
}
