{
 "schemaVersion": "1.0.0",
 "id": "b2-u13-d1-der-lernplan",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Der Lernplan",
  "ar": "خطة التعلّم"
 },
 "usedIn": [
  "b2-u13-d1"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u13d1-l1",
   "speaker": "mueller",
   "text": "Der Lernplan ist klar: die Fertigkeit wächst, und die Selbstkontrolle hilft!",
   "direction": "خطة الأسبوع"
  },
  {
   "id": "b2u13d1-l2",
   "speaker": "yusuf",
   "text": "Was ist der Lernplan?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d1-l3",
   "speaker": "mueller",
   "text": "Der Lernplan zeigt: heute wiederholen, morgen üben.",
   "direction": "تعريف"
  },
  {
   "id": "b2u13d1-l4",
   "speaker": "yusuf",
   "text": "Und die Fertigkeit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d1-l5",
   "speaker": "mueller",
   "text": "Die Fertigkeit wächst mit jeder Übung.",
   "direction": "تفسير"
  },
  {
   "id": "b2u13d1-l6",
   "speaker": "yusuf",
   "text": "Und die Selbstkontrolle?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d1-l7",
   "speaker": "mueller",
   "text": "Die Selbstkontrolle hilft beim Lernen.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u13d1-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich beginne heute.",
   "direction": "إغلاق"
  }
 ]
}
