{
 "schemaVersion": "1.0.0",
 "id": "b2-u13-d3-die-pruefungsangst",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Prüfungsangst",
  "ar": "قلق الامتحان"
 },
 "usedIn": [
  "b2-u13-d3"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u13d3-l1",
   "speaker": "lena",
   "text": "Die Prüfungsangst ist weg: die Gelassenheit bleibt und die Zuversicht wächst!",
   "direction": "الأعصاب"
  },
  {
   "id": "b2u13d3-l2",
   "speaker": "yusuf",
   "text": "Ich habe Prüfungsangst.",
   "direction": "شكوى"
  },
  {
   "id": "b2u13d3-l3",
   "speaker": "lena",
   "text": "Das ist normal. Die Gelassenheit hilft.",
   "direction": "مواساة"
  },
  {
   "id": "b2u13d3-l4",
   "speaker": "yusuf",
   "text": "Wie finde ich Gelassenheit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d3-l5",
   "speaker": "lena",
   "text": "Atmen Sie tief — und denken Sie positiv.",
   "direction": "نصيحة"
  },
  {
   "id": "b2u13d3-l6",
   "speaker": "yusuf",
   "text": "Und die Zuversicht?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d3-l7",
   "speaker": "lena",
   "text": "Die Zuversicht wächst jeden Tag.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u13d3-l8",
   "speaker": "yusuf",
   "text": "Danke! Das hilft.",
   "direction": "إغلاق"
  }
 ]
}
