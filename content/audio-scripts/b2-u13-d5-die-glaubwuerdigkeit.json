{
 "schemaVersion": "1.0.0",
 "id": "b2-u13-d5-die-glaubwuerdigkeit",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Glaubwürdigkeit",
  "ar": "المصداقية"
 },
 "usedIn": [
  "b2-u13-d5"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u13d5-l1",
   "speaker": "mueller",
   "text": "Die Glaubwürdigkeit ist wichtig: die Korrektur kommt und der Durchgang ist vorbei!",
   "direction": "المصداقية"
  },
  {
   "id": "b2u13d5-l2",
   "speaker": "yusuf",
   "text": "Was ist die Glaubwürdigkeit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d5-l3",
   "speaker": "mueller",
   "text": "Die Glaubwürdigkeit heißt: man kann dem Text glauben.",
   "direction": "تعريف"
  },
  {
   "id": "b2u13d5-l4",
   "speaker": "yusuf",
   "text": "Und die Korrektur?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d5-l5",
   "speaker": "mueller",
   "text": "Die Korrektur zeigt die Fehler und die guten Stellen.",
   "direction": "تفسير"
  },
  {
   "id": "b2u13d5-l6",
   "speaker": "yusuf",
   "text": "Und der Durchgang?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d5-l7",
   "speaker": "mueller",
   "text": "Jeder Durchgang macht uns besser.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u13d5-l8",
   "speaker": "yusuf",
   "text": "Ich bleibe dran.",
   "direction": "إغلاق"
  }
 ]
}
