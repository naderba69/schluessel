{
 "schemaVersion": "1.0.0",
 "id": "b2-u13-d6-die-selbsteinschaetzung",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Selbsteinschätzung",
  "ar": "التقييم الذاتي"
 },
 "usedIn": [
  "b2-u13-d6"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u13d6-l1",
   "speaker": "mueller",
   "text": "Die Selbsteinschätzung ist ehrlich: der Prüfling ist bereit und das Bestehen ist nah!",
   "direction": "الختام"
  },
  {
   "id": "b2u13d6-l2",
   "speaker": "yusuf",
   "text": "Was ist die Selbsteinschätzung?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d6-l3",
   "speaker": "mueller",
   "text": "Die Selbsteinschätzung heißt: ich weiß, was ich kann.",
   "direction": "تعريف"
  },
  {
   "id": "b2u13d6-l4",
   "speaker": "yusuf",
   "text": "Und der Prüfling?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d6-l5",
   "speaker": "mueller",
   "text": "Der Prüfling kommt morgen zur Prüfung.",
   "direction": "تفسير"
  },
  {
   "id": "b2u13d6-l6",
   "speaker": "yusuf",
   "text": "Und das Bestehen?",
   "direction": "استفسار"
  },
  {
   "id": "b2u13d6-l7",
   "speaker": "mueller",
   "text": "Das Bestehen ist das Ziel — und du schaffst das!",
   "direction": "مبدأ"
  },
  {
   "id": "b2u13d6-l8",
   "speaker": "yusuf",
   "text": "Danke für alles!",
   "direction": "إغلاق"
  }
 ]
}
