{
 "schemaVersion": "1.0.0",
 "id": "b2-u14-d3-die-klarheit",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Klarheit",
  "ar": "الوضوح"
 },
 "usedIn": [
  "b2-u14-d3"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u14d3-l1",
   "speaker": "mueller",
   "text": "Die Klarheit im Kopf: mit Gründlichkeit lösen — und eine Atempause nicht vergessen!",
   "direction": "أثناء الامتحان"
  },
  {
   "id": "b2u14d3-l2",
   "speaker": "yusuf",
   "text": "Was ist die Klarheit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u14d3-l3",
   "speaker": "mueller",
   "text": "Die Klarheit hilft beim Lesen und Denken.",
   "direction": "تعريف"
  },
  {
   "id": "b2u14d3-l4",
   "speaker": "yusuf",
   "text": "Und die Gründlichkeit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u14d3-l5",
   "speaker": "mueller",
   "text": "Die Gründlichkeit verhindert Fehler.",
   "direction": "تفسير"
  },
  {
   "id": "b2u14d3-l6",
   "speaker": "yusuf",
   "text": "Und die Atempause?",
   "direction": "استفسار"
  },
  {
   "id": "b2u14d3-l7",
   "speaker": "mueller",
   "text": "Die Atempause ist kurz — und wichtig!",
   "direction": "مبدأ"
  },
  {
   "id": "b2u14d3-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich bleibe klar.",
   "direction": "إغلاق"
  }
 ]
}
