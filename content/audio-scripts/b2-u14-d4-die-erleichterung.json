{
 "schemaVersion": "1.0.0",
 "id": "b2-u14-d4-die-erleichterung",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Erleichterung",
  "ar": "الارتياح"
 },
 "usedIn": [
  "b2-u14-d4"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u14d4-l1",
   "speaker": "lena",
   "text": "Die Erleichterung nach der Prüfung: ein langer Seufzer — und die Ernüchterung kommt später!",
   "direction": "بعد التسليم"
  },
  {
   "id": "b2u14d4-l2",
   "speaker": "yusuf",
   "text": "Was ist die Erleichterung?",
   "direction": "استفسار"
  },
  {
   "id": "b2u14d4-l3",
   "speaker": "lena",
   "text": "Die Erleichterung ist das Gefühl nach der Prüfung.",
   "direction": "تعريف"
  },
  {
   "id": "b2u14d4-l4",
   "speaker": "yusuf",
   "text": "Und die Ernüchterung?",
   "direction": "استفسار"
  },
  {
   "id": "b2u14d4-l5",
   "speaker": "lena",
   "text": "Die Ernüchterung kommt, wenn etwas schwer war.",
   "direction": "تفسير"
  },
  {
   "id": "b2u14d4-l6",
   "speaker": "yusuf",
   "text": "Und der Seufzer?",
   "direction": "استفسار"
  },
  {
   "id": "b2u14d4-l7",
   "speaker": "lena",
   "text": "Der Seufzer zeigt: es ist vorbei!",
   "direction": "مبدأ"
  },
  {
   "id": "b2u14d4-l8",
   "speaker": "yusuf",
   "text": "Puh. Es ist vorbei!",
   "direction": "إغلاق"
  }
 ]
}
