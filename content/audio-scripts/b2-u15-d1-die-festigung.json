 "title": {
  "de": "Die Festigung",
  "ar": "التثبيت"
 },
 "usedIn": [
  "b2-u15-d1"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u15d1-l1",
   "speaker": "mueller",
   "text": "Die Festigung ist der Anfang: mit Beständigkeit und Kontinuität bleibt alles!",
   "direction": "يوم التثبيت"
  },
  {
   "id": "b2u15d1-l2",
   "speaker": "yusuf",
   "text": "Was ist die Festigung?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d1-l3",
   "speaker": "mueller",
   "text": "Die Festigung macht das Gelernte stark.",
   "direction": "تعريف"
  },
  {
   "id": "b2u15d1-l4",
   "speaker": "yusuf",
   "text": "Und die Beständigkeit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d1-l5",
   "speaker": "mueller",
   "text": "Die Beständigkeit heißt: jeden Tag ein wenig.",
   "direction": "تفسير"
  },
  {
   "id": "b2u15d1-l6",
   "speaker": "yusuf",
   "text": "Und die Kontinuität?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d1-l7",
   "speaker": "mueller",
   "text": "Die Kontinuität verbindet die Tage.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u15d1-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich bleibe dran.",
   "direction": "إغلاق"
  }
 ]
}
