{
 "schemaVersion": "1.0.0",
 "id": "b2-u15-d2-der-eifer",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Der Eifer",
  "ar": "الجدّ"
 },
 "usedIn": [
  "b2-u15-d2"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u15d2-l1",
   "speaker": "lena",
   "text": "Der Eifer am Morgen: mit Entschlossenheit und Hartnäckigkeit geht alles!",
   "direction": "يوم الجدّ"
  },
  {
   "id": "b2u15d2-l2",
   "speaker": "yusuf",
   "text": "Was ist der Eifer?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d2-l3",
   "speaker": "lena",
   "text": "Der Eifer ist die Freude am Arbeiten.",
   "direction": "تعريف"
  },
  {
   "id": "b2u15d2-l4",
   "speaker": "yusuf",
   "text": "Und die Entschlossenheit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d2-l5",
   "speaker": "lena",
   "text": "Die Entschlossenheit gibt Kraft.",
   "direction": "تفسير"
  },
  {
   "id": "b2u15d2-l6",
   "speaker": "yusuf",
   "text": "Und die Hartnäckigkeit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d2-l7",
   "speaker": "lena",
   "text": "Die Hartnäckigkeit hält lange an.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u15d2-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich arbeite weiter.",
   "direction": "إغلاق"
  }
 ]
}
