{
 "schemaVersion": "1.0.0",
 "id": "b2-u15-d3-die-wirksamkeit",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Wirksamkeit",
  "ar": "الفعالية"
 },
 "usedIn": [
  "b2-u15-d3"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u15d3-l1",
   "speaker": "mueller",
   "text": "Die Wirksamkeit jeder Handlung: mit Effizienz arbeiten und die Verbesserung suchen!",
   "direction": "يوم الفعالية"
  },
  {
   "id": "b2u15d3-l2",
   "speaker": "yusuf",
   "text": "Was ist die Wirksamkeit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d3-l3",
   "speaker": "mueller",
   "text": "Die Wirksamkeit zeigt: die Handlung wirkt.",
   "direction": "تعريف"
  },
  {
   "id": "b2u15d3-l4",
   "speaker": "yusuf",
   "text": "Und die Effizienz?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d3-l5",
   "speaker": "mueller",
   "text": "Die Effizienz spart Zeit und Kraft.",
   "direction": "تفسير"
  },
  {
   "id": "b2u15d3-l6",
   "speaker": "yusuf",
   "text": "Und die Verbesserung?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d3-l7",
   "speaker": "mueller",
   "text": "Die Verbesserung kommt Schritt für Schritt.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u15d3-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich verbessere weiter.",
   "direction": "إغلاق"
  }
 ]
}
