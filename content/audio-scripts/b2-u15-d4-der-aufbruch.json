{
  "schemaVersion": "1.0.0",
  "id": "b2-u15-d4-der-aufbruch",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Der Aufbruch",
    "ar": "الانطلاق"
  },
  "usedIn": [
    "b2-u15-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u15d4-l1",
      "speaker": "lena",
      "text": "Der Aufbruch nach der Prüfung: der Wendepunkt ist da und der Meilenstein ist groß!",
      "direction": "يوم الانطلاق"
    },
    {
      "id": "b2u15d4-l2",
      "speaker": "yusuf",
      "text": "Was ist der Aufbruch?",
      "direction": "استفسار"
    },
    {
      "id": "b2u15d4-l3",
      "speaker": "lena",
      "text": "Der Aufbruch ist der Start ins Neue.",
      "direction": "تعريف"
    },
    {
      "id": "b2u15d4-l4",
      "speaker": "yusuf",
      "text": "Und der Wendepunkt?",
      "direction": "استفسار"
    },
    {
      "id": "b2u15d4-l5",
      "speaker": "lena",
      "text": "Der Wendepunkt verändert den Weg.",
      "direction": "تفسير"
    },
    {
      "id": "b2u15d4-l6",
      "speaker": "yusuf",
      "text": "Und der Meilenstein?",
      "direction": "استفسار"
    },
    {
      "id": "b2u15d4-l7",
      "speaker": "lena",
      "text": "Der Meilenstein zeigt: wir sind weit gekommen.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u15d4-l8",
      "speaker": "yusuf",
      "text": "Gut. Ich schaue nach vorn.",
      "direction": "إغلاق"
    }
  ]
}