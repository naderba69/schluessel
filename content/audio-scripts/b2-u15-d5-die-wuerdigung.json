{
 "schemaVersion": "1.0.0",
 "id": "b2-u15-d5-die-wuerdigung",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Würdigung",
  "ar": "التقدير"
 },
 "usedIn": [
  "b2-u15-d5"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u15d5-l1",
   "speaker": "mueller",
   "text": "Die Würdigung der Arbeit: eine Zeremonie für alle — und der Ansporn bleibt!",
   "direction": "يوم التقدير"
  },
  {
   "id": "b2u15d5-l2",
   "speaker": "yusuf",
   "text": "Was ist die Würdigung?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d5-l3",
   "speaker": "mueller",
   "text": "Die Würdigung zeigt: die Arbeit zählt.",
   "direction": "تعريف"
  },
  {
   "id": "b2u15d5-l4",
   "speaker": "yusuf",
   "text": "Und die Zeremonie?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d5-l5",
   "speaker": "mueller",
   "text": "Die Zeremonie feiert den Weg.",
   "direction": "تفسير"
  },
  {
   "id": "b2u15d5-l6",
   "speaker": "yusuf",
   "text": "Und der Ansporn?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d5-l7",
   "speaker": "mueller",
   "text": "Der Ansporn treibt uns an.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u15d5-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich bleibe motiviert.",
   "direction": "إغلاق"
  }
 ]
}
