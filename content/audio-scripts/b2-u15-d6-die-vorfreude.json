{
 "schemaVersion": "1.0.0",
 "id": "b2-u15-d6-die-vorfreude",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Vorfreude",
  "ar": "الفرحة المتوقّعة"
 },
 "usedIn": [
  "b2-u15-d6"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u15d6-l1",
   "speaker": "mueller",
   "text": "Die Vorfreude auf den Weg: mit Selbstständigkeit und Lebensfreude geht es weiter!",
   "direction": "يوم الفرح"
  },
  {
   "id": "b2u15d6-l2",
   "speaker": "yusuf",
   "text": "Was ist die Vorfreude?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d6-l3",
   "speaker": "mueller",
   "text": "Die Vorfreude ist die Freude vor dem Kommen.",
   "direction": "تعريف"
  },
  {
   "id": "b2u15d6-l4",
   "speaker": "yusuf",
   "text": "Und die Selbstständigkeit?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d6-l5",
   "speaker": "mueller",
   "text": "Die Selbstständigkeit macht frei.",
   "direction": "تفسير"
  },
  {
   "id": "b2u15d6-l6",
   "speaker": "yusuf",
   "text": "Und die Lebensfreude?",
   "direction": "استفسار"
  },
  {
   "id": "b2u15d6-l7",
   "speaker": "mueller",
   "text": "Die Lebensfreude begleitet uns überall.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u15d6-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich freue mich auf den Weg!",
   "direction": "إغلاق"
  }
 ]
}
