{
  "schemaVersion": "1.0.0",
  "id": "b2-u2-d1-die-luft-nicht-verschmutzen",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Luft nicht verschmutzen",
    "ar": "عدم تلويث الهواء"
  },
  "usedIn": [
    "b2-u2-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u2d1-l1",
      "speaker": "yusuf",
      "text": "Die Luft nicht verschmutzen, Nachhaltigkeit leben und die Auswirkung verstehen!",
      "direction": "درس بيئي"
    },
    {
      "id": "b2u2d1-l2",
      "speaker": "lena",
      "text": "Die Auswirkung der Autos ist groß.",
      "direction": "تأكيد"
    },
    {
      "id": "b2u2d1-l3",
      "speaker": "yusuf",
      "text": "Deswegen: Nachhaltigkeit. Weniger Autos, mehr Züge.",
      "direction": "حلول"
    },
    {
      "id": "b2u2d1-l4",
      "speaker": "lena",
      "text": "Und die Luft bleibt sauber.",
      "direction": "غاية"
    },
    {
      "id": "b2u2d1-l5",
      "speaker": "yusuf",
      "text": "Jeder kann etwas tun.",
      "direction": "تحفيز"
    },
    {
      "id": "b2u2d1-l6",
      "speaker": "lena",
      "text": "Stimmt. Die Auswirkung von kleinen Taten ist auch groß.",
      "direction": "توسيع"
    },
    {
      "id": "b2u2d1-l7",
      "speaker": "yusuf",
      "text": "Dann beginnen wir heute.",
      "direction": "عزم"
    },
    {
      "id": "b2u2d1-l8",
      "speaker": "lena",
      "text": "Für saubere Luft!",
      "direction": "شعار"
    }
  ]
}
