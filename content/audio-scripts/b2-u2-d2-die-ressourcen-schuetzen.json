{
  "schemaVersion": "1.0.0",
  "id": "b2-u2-d2-die-ressourcen-schuetzen",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Ressourcen schützen",
    "ar": "حماية الموارد"
  },
  "usedIn": [
    "b2-u2-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u2d2-l1",
      "speaker": "lena",
      "text": "Die Ressourcen schützen, erneuerbare Energie nutzen und nichts verbrennen!",
      "direction": "استدامة"
    },
    {
      "id": "b2u2d2-l2",
      "speaker": "yusuf",
      "text": "Welche Ressourcen sind sehr wichtig?",
      "direction": "استفسار"
    },
    {
      "id": "b2u2d2-l3",
      "speaker": "lena",
      "text": "Wasser und Wald. Und die Energie natürlich.",
      "direction": "إجابة"
    },
    {
      "id": "b2u2d2-l4",
      "speaker": "yusuf",
      "text": "Erneuerbare Energie ist die Lösung.",
      "direction": "رأي"
    },
    {
      "id": "b2u2d2-l5",
      "speaker": "lena",
      "text": "Genau. Sonne und Wind statt Verbrennen.",
      "direction": "تفسير"
    },
    {
      "id": "b2u2d2-l6",
      "speaker": "yusuf",
      "text": "Das schont die Ressourcen.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u2d2-l7",
      "speaker": "lena",
      "text": "Und die Erde für die nächsten.",
      "direction": "نظرة أمامية"
    },
    {
      "id": "b2u2d2-l8",
      "speaker": "yusuf",
      "text": "Ein gutes Ziel.",
      "direction": "إغلاق"
    }
  ]
}
