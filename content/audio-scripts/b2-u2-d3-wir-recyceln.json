{
  "schemaVersion": "1.0.0",
  "id": "b2-u2-d3-wir-recyceln",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Wir recyceln",
    "ar": "نعيد التدوير"
  },
  "usedIn": [
    "b2-u2-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u2d3-l1",
      "speaker": "yusuf",
      "text": "Der Klimawandel ist gefährlich — wir recyceln und schonen die Umwelt!",
      "direction": "مواجهة التغير المناخي"
    },
    {
      "id": "b2u2d3-l2",
      "speaker": "lena",
      "text": "Was recycelst du zuerst?",
      "direction": "استفسار"
    },
    {
      "id": "b2u2d3-l3",
      "speaker": "yusuf",
      "text": "Papier, Glas, Metall. Alles trennen.",
      "direction": "خطوات"
    },
    {
      "id": "b2u2d3-l4",
      "speaker": "lena",
      "text": "Und schonen? Wie?",
      "direction": "استفسار"
    },
    {
      "id": "b2u2d3-l5",
      "speaker": "yusuf",
      "text": "Weniger kaufen, länger benutzen.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u2d3-l6",
      "speaker": "lena",
      "text": "Der Klimawandel verlangt Handeln.",
      "direction": "جدّية"
    },
    {
      "id": "b2u2d3-l7",
      "speaker": "yusuf",
      "text": "Ja. Jeder kleine Schritt zählt.",
      "direction": "تشجيع"
    },
    {
      "id": "b2u2d3-l8",
      "speaker": "lena",
      "text": "Dann recyceln wir zusammen!",
      "direction": "إغلاق"
    }
  ]
}
