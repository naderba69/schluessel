{
  "schemaVersion": "1.0.0",
  "id": "b2-u2-d4-nach-der-flut",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Nach der Flut",
    "ar": "بعد الفيضان"
  },
  "usedIn": [
    "b2-u2-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u2d4-l1",
      "speaker": "lena",
      "text": "Nach der Flut machen wir eine Entdeckung: Das Trinkwasser ist wichtig!",
      "direction": "قصة كارثة"
    },
    {
      "id": "b2u2d4-l2",
      "speaker": "yusuf",
      "text": "Welche Entdeckung?",
      "direction": "استفسار"
    },
    {
      "id": "b2u2d4-l3",
      "speaker": "lena",
      "text": "Nach der Flut war das Wasser schmutzig. Trinkwasser wurde wertvoll.",
      "direction": "سرد"
    },
    {
      "id": "b2u2d4-l4",
      "speaker": "yusuf",
      "text": "Das ist eine wichtige Entdeckung.",
      "direction": "تأكيد"
    },
    {
      "id": "b2u2d4-l5",
      "speaker": "lena",
      "text": "Ja. Wir müssen das Trinkwasser schützen.",
      "direction": "درس"
    },
    {
      "id": "b2u2d4-l6",
      "speaker": "yusuf",
      "text": "Und für die Flut besser vorbereitet sein.",
      "direction": "استنتاج"
    },
    {
      "id": "b2u2d4-l7",
      "speaker": "lena",
      "text": "Genau. Wasser ist Leben.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u2d4-l8",
      "speaker": "yusuf",
      "text": "Das merke ich mir.",
      "direction": "إغلاق"
    }
  ]
}
