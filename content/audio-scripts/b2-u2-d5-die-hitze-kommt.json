{
  "schemaVersion": "1.0.0",
  "id": "b2-u2-d5-die-hitze-kommt",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Hitze kommt",
    "ar": "الحرارة قادمة"
  },
  "usedIn": [
    "b2-u2-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u2d5-l1",
      "speaker": "yusuf",
      "text": "Die Hitze kommt — aber wir bewahren die Erde vor der Erderwärmung!",
      "direction": "مواجهة الحرارة"
    },
    {
      "id": "b2u2d5-l2",
      "speaker": "lena",
      "text": "Die Hitze jedes Jahr ist schlimmer.",
      "direction": "ملاحظة"
    },
    {
      "id": "b2u2d5-l3",
      "speaker": "yusuf",
      "text": "Wegen der Erderwärmung.",
      "direction": "تفسير"
    },
    {
      "id": "b2u2d5-l4",
      "speaker": "lena",
      "text": "Was können wir tun?",
      "direction": "سؤال"
    },
    {
      "id": "b2u2d5-l5",
      "speaker": "yusuf",
      "text": "Bäume pflanzen, Energie sparen. Die Erde bewahren.",
      "direction": "حلول"
    },
    {
      "id": "b2u2d5-l6",
      "speaker": "lena",
      "text": "Und in der Hitze: viel Wasser trinken.",
      "direction": "نصيحة شخصية"
    },
    {
      "id": "b2u2d5-l7",
      "speaker": "yusuf",
      "text": "Das auch.",
      "direction": "مزاح"
    },
    {
      "id": "b2u2d5-l8",
      "speaker": "lena",
      "text": "Im Ernst: die Erde bewahren ist unsere Aufgabe.",
      "direction": "جدّية"
    }
  ]
}
