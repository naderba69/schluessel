{
  "schemaVersion": "1.0.0",
  "id": "b2-u2-d6-das-gleichgewicht-bewahren",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Das Gleichgewicht bewahren",
    "ar": "حفظ التوازن"
  },
  "usedIn": [
    "b2-u2-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u2d6-l1",
      "speaker": "lena",
      "text": "Das Gleichgewicht bewahren, bewusst leben und die Emissionen vermeiden!",
      "direction": "توازن"
    },
    {
      "id": "b2u2d6-l2",
      "speaker": "yusuf",
      "text": "Wie lebt man bewusst?",
      "direction": "استفسار"
    },
    {
      "id": "b2u2d6-l3",
      "speaker": "lena",
      "text": "Jede Entscheidung prüfen: brauche ich das? Was kostet es die Umwelt?",
      "direction": "تفسير"
    },
    {
      "id": "b2u2d6-l4",
      "speaker": "yusuf",
      "text": "Und die Emissionen?",
      "direction": "استفسار"
    },
    {
      "id": "b2u2d6-l5",
      "speaker": "lena",
      "text": "Vermeiden: weniger Auto, mehr Bahn.",
      "direction": "حلول"
    },
    {
      "id": "b2u2d6-l6",
      "speaker": "yusuf",
      "text": "Das Gleichgewicht ist wichtig.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u2d6-l7",
      "speaker": "lena",
      "text": "Ja. Bewusst leben rettet die Erde.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u2d6-l8",
      "speaker": "yusuf",
      "text": "Dann lebe ich bewusst.",
      "direction": "عزم"
    }
  ]
}
