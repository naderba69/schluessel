{
  "schemaVersion": "1.0.0",
  "id": "b2-u3-d1-die-digitalisierung",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Digitalisierung",
    "ar": "الرقمنة"
  },
  "usedIn": [
    "b2-u3-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u3d1-l1",
      "speaker": "mueller",
      "text": "Bildung und Technik: Wir verstehen die Digitalisierung!",
      "direction": "درس التقنية"
    },
    {
      "id": "b2u3d1-l2",
      "speaker": "yusuf",
      "text": "Was macht die Digitalisierung?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d1-l3",
      "speaker": "mueller",
      "text": "Alles: Lernen, Arbeiten, Sprechen.",
      "direction": "تفسير"
    },
    {
      "id": "b2u3d1-l4",
      "speaker": "yusuf",
      "text": "Auch die Bildung?",
      "direction": "تطبيق"
    },
    {
      "id": "b2u3d1-l5",
      "speaker": "mueller",
      "text": "Besonders die. Online-Lernen ist heute normal.",
      "direction": "إجابة"
    },
    {
      "id": "b2u3d1-l6",
      "speaker": "yusuf",
      "text": "Aber das echte Buch bleibt wichtig.",
      "direction": "رأي معاكس"
    },
    {
      "id": "b2u3d1-l7",
      "speaker": "mueller",
      "text": "Stimmt. Beides zusammen ist die Zukunft.",
      "direction": "توازن"
    },
    {
      "id": "b2u3d1-l8",
      "speaker": "yusuf",
      "text": "Also: Technik nutzen, aber nicht vergessen.",
      "direction": "إغلاق"
    }
  ]
}
