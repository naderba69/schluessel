{
  "schemaVersion": "1.0.0",
  "id": "b2-u3-d2-die-innovation",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Innovation",
    "ar": "الابتكار"
  },
  "usedIn": [
    "b2-u3-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u3d2-l1",
      "speaker": "yusuf",
      "text": "Die Innovation: Wir machen das Experiment und gewinnen die Erkenntnis!",
      "direction": "درس التجربة"
    },
    {
      "id": "b2u3d2-l2",
      "speaker": "lena",
      "text": "Welches Experiment?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d2-l3",
      "speaker": "yusuf",
      "text": "Ein neuer Versuch mit Computern. Die Innovation beginnt klein.",
      "direction": "سرد"
    },
    {
      "id": "b2u3d2-l4",
      "speaker": "lena",
      "text": "Und die Erkenntnis?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d2-l5",
      "speaker": "yusuf",
      "text": "Die kommt nach der Arbeit. Fehler sind auch Erkenntnisse.",
      "direction": "حكمة"
    },
    {
      "id": "b2u3d2-l6",
      "speaker": "lena",
      "text": "Interessant! Innovation braucht Mut.",
      "direction": "رأي"
    },
    {
      "id": "b2u3d2-l7",
      "speaker": "yusuf",
      "text": "Und Geduld.",
      "direction": "إضافة"
    },
    {
      "id": "b2u3d2-l8",
      "speaker": "lena",
      "text": "Viel Erfolg beim Experiment!",
      "direction": "تشجيع"
    }
  ]
}
