  "schemaVersion": "1.0.0",
  "id": "b2-u3-d3-der-roboter-arbeitet",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Der Roboter arbeitet",
    "ar": "الروبوت يعمل"
  },
  "usedIn": [
    "b2-u3-d3"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u3d3-l1",
      "speaker": "mueller",
      "text": "Die Vernetzung: Der Roboter arbeitet und wir verstehen den Algorithmus!",
      "direction": "عالم الروبوتات"
    },
    {
      "id": "b2u3d3-l2",
      "speaker": "yusuf",
      "text": "Versteht der Roboter uns?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d3-l3",
      "speaker": "mueller",
      "text": "Er folgt dem Algorithmus. Aber die Vernetzung macht ihn klug.",
      "direction": "تفسير"
    },
    {
      "id": "b2u3d3-l4",
      "speaker": "yusuf",
      "text": "Also: der Mensch bleibt wichtiger?",
      "direction": "سؤال فلسفي"
    },
    {
      "id": "b2u3d3-l5",
      "speaker": "mueller",
      "text": "Ja. Wir denken, der Roboter arbeitet.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u3d3-l6",
      "speaker": "yusuf",
      "text": "Und die Vernetzung verbindet alles.",
      "direction": "إضافة"
    },
    {
      "id": "b2u3d3-l7",
      "speaker": "mueller",
      "text": "Genau. Zukunft ist Zusammenarbeit.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u3d3-l8",
      "speaker": "yusuf",
      "text": "Mensch und Maschine.",
      "direction": "إغلاق"
    }
  ]
}
