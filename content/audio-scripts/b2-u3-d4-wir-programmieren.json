{
  "schemaVersion": "1.0.0",
  "id": "b2-u3-d4-wir-programmieren",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Wir programmieren",
    "ar": "نبرمج"
  },
  "usedIn": [
    "b2-u3-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u3d4-l1",
      "speaker": "yusuf",
      "text": "Wir programmieren den Roboter — die Automatisierung kommt mit der Technologie!",
      "direction": "درس البرمجة"
    },
    {
      "id": "b2u3d4-l2",
      "speaker": "lena",
      "text": "Schwer? Das Programmieren?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d4-l3",
      "speaker": "yusuf",
      "text": "Am Anfang. Aber es macht Spaß.",
      "direction": "إجابة"
    },
    {
      "id": "b2u3d4-l4",
      "speaker": "lena",
      "text": "Und die Automatisierung?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d4-l5",
      "speaker": "yusuf",
      "text": "Die spart Zeit. Technologie hilft der Arbeit.",
      "direction": "تفسير"
    },
    {
      "id": "b2u3d4-l6",
      "speaker": "lena",
      "text": "Aber die Arbeit verschwindet nicht?",
      "direction": "قلق"
    },
    {
      "id": "b2u3d4-l7",
      "speaker": "yusuf",
      "text": "Nein. Sie wird nur anders.",
      "direction": "تهدئة"
    },
    {
      "id": "b2u3d4-l8",
      "speaker": "lena",
      "text": "Gut. Dann lerne ich Programmieren!",
      "direction": "إغلاق"
    }
  ]
}
