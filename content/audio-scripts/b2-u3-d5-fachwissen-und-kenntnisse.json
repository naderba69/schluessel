  "schemaVersion": "1.0.0",
  "id": "b2-u3-d5-fachwissen-und-kenntnisse",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Fachwissen und Kenntnisse",
    "ar": "المعرفة والكفاءات"
  },
  "usedIn": [
    "b2-u3-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u3d5-l1",
      "speaker": "mueller",
      "text": "Fachwissen und Kenntnisse: Die Technik wandelt die Arbeit!",
      "direction": "سوق العمل"
    },
    {
      "id": "b2u3d5-l2",
      "speaker": "yusuf",
      "text": "Welche Kenntnisse sind wichtig?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d5-l3",
      "speaker": "mueller",
      "text": "Fachwissen und die Fähigkeit zu lernen.",
      "direction": "إجابة"
    },
    {
      "id": "b2u3d5-l4",
      "speaker": "yusuf",
      "text": "Die Technik wandelt alles schnell.",
      "direction": "ملاحظة"
    },
    {
      "id": "b2u3d5-l5",
      "speaker": "mueller",
      "text": "Deswegen: immer weiter lernen.",
      "direction": "نصيحة"
    },
    {
      "id": "b2u3d5-l6",
      "speaker": "yusuf",
      "text": "Und das Fachwissen vertiefen.",
      "direction": "إضافة"
    },
    {
      "id": "b2u3d5-l7",
      "speaker": "mueller",
      "text": "Genau. Das macht uns stark.",
      "direction": "تعزيز"
    },
    {
      "id": "b2u3d5-l8",
      "speaker": "yusuf",
      "text": "Danke. Ich lerne weiter.",
      "direction": "إغلاق"
    }
  ]
}
