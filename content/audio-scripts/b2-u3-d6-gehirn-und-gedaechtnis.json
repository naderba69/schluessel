{
  "schemaVersion": "1.0.0",
  "id": "b2-u3-d6-gehirn-und-gedaechtnis",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Gehirn und Gedächtnis",
    "ar": "الدماغ والذاكرة"
  },
  "usedIn": [
    "b2-u3-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u3d6-l1",
      "speaker": "yusuf",
      "text": "Gehirn und Gedächtnis: Die Wissenschaft ist wichtig!",
      "direction": "درس الدماغ"
    },
    {
      "id": "b2u3d6-l2",
      "speaker": "lena",
      "text": "Wie arbeitet das Gedächtnis?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d6-l3",
      "speaker": "yusuf",
      "text": "Das Gehirn speichert alles. Die Wissenschaft erklärt wie.",
      "direction": "تفسير"
    },
    {
      "id": "b2u3d6-l4",
      "speaker": "lena",
      "text": "Und warum vergessen wir?",
      "direction": "استفسار"
    },
    {
      "id": "b2u3d6-l5",
      "speaker": "yusuf",
      "text": "Weil das Gehirn nicht alles hält. Wiederholen hilft.",
      "direction": "إجابة"
    },
    {
      "id": "b2u3d6-l6",
      "speaker": "lena",
      "text": "Also: lernen und wiederholen.",
      "direction": "تطبيق"
    },
    {
      "id": "b2u3d6-l7",
      "speaker": "yusuf",
      "text": "Genau. Das Gedächtnis ist ein Muskel.",
      "direction": "تشبيه"
    },
    {
      "id": "b2u3d6-l8",
      "speaker": "lena",
      "text": "Dann trainiere ich jeden Tag!",
      "direction": "إغلاق"
    }
  ]
}
