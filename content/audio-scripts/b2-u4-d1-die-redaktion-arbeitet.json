{
  "schemaVersion": "1.0.0",
  "id": "b2-u4-d1-die-redaktion-arbeitet",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Redaktion arbeitet",
    "ar": "التحرير يعمل"
  },
  "usedIn": [
    "b2-u4-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u4d1-l1",
      "speaker": "mueller",
      "text": "Die Redaktion arbeitet, der Sender berichtet und die Werbung kommt!",
      "direction": "عالم الإعلام"
    },
    {
      "id": "b2u4d1-l2",
      "speaker": "yusuf",
      "text": "Wer entscheidet in der Redaktion?",
      "direction": "استفسار"
    },
    {
      "id": "b2u4d1-l3",
      "speaker": "mueller",
      "text": "Das Team. Jede Meldung lesen wir genau.",
      "direction": "تفسير"
    },
    {
      "id": "b2u4d1-l4",
      "speaker": "yusuf",
      "text": "Und die Werbung bringt das Geld?",
      "direction": "استفسار"
    },
    {
      "id": "b2u4d1-l5",
      "speaker": "mueller",
      "text": "Teilweise. Der Sender braucht Geld.",
      "direction": "واقعية"
    },
    {
      "id": "b2u4d1-l6",
      "speaker": "yusuf",
      "text": "Aber die Nachrichten bleiben frei?",
      "direction": "قلق"
    },
    {
      "id": "b2u4d1-l7",
      "speaker": "mueller",
      "text": "Das ist das Ziel. Ehrlich berichten.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u4d1-l8",
      "speaker": "yusuf",
      "text": "Gute Antwort.",
      "direction": "إغلاق"
    }
  ]
}
