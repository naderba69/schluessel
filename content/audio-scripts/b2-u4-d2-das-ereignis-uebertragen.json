{
  "schemaVersion": "1.0.0",
  "id": "b2-u4-d2-das-ereignis-uebertragen",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Das Ereignis übertragen",
    "ar": "بثّ الحدث"
  },
  "usedIn": [
    "b2-u4-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u4d2-l1",
      "speaker": "yusuf",
      "text": "Der Sender überträgt das Ereignis und die Medien berichten!",
      "direction": "درس البث"
    },
    {
      "id": "b2u4d2-l2",
      "speaker": "lena",
      "text": "Welches Ereignis heute?",
      "direction": "استفسار"
    },
    {
      "id": "b2u4d2-l3",
      "speaker": "yusuf",
      "text": "Das große Spiel. Viele hören zu.",
      "direction": "إجابة"
    },
    {
      "id": "b2u4d2-l4",
      "speaker": "lena",
      "text": "Und die Medien berichten auch?",
      "direction": "استفسار"
    },
    {
      "id": "b2u4d2-l5",
      "speaker": "yusuf",
      "text": "Ja. Jedes Medium zeigt eine andere Seite.",
      "direction": "تفسير"
    },
    {
      "id": "b2u4d2-l6",
      "speaker": "lena",
      "text": "Interessant. Also viele Quellen prüfen.",
      "direction": "درس"
    },
    {
      "id": "b2u4d2-l7",
      "speaker": "yusuf",
      "text": "Genau. Das ist kluges Denken.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u4d2-l8",
      "speaker": "lena",
      "text": "Danke! Das schaue ich mir an.",
      "direction": "إغلاق"
    }
  ]
}
