{
  "schemaVersion": "1.0.0",
  "id": "b2-u4-d4-die-behauptung-belegen",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Behauptung belegen",
    "ar": "إثبات الادعاء"
  },
  "usedIn": [
    "b2-u4-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u4d4-l1",
      "speaker": "yusuf",
      "text": "Wir argumentieren für die Meinung und belegen die Behauptung!",
      "direction": "درس الحجاج"
    },
    {
      "id": "b2u4d4-l2",
      "speaker": "lena",
      "text": "Wie belegt man eine Behauptung?",
      "direction": "استفسار"
    },
    {
      "id": "b2u4d4-l3",
      "speaker": "yusuf",
      "text": "Mit Zahlen, Beweisen, Quellen. Dann folgern wir.",
      "direction": "إجابة"
    },
    {
      "id": "b2u4d4-l4",
      "speaker": "lena",
      "text": "Und wenn die Beweise fehlen?",
      "direction": "حالة"
    },
    {
      "id": "b2u4d4-l5",
      "speaker": "yusuf",
      "text": "Dann ist es nur eine Meinung.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u4d4-l6",
      "speaker": "lena",
      "text": "Gutes Argument!",
      "direction": "إشادة"
    },
    {
      "id": "b2u4d4-l7",
      "speaker": "yusuf",
      "text": "Danke. Belegen macht die Meinung stark.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u4d4-l8",
      "speaker": "lena",
      "text": "Und fair.",
      "direction": "إغلاق"
    }
  ]
}
