{
  "schemaVersion": "1.0.0",
  "id": "b2-u4-d5-wir-kommentieren",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Wir kommentieren",
    "ar": "نعلّق"
  },
  "usedIn": [
    "b2-u4-d5"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u4d5-l1",
      "speaker": "lena",
      "text": "Wir kommentieren die Meldung und der Datenschutz ist wichtig!",
      "direction": "درس التعليق"
    },
    {
      "id": "b2u4d5-l2",
      "speaker": "yusuf",
      "text": "Darf man alles kommentieren?",
      "direction": "استفسار"
    },
    {
      "id": "b2u4d5-l3",
      "speaker": "lena",
      "text": "Ja, aber fair. Und ohne private Daten.",
      "direction": "إجابة"
    },
    {
      "id": "b2u4d5-l4",
      "speaker": "yusuf",
      "text": "Der Datenschutz zuerst.",
      "direction": "تأكيد"
    },
    {
      "id": "b2u4d5-l5",
      "speaker": "lena",
      "text": "Genau. Befragen ist erlaubt, verletzen nicht.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u4d5-l6",
      "speaker": "yusuf",
      "text": "Ein guter Kommentar ist fair für alle.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u4d5-l7",
      "speaker": "lena",
      "text": "So ist es.",
      "direction": "موافقة"
    },
    {
      "id": "b2u4d5-l8",
      "speaker": "yusuf",
      "text": "Dann kommentiere ich klüger.",
      "direction": "إغلاق"
    }
  ]
}
