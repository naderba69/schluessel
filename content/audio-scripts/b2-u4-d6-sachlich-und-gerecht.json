{
  "schemaVersion": "1.0.0",
  "id": "b2-u4-d6-sachlich-und-gerecht",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Sachlich und gerecht",
    "ar": "موضوعي وعادل"
  },
  "usedIn": [
    "b2-u4-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u4d6-l1",
      "speaker": "mueller",
      "text": "Die Aufklärung ist wichtig, wir schreiben sachlich und bleiben gerecht!",
      "direction": "مبادئ الكتابة"
    },
    {
      "id": "b2u4d6-l2",
      "speaker": "yusuf",
      "text": "Was heißt sachlich?",
      "direction": "استفسار"
    },
    {
      "id": "b2u4d6-l3",
      "speaker": "mueller",
      "text": "Ohne Gefühle schreiben. Die Zahlen sprechen lassen.",
      "direction": "تفسير"
    },
    {
      "id": "b2u4d6-l4",
      "speaker": "yusuf",
      "text": "Und gerecht bleiben?",
      "direction": "استفسار"
    },
    {
      "id": "b2u4d6-l5",
      "speaker": "mueller",
      "text": "Beide Seiten zeigen. Keine Seite vergessen.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u4d6-l6",
      "speaker": "yusuf",
      "text": "Das ist schwer, aber wichtig.",
      "direction": "واقعية"
    },
    {
      "id": "b2u4d6-l7",
      "speaker": "mueller",
      "text": "Mit Übung wird es leicht.",
      "direction": "تشجيع"
    },
    {
      "id": "b2u4d6-l8",
      "speaker": "yusuf",
      "text": "Danke. Das ist echte Aufklärung.",
      "direction": "إغلاق"
    }
  ]
}
