{
  "schemaVersion": "1.0.0",
  "id": "b2-u5-d1-die-wirtschaft",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Wirtschaft",
    "ar": "الاقتصاد"
  },
  "usedIn": [
    "b2-u5-d1"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u5d1-l1",
      "speaker": "mueller",
      "text": "Die Wirtschaft ist wichtig und die Verschwendung ist schlimm!",
      "direction": "درس اقتصادي"
    },
    {
      "id": "b2u5d1-l2",
      "speaker": "yusuf",
      "text": "Wo kauft man zu viel?",
      "direction": "استفسار"
    },
    {
      "id": "b2u5d1-l3",
      "speaker": "mueller",
      "text": "Essen und Energie. Die Verbraucher müssen aufpassen.",
      "direction": "إجابة"
    },
    {
      "id": "b2u5d1-l4",
      "speaker": "yusuf",
      "text": "Und die Wirtschaft?",
      "direction": "استفسار"
    },
    {
      "id": "b2u5d1-l5",
      "speaker": "mueller",
      "text": "Sie wächst mit klugen Entscheidungen.",
      "direction": "تفسير"
    },
    {
      "id": "b2u5d1-l6",
      "speaker": "yusuf",
      "text": "Also: sparen und klug kaufen.",
      "direction": "تطبيق"
    },
    {
      "id": "b2u5d1-l7",
      "speaker": "mueller",
      "text": "Genau. Das ist gesunde Wirtschaft.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u5d1-l8",
      "speaker": "yusuf",
      "text": "Danke für alles.",
      "direction": "إغلاق"
    }
  ]
}
