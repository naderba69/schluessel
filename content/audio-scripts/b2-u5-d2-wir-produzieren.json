{
  "schemaVersion": "1.0.0",
  "id": "b2-u5-d2-wir-produzieren",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Wir produzieren",
    "ar": "نُنتج"
  },
  "usedIn": [
    "b2-u5-d2"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u5d2-l1",
      "speaker": "yusuf",
      "text": "Wir produzieren die Produkte und die Lieferung kommt!",
      "direction": "درس الإنتاج"
    },
    {
      "id": "b2u5d2-l2",
      "speaker": "lena",
      "text": "Welche Produkte?",
      "direction": "استفسار"
    },
    {
      "id": "b2u5d2-l3",
      "speaker": "yusuf",
      "text": "Möbel. Sparsam produzieren, schnell liefern.",
      "direction": "إجابة"
    },
    {
      "id": "b2u5d2-l4",
      "speaker": "lena",
      "text": "Und die Qualität?",
      "direction": "استفسار"
    },
    {
      "id": "b2u5d2-l5",
      "speaker": "yusuf",
      "text": "Bleibt hoch. Sparsam heißt nicht schlecht.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u5d2-l6",
      "speaker": "lena",
      "text": "Gut. Die Lieferung kommt pünktlich?",
      "direction": "استفسار"
    },
    {
      "id": "b2u5d2-l7",
      "speaker": "yusuf",
      "text": "Ja, sicher!",
      "direction": "مزاح لغوي"
    },
    {
      "id": "b2u5d2-l8",
      "speaker": "lena",
      "text": "Sehr gut!",
      "direction": "مزاح متبادل"
    }
  ]
}
