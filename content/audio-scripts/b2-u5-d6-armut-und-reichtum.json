{
  "schemaVersion": "1.0.0",
  "id": "b2-u5-d6-armut-und-reichtum",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Armut und Reichtum",
    "ar": "الفقر والثراء"
  },
  "usedIn": [
    "b2-u5-d6"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u5d6-l1",
      "speaker": "lena",
      "text": "Die Armut ist schlimm, der Reichtum ist groß und wir geben die Spende!",
      "direction": "تفاوت اجتماعي"
    },
    {
      "id": "b2u5d6-l2",
      "speaker": "yusuf",
      "text": "Viele Leute sind arm.",
      "direction": "تأمل"
    },
    {
      "id": "b2u5d6-l3",
      "speaker": "lena",
      "text": "Deswegen spenden wir. Geld oder Zeit.",
      "direction": "حل"
    },
    {
      "id": "b2u5d6-l4",
      "speaker": "yusuf",
      "text": "Und der Reichtum?",
      "direction": "استفسار"
    },
    {
      "id": "b2u5d6-l5",
      "speaker": "lena",
      "text": "Wer viel hat, muss viel geben.",
      "direction": "مبدأ"
    },
    {
      "id": "b2u5d6-l6",
      "speaker": "yusuf",
      "text": "Eine starke Spende kann viel ändern.",
      "direction": "تأكيد"
    },
    {
      "id": "b2u5d6-l7",
      "speaker": "lena",
      "text": "Zusammen gegen die Armut!",
      "direction": "شعار"
    },
    {
      "id": "b2u5d6-l8",
      "speaker": "yusuf",
      "text": "Ich bin dabei.",
      "direction": "إغلاق"
    }
  ]
}
