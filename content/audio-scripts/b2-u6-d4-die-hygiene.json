{
  "schemaVersion": "1.0.0",
  "id": "b2-u6-d4-die-hygiene",
  "kind": "dialogue",
  "level": "B2",
  "title": {
    "de": "Die Hygiene",
    "ar": "النظافة"
  },
  "usedIn": [
    "b2-u6-d4"
  ],
  "lengthScale": 1.1,
  "lines": [
    {
      "id": "b2u6d4-l1",
      "speaker": "lena",
      "text": "Die Hygiene ist wichtig, die Ansteckung ist schlimm und das Immunsystem hilft!",
      "direction": "درس الوقاية"
    },
    {
      "id": "b2u6d4-l2",
      "speaker": "yusuf",
      "text": "Wie vermeidet man Ansteckung?",
      "direction": "استفسار"
    },
    {
      "id": "b2u6d4-l3",
      "speaker": "lena",
      "text": "Hände waschen. Hygiene jeden Tag.",
      "direction": "إجابة"
    },
    {
      "id": "b2u6d4-l4",
      "speaker": "yusuf",
      "text": "Und das Immunsystem?",
      "direction": "استفسار"
    },
    {
      "id": "b2u6d4-l5",
      "speaker": "lena",
      "text": "Stark machen: Sport, Essen, Schlaf.",
      "direction": "نصيحة"
    },
    {
      "id": "b2u6d4-l6",
      "speaker": "yusuf",
      "text": "Also: Hygiene und gesundes Leben.",
      "direction": "تلخيص"
    },
    {
      "id": "b2u6d4-l7",
      "speaker": "lena",
      "text": "Genau. Dann bleibt die Ansteckung weg.",
      "direction": "خلاصة"
    },
    {
      "id": "b2u6d4-l8",
      "speaker": "yusuf",
      "text": "Danke für die guten Tipps.",
      "direction": "إغلاق"
    }
  ]
}
