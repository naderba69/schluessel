{
 "schemaVersion": "1.0.0",
 "id": "b2-u7-d1-die-psyche",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Die Psyche",
  "ar": "النفس"
 },
 "usedIn": [
  "b2-u7-d1"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u7d1-l1",
   "speaker": "mueller",
   "text": "Die Psyche ist wichtig, das Bewusstsein ist klar und der Trost hilft!",
   "direction": "النفس والوعي"
  },
  {
   "id": "b2u7d1-l2",
   "speaker": "yusuf",
   "text": "Was ist die Psyche?",
   "direction": "استفسار"
  },
  {
   "id": "b2u7d1-l3",
   "speaker": "mueller",
   "text": "Die Psyche ist das Innere bei jedem Menschen.",
   "direction": "تعريف"
  },
  {
   "id": "b2u7d1-l4",
   "speaker": "yusuf",
   "text": "Und das Bewusstsein?",
   "direction": "استفسار"
  },
  {
   "id": "b2u7d1-l5",
   "speaker": "mueller",
   "text": "Bewusstsein heißt: wissen, was man denkt und tut.",
   "direction": "تفسير"
  },
  {
   "id": "b2u7d1-l6",
   "speaker": "yusuf",
   "text": "Und der Trost?",
   "direction": "استفسار"
  },
  {
   "id": "b2u7d1-l7",
   "speaker": "mueller",
   "text": "Der Trost hilft in schwierigen Zeiten.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u7d1-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich beginne heute.",
   "direction": "إغلاق"
  }
 ]
}
