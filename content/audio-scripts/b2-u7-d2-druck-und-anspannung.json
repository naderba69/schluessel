{
 "schemaVersion": "1.0.0",
 "id": "b2-u7-d2-druck-und-anspannung",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Druck und Anspannung",
  "ar": "الضغط والتوتر"
 },
 "usedIn": [
  "b2-u7-d2"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u7d2-l1",
   "speaker": "lena",
   "text": "Der Druck ist groß, die Anspannung ist schlimm und die Überlastung ist ein Problem!",
   "direction": "الضغط والتوتر"
  },
  {
   "id": "b2u7d2-l2",
   "speaker": "yusuf",
   "text": "Heute habe ich viel Druck.",
   "direction": "مشاركة"
  },
  {
   "id": "b2u7d2-l3",
   "speaker": "lena",
   "text": "Druck ist normal. Aber die Anspannung?",
   "direction": "اهتمام"
  },
  {
   "id": "b2u7d2-l4",
   "speaker": "yusuf",
   "text": "Die Anspannung ist auch da.",
   "direction": "إجابة"
  },
  {
   "id": "b2u7d2-l5",
   "speaker": "lena",
   "text": "Und die Überlastung? Die ist gefährlich.",
   "direction": "تحذير"
  },
  {
   "id": "b2u7d2-l6",
   "speaker": "yusuf",
   "text": "Was hilft dagegen?",
   "direction": "استفسار"
  },
  {
   "id": "b2u7d2-l7",
   "speaker": "lena",
   "text": "Eine Ruhepause. Und wieder atmen.",
   "direction": "نصيحة"
  },
  {
   "id": "b2u7d2-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich mache jetzt eine Ruhepause.",
   "direction": "إغلاق"
  }
 ]
}
