{
 "schemaVersion": "1.0.0",
 "id": "b2-u7-d3-bewaeltigung-und-ausdauer",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Bewältigung und Ausdauer",
  "ar": "المواجهة والمثابرة"
 },
 "usedIn": [
  "b2-u7-d3"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u7d3-l1",
   "speaker": "mueller",
   "text": "Die Bewältigung geht, die Ausdauer ist stark und die Resilienz hilft!",
   "direction": "المواجهة والمثابرة"
  },
  {
   "id": "b2u7d3-l2",
   "speaker": "yusuf",
   "text": "Die Probleme sind groß.",
   "direction": "مشاركة"
  },
  {
   "id": "b2u7d3-l3",
   "speaker": "mueller",
   "text": "Aber die Bewältigung geht immer.",
   "direction": "تشجيع"
  },
  {
   "id": "b2u7d3-l4",
   "speaker": "yusuf",
   "text": "Wie? Ich bin müde.",
   "direction": "شكوى"
  },
  {
   "id": "b2u7d3-l5",
   "speaker": "mueller",
   "text": "Mit Ausdauer. Stück für Stück.",
   "direction": "نصيحة"
  },
  {
   "id": "b2u7d3-l6",
   "speaker": "yusuf",
   "text": "Und die Resilienz?",
   "direction": "استفسار"
  },
  {
   "id": "b2u7d3-l7",
   "speaker": "mueller",
   "text": "Die Resilienz hilft dir nach schwierigen Zeiten.",
   "direction": "تفسير"
  },
  {
   "id": "b2u7d3-l8",
   "speaker": "yusuf",
   "text": "Also: Ausdauer und Resilienz.",
   "direction": "تلخيص"
  },
  {
   "id": "b2u7d3-l9",
   "speaker": "mueller",
   "text": "Genau. Du schaffst das!",
   "direction": "إغلاق"
  }
 ]
}
