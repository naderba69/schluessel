{
 "schemaVersion": "1.0.0",
 "id": "b2-u7-d4-nerv-und-empathie",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Nerv und Empathie",
  "ar": "العصب والتعاطف"
 },
 "usedIn": [
  "b2-u7-d4"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u7d4-l1",
   "speaker": "lena",
   "text": "Die Nerven sind wichtig, der Reiz ist groß und die Empathie hilft!",
   "direction": "العصب والتعاطف"
  },
  {
   "id": "b2u7d4-l2",
   "speaker": "yusuf",
   "text": "Meine Nerven sind heute schwach.",
   "direction": "مشاركة"
  },
  {
   "id": "b2u7d4-l3",
   "speaker": "lena",
   "text": "Zu viel Reiz?",
   "direction": "استفسار"
  },
  {
   "id": "b2u7d4-l4",
   "speaker": "yusuf",
   "text": "Ja. Lärm, Arbeit, alles zusammen.",
   "direction": "إجابة"
  },
  {
   "id": "b2u7d4-l5",
   "speaker": "lena",
   "text": "Dann brauchst du Empathie — für dich selbst.",
   "direction": "نصيحة"
  },
  {
   "id": "b2u7d4-l6",
   "speaker": "yusuf",
   "text": "Empathie für mich?",
   "direction": "تعجّب"
  },
  {
   "id": "b2u7d4-l7",
   "speaker": "lena",
   "text": "Ja. Verstehen, was du fühlst. Und Ruhe.",
   "direction": "تفسير"
  },
  {
   "id": "b2u7d4-l8",
   "speaker": "yusuf",
   "text": "Gut. Ich versuche das.",
   "direction": "إغلاق"
  }
 ]
}
