{
 "schemaVersion": "1.0.0",
 "id": "b2-u7-d5-balance-und-wille",
 "kind": "dialogue",
 "level": "B2",
 "title": {
  "de": "Balance und Wille",
  "ar": "التوازن والإرادة"
 },
 "usedIn": [
  "b2-u7-d5"
 ],
 "lengthScale": 1.1,
 "lines": [
  {
   "id": "b2u7d5-l1",
   "speaker": "yusuf",
   "text": "Die Balance ist wichtig, die Ruhepause ist gut und der Wille ist stark!",
   "direction": "التوازن والإرادة"
  },
  {
   "id": "b2u7d5-l2",
   "speaker": "lena",
   "text": "Wie ist deine Balance?",
   "direction": "اهتمام"
  },
  {
   "id": "b2u7d5-l3",
   "speaker": "yusuf",
   "text": "Heute gut. Ich habe eine Ruhepause gemacht.",
   "direction": "إجابة"
  },
  {
   "id": "b2u7d5-l4",
   "speaker": "lena",
   "text": "Sehr gut! Und der Wille?",
   "direction": "استفسار"
  },
  {
   "id": "b2u7d5-l5",
   "speaker": "yusuf",
   "text": "Der Wille ist da.",
   "direction": "إجابة"
  },
  {
   "id": "b2u7d5-l6",
   "speaker": "lena",
   "text": "Balance heißt: Arbeit und Ruhe zusammen.",
   "direction": "مبدأ"
  },
  {
   "id": "b2u7d5-l7",
   "speaker": "yusuf",
   "text": "Nicht nur Arbeit. Auch die Ruhepause.",
   "direction": "تلخيص"
  },
  {
   "id": "b2u7d5-l8",
   "speaker": "lena",
   "text": "Genau. Mit Willen und Balance.",
   "direction": "إغلاق"
  }
 ]
}
