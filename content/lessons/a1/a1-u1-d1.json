        "items": [
          {
            "q": "Ich ___ Yusuf.",
            "a": "bin",
            "accept": [
              "heiße"
            ],
            "why": "مع ich نقول bin (وللاسم يصح heiße أيضاً). العربية تقول «أنا يوسف» بلا فعل، أما الألمانية فلا تقبل جملة بلا فعل."
          },
          {
            "q": "Du ___ auch neu.",
            "a": "bist",
            "why": "مع du يصبح sein ← bist. وأغلب الأفعال مع du تنتهي بـ ‑st: du kommst · du wohnst."
          },
          {
            "q": "Lena ___ aus Deutschland.",
            "a": "ist",
            "why": "Lena = sie (هي)، ومع er/sie (هو/هي) فعل sein هو ist."
          },
          {
            "q": "Sie ___ aus Tunesien. (حضرتك)",
            "a": "sind",
            "why": "Sie بحرف كبير = حضرتك (احترام) وفعلها sind. لا تخلطها بـ sie الصغيرة (هي) التي فعلها ist."
          },
          {
            "q": "Wie geht's? — Danke, ___.",
            "a": "gut",
            "why": "الجواب القصير على «كيف الحال؟» هو gut وحدها بعد Danke — لا تحتاج جملة كاملة. العربية تقول «بخير» والألمانية gut (الحرف u طويل: «غوت»)."
          }
        ],
        "interleavedWith": [],
        "explanationRequired": true
      },
      {
        "type": "listening",
        "items": [
          {
            "audioId": "word-guten-morgen",
            "speakText": "Guten Morgen.",
            "q": "استمع: أي تحية سمعت؟",
            "choices": [
              "Guten Morgen",
              "Guten Abend",
              "Guten Tag"
            ],
            "a": "Guten Morgen",
            "why": "Morgen = الصباح، فهي تحية الصباح؛ Guten Tag للنهار وGuten Abend للمساء. الكلمة الأولى Guten واحدة، فركّز على الثانية."
          },
          {
            "audioId": "word-guten-abend",
            "speakText": "Guten Abend.",
            "q": "استمع: متى تقول هذه التحية؟",
            "choices": [
              "في المساء",
              "في الصباح",
              "عند النوم"
            ],
            "a": "في المساء",
            "why": "Abend = المساء. واسمع آخرها: d في آخر الكلمة تُنطق [t] — «آبِنت» لا «آبِند»."
          },
          {
            "audioId": "word-auf-wiedersehen",
            "speakText": "Auf Wiedersehen.",
            "q": "استمع: لمن يناسب هذا الوداع؟",
            "choices": [
              "لموظفة في مكتب رسمي",
              "لصديقك فقط"
            ],
            "a": "لموظفة في مكتب رسمي",
            "why": "Auf Wiedersehen وداع رسمي يصلح مع الجميع؛ أما Tschüss فللأصدقاء والعائلة. وw في أولها تُنطق [v]."
          },
          {
            "audioId": "word-wie-viel",
            "speakText": "wie viel.",
            "q": "استمع: أي سؤال سمعت؟",
            "choices": [
              "Wie viel?",
              "Wie geht's?",
              "Wie heißt du?"
            ],
            "a": "Wie viel?",
            "why": "wie viel = كم/بكم. الأسئلة الثلاثة تبدأ بـ wie، فالفرق في الكلمة الثانية. وانتبه: w تُنطق [v] وv تُنطق [f] — «في فيل»."
          }
        ],
        "interleavedWith": [],
        "explanationRequired": true
      },
      {
        "type": "build-sentence",
        "items": [
          {
            "tokens": [
              "aus",
              "Ich",
              "Tunesien.",
              "komme"
            ],
            "a": "Ich komme aus Tunesien.",
            "why": "الفعل komme في الموضع الثاني بعد ich، ثم aus والبلد. «من» للأصل = aus لا von."
          },
          {
            "tokens": [
              "in",
              "wohne",
              "Deutschland.",
              "Ich"
            ],
            "a": "Ich wohne in Deutschland.",
            "why": "wohnen + in + المكان = أسكن في… والفعل في الموضع الثاني دائماً."
          },
          {
            "tokens": [
              "du?",
              "heißt",
              "Wie"
            ],
            "a": "Wie heißt du?",
            "why": "السؤال يبدأ بكلمة السؤال wie، ثم الفعل، ثم du. ومع du: heiß + t = heißt (لا heiße)."
          }
        ],
        "interleavedWith": [],
        "explanationRequired": true
      },
      {
        "type": "dictation",
        "items": [
          {
            "audioId": "word-hallo",
            "speakText": "Hallo.",
            "a": "Hallo",
            "why": "Hallo بحرفَي l: الحرف المضاعف يجعل الحركة قبله قصيرة — «هَلو» لا «هالو»."
          },
          {
            "audioId": "word-tschuess",
            "speakText": "Tschüss.",
            "a": "Tschüss",
            "why": "tsch أربعة أحرف لصوت واحد «تش»، وü بشفتين مضمومتين ولسان على «ي»، وفي آخرها ss."
          },
          {
            "audioId": "word-deutschland",
            "speakText": "Deutschland.",
            "a": "Deutschland",
            "why": "eu تُنطق «أوي» وtsch «تش»، وd في آخرها تُنطق [t]. وكل اسم يبدأ بحرف كبير — والبلدان أسماء."
          }
        ],
        "interleavedWith": [],
        "explanationRequired": true
      }
    ],
