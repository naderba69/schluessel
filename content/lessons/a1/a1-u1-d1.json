    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich Yusuf~~",
          "ar": "حذف فعل الكينونة"
        },
        "whyArabicSpeakerFails": "الجملة الاسمية العربية لا تحتاج رابطاً (أنا يوسف) — الألمانية تحتاج ist/heiße دائماً (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich heiße Yusuf. / Ich bin aus Tunesien.",
          "ar": "اسمي يوسف. / أنا من تونس."
        },
        "exercise": {
          "q": "صحّح: ~~Er neu hier~~",
          "a": "Er ist neu hier."
        }
      },
      {
        "commonError": {
          "de": "~~Ich komme von Tunesien.~~",
          "ar": "«من» تُترجم von خطأً"
        },
        "whyArabicSpeakerFails": "«من» في العربية تُترجم von حرفياً — لكن بلد الأصل يأتي مع aus (kommen aus) لا von (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich komme aus Tunesien.",
          "ar": "أنا من تونس."
        },
        "exercise": {
          "q": "أكمل: Ich komme ___ Tunesien.",
          "a": "aus"
        }
      },
      {
        "commonError": {
          "de": "~~Wie heiße du?~~",
          "ar": "تصريف heißen مع du"
        },
        "whyArabicSpeakerFails": "الفعل heißen يزداد مع du حرف st (heißt) — التصريف المزدوج أنا/أنت من أشهر مصائد العربي (10‑ي)",
        "correct": {
          "de": "Wie heißt du?",
          "ar": "ما اسمك؟"
        },
        "exercise": {
          "q": "أكمل: Wie ___ du?",
          "a": "heißt"
        }
      }
