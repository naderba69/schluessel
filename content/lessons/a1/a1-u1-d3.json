  "zusammenfassung": {
    "summary": {
      "de": "Heute: Buchstabieren Sie bitte! — L, E, N, A. Wie ist Ihr Name?",
      "ar": "اليوم: أسماء الحروف للتهجئة (E غير I، وO غير U، وJ «يوت»، وV «فاو») — والسؤال عن الاسم بـwie لا was."
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich buchstabieren meinen Namen.~~",
          "ar": "الفعل بصيغة المعجم بلا تصريف"
        },
        "whyArabicSpeakerFails": "العربية تصرّف الفعل دائماً (أتهجّى · تتهجّى)، لكن الكلمة الألمانية تُحفظ بصيغة المعجم buchstabieren فتُستعمل كما هي؛ ومع ich ينتهي الفعل بـ‑e: ich buchstabiere — كما تقول «أتهجّى» لا «التهجئة» (خريطة التداخل 10‑ي).",
        "correct": {
          "de": "Ich buchstabiere meinen Namen.",
          "ar": "أتهجى اسمي."
        },
        "exercise": {
          "q": "صحّح: ~~Ich wiederholen das.~~",
          "a": "Ich wiederhole das."
        }
      },
      {
        "commonError": {
          "de": "~~Was ist Ihr Name?~~",
          "ar": "«ما» العربية ← was"
        },
        "whyArabicSpeakerFails": "بالعربية نسأل عن الاسم بـ«ما»: «ما اسمك؟»، فينقلها العربي حرفياً: Was ist Ihr Name? — والألمانية تسأل عن الاسم بـwie (كيف): Wie ist Ihr Name? · Wie heißen Sie? (خريطة التداخل 10‑ي).",
        "correct": {
          "de": "Wie ist Ihr Name?",
          "ar": "ما اسمك؟ (رسمي)"
        },
        "exercise": {
          "q": "صحّح: ~~Was ist dein Familienname?~~",
          "a": "Wie ist dein Familienname?"
        }
      },
      {
        "commonError": {
          "de": "~~der name~~",
          "ar": "حرف صغير في الاسم"
        },
        "whyArabicSpeakerFails": "العربية بلا حروف كبيرة/صغيرة؛ الألمانية تكتب كل الأسماء بحرف كبير (خريطة 10‑ي).",
        "correct": {
          "de": "der Name",
          "ar": "الاسم"
        },
        "exercise": {
          "q": "صحّح: ~~die adresse~~",
          "a": "die Adresse"
        }
      }
    ],
