  "uebung": {
    "stations": [
      {
        "type": "gap-fill",
        "items": [
          {
            "q": "Ich ___ meinen Namen. (buchstabieren)",
            "a": "buchstabiere",
            "why": "مع ich ينتهي الفعل بـ‑e: ich buchstabiere — صيغة المعجم buchstabieren لا تأتي مع ich."
          },
          {
            "q": "___ ist Ihr Name?",
            "a": "Wie",
            "why": "عن الاسم تسأل الألمانية بـwie (كيف) لا was: Wie ist Ihr Name? — «ما» العربية تغري بـwas."
          },
          {
            "q": "Mein ___ ist Yusuf, mein Familienname ist Haddad.",
            "a": "Vorname",
            "why": "der Vorname = الاسم الأول (Yusuf)، وder Familienname = اسم العائلة (Haddad)، وder Name يشملهما."
          },
          {
            "q": "Wiederholen Sie das bitte! Sprechen Sie bitte ___!",
            "a": "langsam",
            "why": "langsam = ببطء — تطلبه حين لا تفهم، ومعه Wiederholen Sie das bitte (كرّر ذلك من فضلك): عبارتان تنقذانك في كل مكالمة."
          },
          {
            "q": "Guten Tag, ___ Müller!",
            "a": "Herr",
            "why": "Herr + اسم العائلة = السيد…: Herr Müller. ومع Herr نستعمل Sie لا du."
          },
          {
            "q": "Yusuf ist mein ___. (زميل التمرين)",
            "a": "Partner",
            "why": "der Partner للذكر وdie Partnerin للأنثى: Yusuf ist mein Partner · Lena ist meine Partnerin."
          }
        ],
        "interleavedWith": [
          "sprechen",
          "guten-tag"
        ],
        "explanationRequired": true
      },
      {
        "type": "listening",
        "items": [
          {
            "audioId": "abc-e",
            "speakText": "E.",
            "q": "استمع: أي حرف سمعت؟",
            "choices": [
              "E",
              "I",
              "Ä"
            ],
            "a": "E",
            "why": "E «إيه» بفم نصف مفتوح، وI «إي» بشفتين مشدودتين — في العربية كسرة واحدة فيختلطان، وفي التهجئة يتغيّر الاسم."
          },
          {
            "audioId": "abc-i",
            "speakText": "I.",
            "q": "استمع: أي حرف سمعت؟",
            "choices": [
              "I",
              "E",
              "Ü"
            ],
            "a": "I",
            "why": "I «إي» ممدودة كالكسرة الطويلة، وE «إيه» أوسع منها، وÜ «إي» بشفتين مضمومتين."
          },
          {
            "audioId": "abc-u",
            "speakText": "U.",
            "q": "استمع: أي حرف سمعت؟",
            "choices": [
              "U",
              "O",
              "Ü"
            ],
            "a": "U",
            "why": "U «أُو» بشفتين مضمومتين جداً، وO «أوه» أوسع منها، وÜ صوت U مع لسان على «ي»."
          },
          {
            "audioId": "abc-j",
            "speakText": "J.",
            "q": "استمع: أي حرف سمعت؟",
            "choices": [
              "J",
              "G",
              "Y"
            ],
            "a": "J",
            "why": "J اسمها «يوت» لا «جي» كالفرنسية، وG «غيه»، وY «إپسيلون»."
          },
          {
            "audioId": "abc-v",
            "speakText": "V.",
            "q": "استمع: أي حرف سمعت؟",
            "choices": [
              "V",
              "W",
              "F"
            ],
            "a": "V",
            "why": "V اسمها «فاو» وصوتها غالباً f، وW اسمها «ڤيه» وصوتها v — كأنهما تبادلا الصوتين."
          },
          {
            "audioId": "anm-4",
            "speakText": "Haddad: H, A, D, D, A, D.",
            "q": "استمع: كيف يكتب يوسف اسم عائلته؟",
            "choices": [
              "H – A – D – D – A – D",
              "H – A – D – A – D",
              "H – A – T – T – A – T"
            ],
            "a": "H – A – D – D – A – D",
            "why": "سمعت «ديه» مرتين متتاليتين ← D مضاعفة. وD «ديه» غير T «تيه»: الأولى مجهورة."
          }
        ],
        "interleavedWith": [],
        "explanationRequired": true
      },
      {
