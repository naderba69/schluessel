  "zusammenfassung": {
    "summary": {
      "de": "Gestern habe ich einen Brief geschrieben, das Paket geholt und viel gelernt. Das Perfekt: haben in Position 2 — das Partizip am Ende!",
      "ar": "أمس كتبت رسالة، وجلبت الطرد، وتعلمت كثيراً. الماضي المركب: haben في الموضع الثاني — والتصريف في النهاية!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Gestern habe ich gegessen Pizza~~ / ~~Gestern habe ich Pizza gemacht~~ (أي فعل)",
          "ar": "التصريف الثالث يُغلق القلنسوة: آخر الجملة دائماً"
        },
        "whyArabicSpeakerFails": "العربية تضع الفعل الماضي قريباً من مكانه الأصلي؛ الألماني يرسل التصريف (geschrieben/gegessen) إلى أقصى اليمين — قلنسوة u9 تتضخم بالماضي (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Gestern habe ich Pizza gegessen.",
          "ar": "أمس أكلت بيتزا."
        },
        "exercise": {
          "q": "أكمل: Ich habe einen Brief ___ (schreiben).",
          "a": "geschrieben"
        }
      },
      {
        "commonError": {
          "de": "~~Ich habe gemachet~~ / ~~Ich habe machte~~ / ~~Ich habe gegeessen~~",
          "ar": "التصريف: ge- + الجذر + t (أو الجذور القوية تُحفظ)"
        },
        "whyArabicSpeakerFails": "لا ge- ولا t في العربية؛ القاعدة المنتظمة gemacht/gelernt/gewünscht والجذور القوية gebracht/gedacht/geschrieben تُحفظ كبطاقات — لا تركيب حر (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "gemacht · gelernt · gebracht · geschrieben",
          "ar": "عمل · تعلّم · جلب · كتب (تصريفات)"
        },
        "exercise": {
          "q": "كوّن التصريف: machen → ___ · bringen → ___",
          "a": "gemacht / gebracht"
        }
      },
      {
        "commonError": {
          "de": "~~Gestern ich habe Zeit gehabt~~",
          "ar": "القلنسوة بالماضي: بعد gestern يقلب (habe ich) والتصريف آخر شيء"
        },
        "whyArabicSpeakerFails": "مصيدة u9-d5/u10-d2 تكتمل هنا: كل مقدمة (gestern · letzte Woche) تدفع haben للموضع الثاني — والتذكير: hab**e** وليس hab**t** للمتكلم (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Gestern habe ich Zeit gehabt.",
          "ar": "أمس كان عندي وقت."
        },
        "exercise": {
          "q": "رتّب: gestern · habe · ich · gelernt",
          "a": "Gestern habe ich gelernt."
        }
      }
    ],
