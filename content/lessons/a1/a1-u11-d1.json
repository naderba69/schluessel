  "zusammenfassung": {
    "summary": {
      "de": "Kopf, Hand, Arm, Bein, Rücken, Bauch — und wo tut es weh? Mein Kopf tut weh, mein Rücken auch. Achtung: die Hand, das Bein, das Auge!",
      "ar": "الرأس واليد والذراع والساق والظهر والبطن — وأين الألم؟ رأسي يؤلمني وظهري أيضاً. انتبه: die Hand وdas Bein وdas Auge!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~der Hand~~ / ~~das Auge~~ (بالخطأ) / ~~die Bein~~",
          "ar": "جنس أجزاء الجسم عشوائي: الحفظ بالبطاقة (die Hand · das Bein · das Auge)"
        },
        "whyArabicSpeakerFails": "العربية بلا جنس نحوي لكل اسم؛ الألماني يفرض جنساً عشوائياً على كل جزء — die Hand أنثى وdas Bein محايد بلا سبب منطقي — الحفظ بصرياً بالبطاقة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "die Hand · das Bein · das Auge · der Kopf",
          "ar": "اليد · الساق · العين · الرأس (بأجنستها)"
        },
        "exercise": {
          "q": "أكمل: ___ Hand (die/der) · ___ Bein (das/die)",
          "a": "die / das"
        }
      },
      {
        "commonError": {
          "de": "~~die Hands~~ / ~~die Kopfs~~ / ~~die Zahns~~",
          "ar": "الجمع يُوملَأ كثيراً: Hände · Köpfe · Zähne (لا s للكلمات الألمانية الأصلية)"
        },
        "whyArabicSpeakerFails": "جمع التكسير العربي له مقابل ألماني منتظم: Umlaut (a→ä/u→ü) + e — «اليد» جمعها Hände وليس Hands — أصوات الوملاوت لا تُنطق بالعربية (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "die Hände · die Köpfe · die Zähne · die Bäuche",
          "ar": "الأيدي · الرؤوس · الأسنان · البطون"
        },
        "exercise": {
          "q": "كوّن الجمع: der Kopf → ___ · der Zahn → ___",
          "a": "die Köpfe / die Zähne"
        }
      },
      {
        "commonError": {
          "de": "~~Mein Kopf weh tut~~ / ~~Es tut mein Kopf weh~~",
          "ar": "التركيب الثابت: X + tut + weh (الفعل الثاني weh في النهاية!)"
        },
        "whyArabicSpeakerFails": "«رأسي يؤلمني» فعل واحد؛ الألماني يشطر المعنى: **tut** (مؤلم) + **weh** (ألم) مع الفاعل بينهما — weh يُقال آخر الجملة كتصريف منفصل — مصيدة القلنسوة تعود بشكل جديد (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Mein Kopf tut weh.",
          "ar": "رأسي يؤلمني."
        },
        "exercise": {
          "q": "أكمل: Mein Bauch ___ weh ___ (tut — الترتيب).",
          "a": "Mein Bauch tut weh."
        }
      }
    ],
