  "zusammenfassung": {
    "summary": {
      "de": "Gestern: Ich war krank, bin zu Hause geblieben, habe gehustet und geniest. Mein Hals hat gebrannt. Heute: Der Schmerz ist verschwunden, ich bin wieder fit!",
      "ar": "أمس: كنتُ مريضاً وبقيتُ في البيت وسعلتُ وعطستُ. حلقي التهب. اليوم: اختفى الألم وأنا مجدداً بخير!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich habe zu Hause geblieben~~ / ~~Der Schmerz hat verschwunden~~",
          "ar": "الحركة والتغيّر: **sein** (bin geblieben · ist verschwunden) — الأعراض: **haben** (habe gehustet)"
        },
        "whyArabicSpeakerFails": "العربية فعل واحد بلا مساعدين؛ الألماني يفرّق: الحركة/التغيّر (بقي · اختفى · ذهب · جاء) = **ist** — الفعل في مكانه (سعل · عطس · استلقى) = **hat** — «القلنسوة» = الأحداث والانتقالات (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich bin geblieben. · Der Schmerz ist verschwunden. · Ich habe gehustet.",
          "ar": "بقيتُ · اختفى الألم · سعلتُ."
        },
        "exercise": {
          "q": "أكمل: Ich ___ geblieben (sein/haben) · Ich ___ gehustet.",
          "a": "bin / habe"
        }
      },
      {
        "commonError": {
          "de": "~~Ich habe krank gewesen~~ / ~~Ich bin krank gewesen~~ (بدل war)",
          "ar": "كان (الماضي) = **war** مباشرة (Präsens ist → Präteritum war) — لا حاجة للمساعد"
        },
        "whyArabicSpeakerFails": "«كنتُ» فعل مساعد واحد بالعربية؛ الألماني يبني الماضي مباشرة: ist→**war** (مثل Umlaut يوم الاستعادة) — البناء المباشر أسهل: لا haben ولا participle (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich war krank. · Er war zu Hause.",
          "ar": "كنتُ مريضاً. · كان في البيت."
        },
        "exercise": {
          "q": "حوّل: Ich bin schwach → gestern: Ich ___ schwach.",
          "a": "war"
        }
      },
      {
        "commonError": {
          "de": "~~Mein Haut juckt~~ / ~~Ich jucke~~",
          "ar": "الحكّ والحكة: **Es juckt** (Es الفاعل الصوري — يعود من الوحدة 10!)"
        },
        "whyArabicSpeakerFails": "«يحكّ» فعل بلا فاعل محسوس بالعربية؛ الألماني يفرض **Es** الفاعل الصوري (مثل Es regnet في الوحدة 10) — والحكّ بنفسه: Es juckt (لا «أنا أحكّ») — مصيدة Es تعود في سياق الجسم (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Es juckt. · Es brennt.",
          "ar": "يحكّ. · يلتهب."
        },
        "exercise": {
          "q": "ترجم: «يحكّ» (بـ Es).",
          "a": "Es juckt."
        }
      }
    ],
