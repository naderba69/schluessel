  "zusammenfassung": {
    "summary": {
      "de": "Die goldene Regel: Symptom/Krankheit = haben (38 Grad Fieber), Bewegung/Veränderung = sein (geblieben, verschwunden). Ich fühle mich besser — und: Rauchen Sie nicht!",
      "ar": "القاعدة الذهبية: عَرَض/مرض = haben (38 درجة) · حركة/تغيّر = sein (بقيتُ · اختفى). أشعر بتحسن — ولا تدخّنوا!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich bin 38 Grad Fieber~~ / ~~Ich habe zu Hause geblieben~~",
          "ar": "قاعدة القرار: **العَرَض = haben** · **الحركة/التغيّر = sein** — القلنسوة للـ«كيف» والثانية للـ«أين»"
        },
        "whyArabicSpeakerFails": "«عندي 38» ملكية بالعربية (لها = haben) — لكن «بقيتُ» حركة بالعربية والالماني يعاملها تغيّر حالة = sein — القاعدة أولاً: هل تغيّر شيء (مَكان/حالة)؟ = bin · هل كان عَرَضاً أو فعلاً في مكانه؟ = habe (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich habe 38 Grad Fieber. · Ich bin zu Hause geblieben.",
          "ar": "عندي 38 درجة. · بقيتُ في البيت."
        },
        "exercise": {
          "q": "أكمل: Ich ___ gehustet (haben/sein) · Ich ___ verschwunden.",
          "a": "habe / bin"
        }
      },
      {
        "commonError": {
          "de": "~~Ich fühle besser~~ / ~~Ich fühle gut~~",
          "ar": "sich fühlen = يشعر **بنفسه** — ضمير الانعكاس إجباري (mich/dich/sich)"
        },
        "correct": {
          "de": "Ich fühle mich besser.",
          "ar": "أشعر بتحسن."
        },
        "exercise": {
          "q": "أكمل: Er fühlt ___ (sich) gut.",
          "a": "sich"
        },
        "whyArabicSpeakerFails": "«أشعر بتحسن» للاسم بدل الضمير بالعربية؛ الألماني يشطر الإحساس: **sich** fühlen (أنا = mich) — بدون mich الجملة ناقصة — ضمير الانعكاس إجباري (خريطة التداخل 10‑ي)"
      },
      {
        "commonError": {
          "de": "~~Rauchen nicht Sie!~~ / ~~Rauchen Sie kein!~~",
          "ar": "النفي في الأمر: Verb + **Sie** + **nicht** (nicht آخر — لا kein ولا قبل Sie)"
        },
        "whyArabicSpeakerFails": "«لا تدخّنوا» نفي قبل الفعل بالعربية؛ الألماني ينفي آخر الجملة: Rauchen Sie **nicht** — الترتيب: فعل + أنتم + نفي — مصيدة النفي-آخر تتكرر في شكل الأمر (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Rauchen Sie nicht!",
          "ar": "لا تدخّنوا!"
        },
        "exercise": {
          "q": "حوّل: Nehmen Sie die Tablette! → النفي",
          "a": "Nehmen Sie die Tablette nicht!"
        }
      }
    ],
