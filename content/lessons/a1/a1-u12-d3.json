  "zusammenfassung": {
    "summary": {
      "de": "Meine Reise: Ich habe den Koffer eingepackt und die Reise geplant. Wir sind um 8 Uhr losgefahren. Im Hotel: ich habe mich angemeldet. Am Sonntag bin ich zurückgekommen — und ich habe 200 Euro ausgegeben!",
      "ar": "رحلتي: حزمتُ الحقيبة وخطّطتُ الرحلة. انطلقنا الساعة الثامنة. في الفندق: سجّلتُ نفسي. يوم الأحد عدتُ — وأنفقتُ 200 يورو!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich habe den Koffer geeinpackt~~ / ~~gepacktein~~ / ~~Ich habe eingepackt den Koffer~~",
          "ar": "الفعل المنفصل في الماضي: البادئة + **ge** + الجذر: **ein-ge-packt** (ge في المنتصف!) — والمفعول بين المساعدين"
        },
        "whyArabicSpeakerFails": "«حزمتُ» فعل واحد؛ الألماني ثلاثة أجزاء: habe + den Koffer + **eingepackt** (ein-ge-packt) — ge يدخل بين البادئة والجذر — لا «geeinpackt» أبداً (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich habe den Koffer eingepackt.",
          "ar": "حزمتُ الحقيبة."
        },
        "exercise": {
          "q": "كوّن الماضي: mitnehmen → mit-___-nommen",
          "a": "mitgenommen"
        }
      },
      {
        "commonError": {
          "de": "~~Ich habe losgefahren~~ / ~~Ich bin eingepackt~~",
          "ar": "قاعدة القرار مع البادئات: **losgefahren/zurückgekommen = ist** (حركة) · **eingepackt/mitgebracht = hat** (فعل في مكانه)"
        },
        "whyArabicSpeakerFails": "البادئة (los/zurück/mit) توحي بالحركة كلها؛ الألماني يفرّق: هل تغيّر المَكان فعلاً؟ = ist · هل فعلتُ شيئاً بيدي؟ = hat — البادئة لا تغيّر القاعدة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Wir sind losgefahren. · Ich habe eingepackt.",
          "ar": "انطلقنا. · حزمتُ."
        },
        "exercise": {
          "q": "أكمل: Ich ___ zurückgekommen · Ich ___ mitgenommen.",
          "a": "bin / habe"
        }
      },
      {
        "commonError": {
          "de": "~~Ich habe angemeldet~~ / ~~Ich habe mich angemeldet~~ (صحيح!) / ~~Ich habe mich anmeldet~~",
          "ar": "sich anmelden = **انعكاسي + منفصل**: mich في المنتصف + angemeldet (an-ge-meldet)"
        },
        "whyArabicSpeakerFails": "«سجّلتُ نفسي» فعلان بالعربية؛ الألماني ثلاثة أجزاء: habe + **mich** + **angemeldet** — الانعكاسي (mich) يقعد بين المساعد والمفعول — الترتيب: habe … mich … angemeldet (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich habe mich angemeldet.",
          "ar": "سجّلتُ نفسي."
        },
        "exercise": {
          "q": "أكمل: Er hat ___ (sich) angemeldet.",
          "a": "sich"
        }
      }
    ],
