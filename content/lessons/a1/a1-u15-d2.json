  "zusammenfassung": {
    "summary": {
      "de": "Einheiten 3–4: Empfehlung (empfehlen), Bestellung (möchte … haben), Akkusativ (ohne), gegenüber + Dativ.",
      "ar": "الوحدتان 3–4: التوصية والطلب وAkkusativ ومقابل+Dativ."
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich nehme Suppe~~ / ~~ohne der Fleisch~~",
          "ar": "المفعول المعيّن يحتاج المقال · ohne بلا مقال"
        },
        "whyArabicSpeakerFails": "«آخذ اليخنة» بأل في الألمانية (die Suppe) · وبدون «بلا» لا تحمل مقالاً أبداً (ohne Fleisch) — مصيدة الأداة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich nehme die Suppe. · ohne Fleisch",
          "ar": "آخذ اليخنة. · بلا لحم."
        },
        "exercise": {
          "q": "أكمل: ohne ___ (die Milch)",
          "a": "Milch"
        }
      },
      {
        "commonError": {
          "de": "~~Ich habe Hunger auf Brot~~ / ~~Ich möchte haben die Suppe~~",
          "ar": "الجوع والعطش + الترتيب"
        },
        "whyArabicSpeakerFails": "«جائع» = habe Hunger (بلا auf) · و«أريد أن أحصل» = möchte … haben (الفعلان آخر) — القلنسوة في الطعام (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich habe Hunger. · Ich möchte die Suppe haben.",
          "ar": "أنا جائع. · أريد اليخنة."
        },
        "exercise": {
          "q": "أكمل: Ich möchte Kaffee ___ (haben — الترتيب)",
          "a": "… haben (آخر)"
        }
      },
      {
        "commonError": {
          "de": "~~gegenüber dem Bank~~ / ~~gegenüber die Bank~~",
          "ar": "gegenüber + Dativ دائماً"
        },
        "whyArabicSpeakerFails": "«مقابل» تتبعها Dativ (der/dem Bank) — حرف الجر الثابت للمكان — مراجعة u3 (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "gegenüber der Bank",
          "ar": "مقابل البنك"
        },
        "exercise": {
          "q": "أكمل: gegenüber ___ (das Hotel)",
          "a": "dem Hotel"
        }
      }
