    "warningCards": [
      {
        "commonError": {
          "de": "~~Es regnet es~~ / ~~Der Wetter ist schön~~",
          "ar": "Es الفاعل الصوري + das Wetter"
        },
        "whyArabicSpeakerFails": "«الجو ممطر» بلا فاعل بالعربية؛ الألماني يفرض Es دائماً — و«الجو» محايد: das Wetter — الوحدة 7 (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Es regnet. · Das Wetter ist schön.",
          "ar": "الجو ممطر. · الجو جميل."
        },
        "exercise": {
          "q": "أكمل: ___ schneit.",
          "a": "Es"
        }
      },
      {
        "commonError": {
          "de": "~~seit zwei Stunde~~ / ~~seit den zwei Stunden~~",
          "ar": "seit + Dativ (الوحدات الزمنية جمع بلا مقال)"
        },
        "whyArabicSpeakerFails": "«منذ ساعتين» جمع بالعربية؛ الألماني seit zwei Stunden (Dativ جمع بلا مقال) — مصيدة u8 الأصلية (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "seit zwei Stunden",
          "ar": "منذ ساعتين"
        },
