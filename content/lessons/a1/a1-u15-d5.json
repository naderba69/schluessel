  "zusammenfassung": {
    "summary": {
      "de": "Einheiten 9–10: Beruf, Termin, Perfekt (anrufen), weil (Endstellung) und deshalb (V2).",
      "ar": "الوحدتان 9–10: المهنة والموعد والماضي المنفصل وweil↔deshalb."
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~weil ich war krank~~ / ~~deshalb ich bin spät~~",
          "ar": "weil ترسل الفعل · deshalt b تبدأ وتقفز"
        },
        "whyArabicSpeakerFails": "«لأنني كنت» فعل في النهاية (weil … war) · «لذلك أنا» فعل ثانٍ (deswegen bin) — الوحدة 10 كاملة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "…, weil ich krank war. · Deshalb bin ich spät.",
          "ar": "… لأنني كنت مريضاً. · لذلك أنا متأخر."
        },
        "exercise": {
          "q": "أكمل: …, weil ich müde ___ (bin — الترتيب)",
          "a": "bin (آخر)"
        }
      },
      {
        "commonError": {
          "de": "~~Gestern habe angerufen ich~~ / ~~Gestern ich habe angerufen~~",
          "ar": "الماضي: haben ثانٍ + المفعول + الفعل المنفصل آخر"
        },
        "whyArabicSpeakerFails": "«أمس اتصلت» ثلاث أجزاء: Gestern + habe + angerufen — القلنسوة بالماضي المنفصل (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Gestern habe ich angerufen.",
          "ar": "أمس اتصلتُ."
        },
        "exercise": {
          "q": "أكمل: Gestern ___ ich ___ (anrufen)",
          "a": "habe … angerufen"
        }
      },
      {
        "commonError": {
          "de": "~~am Dienstag Termin ist~~ / ~~der Termin am Dienstag ist~~",
          "ar": "الموعد + زمان المكان الأول: am Dienstag أولاً أو آخر — لا وسط"
        },
        "whyArabicSpeakerFails": "«الموعد يوم الثلاثاء» ترتيب حر لكن الفعل ثانٍ دائماً — Der Termin ist am Dienstag (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Der Termin ist am Dienstag.",
          "ar": "الموعد يوم الثلاثاء."
        },
        "exercise": {
          "q": "أكمل: ___ ist am Dienstag.",
          "a": "Der Termin"
        }
      }
    ],
