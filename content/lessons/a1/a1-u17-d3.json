    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich muss bezahlen die Rechnung~~ / ~~Ich kann nicht finden der Koffer~~",
          "ar": "المساعد في المركز والفعل الآخر — القلنسوة!"
        },
        "whyArabicSpeakerFails": "«يجب أن أدفع» فعلان متجاوران بالعربية؛ الألماني: muss … bezahlen — نفس القاعدة من u5 في التسوق (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich muss die Rechnung bezahlen.",
          "ar": "يجب أن أدفع الفاتورة."
        },
        "exercise": {
          "q": "أكمل: Ich muss ___ (finden) den Koffer.",
          "a": "… finden (آخر)"
        }
      },
      {
        "commonError": {
          "de": "~~Was ist der Preis?~~ / ~~Wie viel kostet?~~",
          "ar": "السؤال عن الثمن: Was kostet das?"
        },
        "whyArabicSpeakerFails": "«كم الثمن» بأي فعل بالعربية؛ الألماني فعل واحد: kostet + المضاف إليه — التمرين الملايين (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Was kostet das?",
          "ar": "كم الثمن؟"
        },
