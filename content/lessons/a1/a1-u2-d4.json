  "zusammenfassung": {
    "summary": {
      "de": "Die Regel: ß nur nach langen Vokalen (heiß, groß, Fuß, süß), ss nach kurzen (Tasse, essen) — und ee/oo/ä/h zeigen Länge (Kaffee, Boot, Käse, gehen)!",
      "ar": "القاعدة: ß بعد الحركات الطويلة فقط (heiß, groß, Fuß, süß)، وss بعد القصيرة (Tasse, essen) — وee/oo/ä/h تدل على الطول (Kaffee, Boot, Käse, gehen)!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~heisst~~ / ~~gross~~ (بالرسم الألماني الحديث)",
          "ar": "ß بعد الحركة الطويلة"
        },
        "whyArabicSpeakerFails": "العربية بلا مقابل لـß فيجرّب ss كلها — القاعدة حاسمة: طويلة (ai/au/u/o) ← ß، قصيرة ← ss (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "heiß / groß",
          "ar": "حارّ / كبير (ß)"
        },
        "exercise": {
          "q": "صحّح: ~~die heisse Suppe~~",
          "a": "die heiße Suppe"
        }
      },
      {
        "commonError": {
          "de": "~~Tasße~~ / ~~Eßen~~",
          "ar": "ss بعد الحركة القصيرة"
        },
        "whyArabicSpeakerFails": "العكس: يبالغ في ß بعد القصيرة — الحرف المضاعف يقصّر الحركة قبله (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "die Tasse / essen",
          "ar": "الكوب / يأكل (ss)"
        },
        "exercise": {
          "q": "صحّح: ~~eine Taße Kaffee~~",
          "a": "eine Tasse Kaffee"
        }
      },
      {
        "commonError": {
          "de": "~~Kafee~~ / ~~Bood~~ / ~~gehn~~",
          "ar": "الإطالة تُكتب ee/oo أو h أو ä"
        },
        "whyArabicSpeakerFails": "«القهوة» بالعربية حركة واحدة؛ الألماني يكتب الطول صراحةً: Kaffee (ee) · Boot (oo) · gehen (h) · Käse (ä) (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "der Kaffee / das Boot / gehen",
          "ar": "القهوة / القارب / يذهب (طول مكتوب)"
        },
        "exercise": {
          "q": "أكمل الكتابة: Kaf__ · B__t · g__en",
          "a": "Kaffee · Boot · gehen"
        }
      }
    ],
