  "zusammenfassung": {
    "summary": {
      "de": "Jetzt kannst du dich vorstellen, Fragen stellen und antworten — 6 Wechsel ohne Pause. Das ist ein echtes Gespräch!",
      "ar": "الآن تستطيع تعريف نفسك والسؤال والرد — 6 تبادلات بلا صمت. هذا حوار حقيقي!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich vorstelle mich.~~ / ~~Ich stelle vor mich.~~",
          "ar": "الفعل المنفصل + الانعكاسي: stelle mich vor"
        },
        "whyArabicSpeakerFails": "العربية بلا أفعال منفصلة ولا انعكاسية بنفس الشكل — stelle ... vor يفصل، وmich يتوسط (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich stelle mich vor.",
          "ar": "أُعرّف بنفسي."
        },
        "exercise": {
          "q": "صحّح: ~~Ich vorstelle mich: Ich heiße Yusuf.~~",
          "a": "Ich stelle mich vor: Ich heiße Yusuf."
        }
      },
      {
        "commonError": {
          "de": "~~Ich gern lese.~~ / ~~gern ich lese~~",
          "ar": "gern في آخر الجملة"
        },
        "whyArabicSpeakerFails": "العربية «أقرأ بمحبة» يضع الظرف أحياناً في الوسط؛ الألماني: gern أخيراً (أو ثانياً بعد الفعل في الأسئلة) (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich lese gern.",
          "ar": "أقرأ بمحبة."
        },
        "exercise": {
          "q": "أعد الترتيب: gern / Ich / lese",
          "a": "Ich lese gern."
        }
      },
      {
        "commonError": {
          "de": "~~Ich lerne kennen dich.~~",
          "ar": "kennenlernen منفصل: lerne dich kennen"
        },
        "whyArabicSpeakerFails": "الفعل المنفصل يعود: kennenlernen ← lerne ... kennen والمفعول بينهما — كما في aufstehen تماماً (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich lerne dich kennen.",
          "ar": "أتعرّف عليك."
        },
        "exercise": {
          "q": "صحّح: ~~Ich lerne kennen dich.~~",
          "a": "Ich lerne dich kennen."
        }
      }
    ],
