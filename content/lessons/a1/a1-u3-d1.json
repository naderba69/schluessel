  "zusammenfassung": {
    "summary": {
      "de": "Das Zählsystem: Einheit zuerst, dann -zig (fünfundzwanzig) — und sechzig/siebzig verkürzen sich. Du zählst bis 100!",
      "ar": "نظام العد: الوحدة أولاً ثم -zig (fünfundzwanzig) — وsechzig/siebzig يختصران. أنت تعدّ حتى 100!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~zwanzigeins~~ / ~~twenty-one~~",
          "ar": "الوحدة أولاً ثم العشرات (عكس الترتيب الإنجليزي)"
        },
        "whyArabicSpeakerFails": "العربية «واحد وعشرون» مألوفة — لكن الألماني يدمجها كلمة واحدة: fünfundzwanzig، والإنجليزية twenty-one تُربك أحياناً (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "fünfundzwanzig",
          "ar": "خمسة وعشرون (كلمة واحدة)"
        },
        "exercise": {
          "q": "اكتب 35 بالألمانية",
          "a": "fünfunddreißig"
        }
      },
      {
        "commonError": {
          "de": "~~sechszig~~ / ~~siebenzig~~",
          "ar": "sechs←sech وsieben←sieb عند الربط"
