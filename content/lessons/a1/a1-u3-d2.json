  "zusammenfassung": {
    "summary": {
      "de": "Du kennst die Preise: Wie viel kostet das? — kostet + Zahl + Euro, und bezahlen ohne für. Einkaufen wird leicht!",
      "ar": "تعرف الأسعار: بكم هذا؟ — kostet + رقم + Euro، وbezahlen بلا جار. التسوّق يصبح سهلاً!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Wie viel kostet für das?~~ / ~~Was kostet wie viel?~~",
          "ar": "kosten + سعر مباشرة (بلا für)"
        },
        "whyArabicSpeakerFails": "«كم يكلف هذا؟» بالعربية حار؛ الألماني: Wie viel kostet das? والسعر مفعول مباشر بلا حرف جر (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Wie viel kostet das? — Das kostet fünf Euro.",
          "ar": "بكم هذا؟ — هذا يكلف خمسة يورو."
        },
        "exercise": {
          "q": "صحّح: ~~Das kostet für fünf Euro.~~",
          "a": "Das kostet fünf Euro."
        }
      },
      {
        "commonError": {
          "de": "~~Ich bezahle für die Rechnung.~~",
          "ar": "bezahlen + مفعول مباشر (بلا für)"
        },
        "whyArabicSpeakerFails": "«أدفع عن الحساب» يجرّب العربي الجار — الألماني يضع المفعول مباشرة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich bezahle die Rechnung.",
          "ar": "أدفع الحساب."
        },
        "exercise": {
          "q": "صحّح: ~~bezahlen für das Brot~~",
          "a": "das Brot bezahlen"
        }
      },
      {
        "commonError": {
          "de": "~~das Euro~~ / ~~nur kostet~~",
          "ar": "der Euro · nur بين الفعل والمفعول"
        },
        "whyArabicSpeakerFails": "اليورو مذكر (der) — و«فقط» تدخل وسط الجملة الألمانية بعد الفعل مباشرة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "das kostet nur drei Euro (der Euro)",
          "ar": "ثلاثة يورو فقط (der Euro)"
        },
        "exercise": {
          "q": "أعد الترتيب: Euro / kostet / drei / nur / Das",
          "a": "Das kostet nur drei Euro."
        }
      }
