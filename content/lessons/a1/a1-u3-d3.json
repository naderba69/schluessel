  "zusammenfassung": {
    "summary": {
      "de": "Du kennst die Uhr: Es ist drei Uhr / halb vier / Viertel nach zwei — und halb zählt zur NÄCHSTEN Stunde!",
      "ar": "تعرف الساعة: الثالثة / الرابعة والنصف / الثانية والربع — وhalb يعدّ للساعة التالية!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~halb drei = 3:30~~",
          "ar": "halb + الساعة التالية = نصفها"
        },
        "whyArabicSpeakerFails": "«الثالثة والنصف» بالعربية تبدأ من الثالثة؛ الألماني يعدّ نصف الثالث = 2:30 — عدّاد يبدأ من التالي (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "halb drei = 2:30",
          "ar": "نصف الثالث = الثانية والنصف"
        },
        "exercise": {
          "q": "«الساعة الرابعة والنصف» بالألمانية؟",
          "a": "halb fünf (4:30)"
        }
      },
      {
        "commonError": {
          "de": "~~Es ist um drei Uhr.~~ (للتوقيت الآن)",
          "ar": "Es ist drei Uhr — بلا um · um للtermine"
        },
        "whyArabicSpeakerFails": "«الساعة الثالثة» بحرف الجر أحياناً بالعربية؛ الألماني: للتوقيت الآن بلا جار، وum للمواعيد (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Es ist drei Uhr. — Der Termin ist um drei Uhr.",
          "ar": "الآن الثالثة. — الموعد في الثالثة."
        },
        "exercise": {
          "q": "صحّح: ~~Es ist um acht Uhr jetzt.~~",
          "a": "Es ist jetzt acht Uhr."
        }
      },
      {
        "commonError": {
          "de": "~~der morgen~~ (للصباح) / ~~Morgen~~ (لغداً)",
          "ar": "الكبير يغيّر المعنى!"
        },
        "whyArabicSpeakerFails": "«صباح» و«غداً» كلمتان بالعربية — الألماني كلمة واحدة يفصلها حرف كبير: der Morgen (صباح) vs morgen (غداً) (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "der Morgen (صباح) / morgen (غداً)",
          "ar": "حسب الحرف الأول!"
        },
        "exercise": {
          "q": "صحّح: ~~Ich habe Morgen Zeit~~ (غداً)",
          "a": "Ich habe morgen Zeit."
        }
      }
    ],
