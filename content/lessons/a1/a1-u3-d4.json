  "zusammenfassung": {
    "summary": {
      "de": "Der Termin-Satz: am + Tag, im + Monat, um + Uhrzeit — „Am Montag im Januar um drei Uhr“ — fertig!",
      "ar": "جملة الموعد: am + اليوم، im + الشهر، um + الساعة — «Am Montag im Januar um drei Uhr» — اكتملت!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~am Januar~~ / ~~in Montag~~ / ~~an drei Uhr~~",
          "ar": "um/am/im — ثلاث أدوات لثلاثة مقاييس"
        },
        "whyArabicSpeakerFails": "العربية «في» واحدة للكل؛ الألماني يفرّق: um (ساعة) · am (يوم) · im (شهر = in dem) (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "um drei Uhr · am Montag · im Januar",
          "ar": "في الثالثة · يوم الاثنين · في يناير"
        },
        "exercise": {
          "q": "أكمل: ___ Februar ___ Freitag ___ zehn Uhr",
          "a": "im · am · um"
        }
      },
      {
        "commonError": {
          "de": "~~die Januar~~ / ~~das März~~",
          "ar": "كل الشهور مذكرة (der)"
        },
        "whyArabicSpeakerFails": "الشهور بالعربية محايدة أحياناً في التمييز؛ الألماني: der + شهر + حرف كبير (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "der Januar / der März",
          "ar": "مذكرة كلها (der)"
        },
        "exercise": {
          "q": "صحّح: ~~die April ist schön~~",
          "a": "Der April ist schön."
        }
      },
      {
        "commonError": {
          "de": "~~Wir treffen wir uns.~~ / ~~Ich treffe mich dich.~~",
          "ar": "sich treffen: treffen uns/euch/sich"
        },
        "whyArabicSpeakerFails": "«نلتقي» بلا ضمير انعكاس بالعربية؛ الألماني: uns/euch/sich إلزامي (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Wir treffen uns.",
          "ar": "نلتقي."
        },
        "exercise": {
          "q": "صحّح: ~~Wir treffen am Montag.~~",
          "a": "Wir treffen uns am Montag."
        }
      }
    ],
