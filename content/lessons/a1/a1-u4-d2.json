  "zusammenfassung": {
    "summary": {
      "de": "Mein/dein/sein folgen dem BESITZ (meine Frau, mein Hund) — und gehören braucht Dativ (Das gehört mir). Deine Familie hat Eigentum!",
      "ar": "mein/dein/sein تتبع المُملوك (meine Frau, mein Hund) — وgehören يجرّ (Das gehört mir). لأسرتك ممتلكات!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~mein Frau~~ / ~~dein Hund~~ (للكلبة?)",
          "ar": "الملكية تُصرَّف حسب جنس المُملوك"
        },
        "whyArabicSpeakerFails": "«زوجتي» بالياء فقط بالعربية؛ الألماني يغيّر النهاية حسب الشيء: meine Frau (مؤنث) لكن mein Mann (مذكر) — جنس المالك لا يهم (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "meine Frau / mein Mann",
          "ar": "زوجتي / زوجي (حسب المُملوك)"
        },
        "exercise": {
          "q": "أكمل: mein___ Katze (مؤنث) · mein___ Auto (محايد)",
          "a": "meine Katze · mein Auto"
        }
      },
      {
        "commonError": {
          "de": "~~Das Auto gehört mich.~~",
          "ar": "gehören + Dativ"
        },
        "whyArabicSpeakerFails": "«السيارة لي» بالعربية مجرور تقريباً؛ الألماني gehört يجرّ: mir/dir/ihm — كما antworten تماماً (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Das Auto gehört mir.",
          "ar": "السيارة لي."
        },
        "exercise": {
          "q": "صحّح: ~~Das gehört dich.~~",
          "a": "Das gehört dir."
        }
      },
      {
        "commonError": {
          "de": "~~der mein Bruder~~ / ~~die meine Tasche~~",
          "ar": "الملكية بلا أداة تعريف"
        },
        "whyArabicSpeakerFails": "«أخي» بلا أداة بالعربية — والألمانية كذلك: mein Bruder يكفي، وmein تحل محل der/die/das (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "mein Bruder (لا der mein Bruder)",
          "ar": "أخي"
        },
        "exercise": {
          "q": "صحّح: ~~Das ist der mein Schlüssel.~~",
          "a": "Das ist mein Schlüssel."
        }
      }
    ],
