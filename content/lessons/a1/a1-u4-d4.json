  "zusammenfassung": {
    "summary": {
      "de": "Dein Familienfoto erzählt: Links steht …, rechts sitzt …, neben …, zwischen … — und alle lächeln gemeinsam!",
      "ar": "صورتك الأسرية تحكي: على اليسار يقف…، على اليمين يجلس…، بجانب…، بين… — والجميع يبتسمون معاً!"
    },
    "warningCards": [
