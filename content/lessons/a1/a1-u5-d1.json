  "zusammenfassung": {
    "summary": {
      "de": "Dein Einkauf: Brot, Käse, Wurst, Fisch, Salat, Suppe, Eier, Reis, Nudeln, Obst, Gemüse — und Hunger hast du auch (mit haben)!",
      "ar": "تسوّقك: الخبز والجبن والنقانق والسمك والسلطة والحساء والبيض والأرز والمعكرونة والفواكه والخضار — والجوع أيضاً «يُملَك» (mit haben)!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich bin Hunger.~~",
          "ar": "Hunger/Durst مع haben لا sein"
        },
        "whyArabicSpeakerFails": "«أنا جوعان» خبر بالعربية (اسم/صفة)؛ الألماني يمتلك الجوع: Ich habe Hunger (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich habe Hunger!",
          "ar": "أنا جوعان! (عندي جوع)"
        },
        "exercise": {
          "q": "صحّح: ~~Ich bin Durst.~~",
          "a": "Ich habe Durst."
        }
      },
      {
        "commonError": {
          "de": "~~ein Nudel~~ / ~~die Nudels~~",
          "ar": "die Nudeln جمع فقط"
        },
        "whyArabicSpeakerFails": "«معكرونة» مفرد بالعربية؛ الألماني Nudeln جمع دائماً — مثل Eltern وGeschwister (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "die Nudeln",
          "ar": "المعكرونة (جمع)"
        },
        "exercise": {
          "q": "صحّح: ~~Ich esse ein Nudel.~~",
          "a": "Ich esse Nudeln."
        }
      },
      {
        "commonError": {
          "de": "~~das Ei~~ ← ~~die Eies~~ (الجمع)",
          "ar": "Ei ← Eier (شاذ)"
        },
        "whyArabicSpeakerFails": "جمع -er مع تغيير الجذر يعود (Kinder/Häuser): Eier بلا umlaut لكن بالقطع (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "das Ei ← die Eier",
          "ar": "البيضة ← البيض"
        },
        "exercise": {
          "q": "اكتب الجمع: drei ___ (Ei)",
          "a": "drei Eier"
        }
      }
    ],
