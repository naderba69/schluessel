  "zusammenfassung": {
    "summary": {
      "de": "Deine Wohnung: Schlafzimmer, Wohnzimmer, Badezimmer, Flur, Balkon, Keller, Garten — alle Zimmer-Komposita sind „das“!",
      "ar": "شقتك: غرفة النوم والمعيشة والحمّام والممر والشرفة والقبو والحديقة — وكل مركّبات Zimmer محايدة!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~die Schlafzimmer~~ / ~~der Wohnzimmer~~",
          "ar": "مركّبات Zimmer = das"
        },
        "whyArabicSpeakerFails": "«غرفة النوم» كلمتان؛ الألماني مركّب واحد والجنس من آخر جزء (Zimmer = das) — قاعدة Muttersprache/Speisekarte للمرة الرابعة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "das Schlafzimmer / das Wohnzimmer / das Badezimmer",
          "ar": "كل ما ينتهي بـZimmer = das"
        },
        "exercise": {
          "q": "حدّد: Badezimmer — der/die/das?",
          "a": "das"
        }
      },
      {
        "commonError": {
          "de": "~~die Gärten~~؟ لا: ~~Garten~~ بلا umlaut",
