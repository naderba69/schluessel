  "zusammenfassung": {
    "summary": {
      "de": "Wo? = Dativ (an der Wand), Wohin? = Akkusativ (an die Wand) — und stellen/legen/hängen je nach Form!",
      "ar": "أين؟ = جرّ (an der Wand)، وإلى أين؟ = نصب (an die Wand) — وstellen/legen/hängen حسب شكل الشيء!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich stelle den Tisch an der Wand.~~ (Wohin?)",
          "ar": "Wohin? = Akkusativ"
        },
        "whyArabicSpeakerFails": "«عند الجدار» تجرّ بالعربية مهما كان السؤال؛ الألماني يفرق: أين؟ → an der (جرّ) · إلى أين؟ → an die (نصب) (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich stelle den Tisch an die Wand. (Wohin?)",
          "ar": "الاتجاه = نصب"
        },
        "exercise": {
          "q": "أكمل: Ich stelle die Lampe auf ___ Tisch. Sie ist auf ___ Tisch.",
          "a": "den / dem"
        }
      },
      {
        "commonError": {
          "de": "~~Ich lege den Tisch.~~ / ~~Ich stelle das Bild.~~",
          "ar": "stellen (واقفاً) · legen (مستلقياً) · hängen (معلّقاً)"
        },
        "whyArabicSpeakerFails": "«أضع» فعل واحد بالعربية للكل؛ الألماني يصف شكل الوضع بثلاثة أفعال — المعنى يتغير بالفعل لا بالظرف (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "stellen (تِلْ) / legen (مستلقٍ) / hängen (معلّق)",
          "ar": "ثلاثة أفعال للوضع"
        },
        "exercise": {
          "q": "أكمل: Ich ___ das Kissen auf das Bett. Ich ___ das Bild an die Wand.",
          "a": "lege / hänge"
        }
      },
      {
        "commonError": {
          "de": "~~Wo stellst du den Tisch?~~ (للاتجاه)",
          "ar": "Wo? ↔ Wohin?"
        },
        "whyArabicSpeakerFails": "«أين» واحدة بالعربية للسؤالين؛ الألماني Wo للمكان وWohin للاتجاه — وwo مأخوذة من u2 واليوم wohin شقيقتها (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Wo ist das Bild? — Wohin stellst du es?",
          "ar": "أين هو؟ ↔ إلى أين تضعه؟"
        },
        "exercise": {
          "q": "اختر: ___ ist der Tisch? — ___ stellst du ihn?",
          "a": "Wo / Wohin"
        }
      }
    ],
