  "zusammenfassung": {
    "summary": {
      "de": "Dein Morgen: Der Wecker weckt dich, du wachst auf, duschst, ziehst dich an — und der Alltag fängt an!",
      "ar": "صباحك: ساعة اليقظة توقظك، تستيقظ، تستحمّ، ترتدي — واليوم يبدأ!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich aufwache um sieben.~~",
          "ar": "الفعل المنفصل: البادئة في النهاية"
        },
        "whyArabicSpeakerFails": "«أستيقظ» كلمة واحدة؛ الألماني aufwachen ينفصل: البادئة auf تذهب لنهاية الجملة — أول لقاء عملي (الدرس الخامس يشرحها) (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich wache um sieben auf.",
          "ar": "أستيقظ في السابعة."
        },
        "exercise": {
          "q": "صحّح: ~~Ich anfange um acht.~~",
          "a": "Ich fange um acht an."
        }
      },
      {
        "commonError": {
          "de": "~~Ich bin müde~~ ↔ ~~Ich habe müde~~",
          "ar": "müde = sein (مثل satt)"
        },
        "whyArabicSpeakerFails": "«متعب» خبر بالعربية؛ الألماني müde مع ist تماماً مثل satt — الزوج يتكرر (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich bin müde.",
          "ar": "أنا متعب."
        },
        "exercise": {
          "q": "أكمل: Ich ___ müde. Ich ___ Hunger.",
          "a": "bin / habe"
        }
      },
      {
        "commonError": {
          "de": "~~aufwachen~~ = ~~wecken~~",
          "ar": "يستيقظ (intransitiv) ↔ يوقظ (transitiv)"
        },
        "whyArabicSpeakerFails": "«استيقظ/أوقظ» فعلان متقاربان؛ الألماني يفصل: aufwachen بلا مفعول وwecken بمفعول — المعنى ينقلب بالبادئة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich wache auf. / Der Wecker weckt mich.",
          "ar": "أستيقظ. / الساعة توقظني."
        },
        "exercise": {
          "q": "أكمل: Ich ___ um sieben ___. Der Wecker ___ mich.",
          "a": "wache … auf / weckt"
        }
      }
    ],
