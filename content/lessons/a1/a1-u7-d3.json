  "zusammenfassung": {
    "summary": {
      "de": "Deine Verben: machen, suchen, putzen, öffnen, schließen, brauchen, rufen, besuchen, benutzen, telefonieren, schicken, warten — alle regelmäßig!",
      "ar": "أفعالك: تفعل وتبحث وتنظّف وتفتح وتغلق وتحتاج وتنادي وتزور وتستخدم وتتحدث وتُرسل وتنتظر — كلها منتظمة!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~du macht~~ / ~~du suchst~~? لا: ~~er suchst~~",
          "ar": "النهايات: du = -st · er = -t"
        },
        "whyArabicSpeakerFails": "العربية لا تُصرّف باللواحق هذا الشكل؛ الألماني يخلط: أنت -st وهو -t — نقطتان تتشابهان (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "du machst · er macht",
          "ar": "أنتَ تفعل · هو يفعل"
        },
        "exercise": {
          "q": "أكمل: du ___ (suchen) · er ___ (suchen)",
          "a": "suchst / sucht"
        }
      },
      {
        "commonError": {
          "de": "~~Ich ge-telefoniert.~~ / ~~hat foniert~~",
          "ar": "-ieren بلا ge- في الماضي"
        },
        "whyArabicSpeakerFails": "كل الأفعال تأخذ ge- في التعلَّم الأول؛ أفعال -ieren تستثنى: hat telefoniert (وليس ~~gefoniert~~) (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "hat telefoniert / hat benutzt",
          "ar": "-ieren: بلا ge-"
        },
        "exercise": {
          "q": "صحّح: ~~Er hat ge-telefoniert.~~",
          "a": "Er hat telefoniert."
        }
      },
      {
        "commonError": {
          "de": "~~Ich warte den Bus.~~",
          "ar": "warten auf + Akkusativ"
        },
        "whyArabicSpeakerFails": "«أنتظر الحافلة» مفعول به مباشر بالعربية؛ الألماني يحشر auf بينهما (warten auf + نصب) — مثل Wo/Wohin مع auf (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich warte auf den Bus.",
          "ar": "أنتظر الحافلة."
        },
        "exercise": {
          "q": "أكمل: Ich warte auf ___ Bus.",
          "a": "den"
        }
      }
    ],
