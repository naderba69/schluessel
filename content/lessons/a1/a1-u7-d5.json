  "zusammenfassung": {
    "summary": {
      "de": "Dein Tag: Du stehst auf, frühstückst, räumst auf, kaufst ein, rufst an, siehst fern — die trennbaren Verben machen alles möglich!",
      "ar": "يومك: تنهض وتتناول الفطور وترتّب وتتسوّق وتتصل وتتفرّج — الأفعال المنفصلة تُدير كل شيء!"
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich aufstehe um sieben.~~",
          "ar": "البادئة المنفصلة في النهاية"
        },
        "whyArabicSpeakerFails": "«أنهض» كلمة واحدة؛ الألماني aufstehen ينفصل: auf يذهب للنهاية — القاعدة الكبيرة للوحدة (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich stehe um sieben auf.",
          "ar": "أنهض في السابعة."
        },
        "exercise": {
          "q": "صحّح: ~~Ich anrufe meine Mutter.~~",
          "a": "Ich rufe meine Mutter an."
        }
      },
      {
        "commonError": {
          "de": "~~Ich möchte stehen auf.~~ / ~~Ich möchte aufstehe~~",
          "ar": "möchte + infinitive مركّب في النهاية"
        },
        "whyArabicSpeakerFails": "مع möchten يبقى الفعل متصلاً في النهاية: möchte aufstehen — تكرار موعود من الوحدة 5 (möchte + Infinitiv) (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich möchte um sieben aufstehen.",
          "ar": "أريد أن أنهض في السابعة."
        },
        "exercise": {
          "q": "أكمل: Ich möchte im Urlaub ___ (einkaufen).",
          "a": "einkaufen"
        }
      },
      {
        "commonError": {
          "de": "~~Ich sehe das Fernsehen.~~ / ~~Ich kaufe ein Einkauf.~~",
          "ar": "فعل ↔ اسم: fernsehen ↔ Fernsehen"
        },
        "whyArabicSpeakerFails": "«أتفرّج/التلفاز» وزن واحد بالعربية؛ الألماني يفصل بين الفعل المنفصل والاسم المركّب — الحفظ بالأزواج (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Ich sehe fern. / das Fernsehen · ich kaufe ein. / der Einkauf",
          "ar": "الفعل منفصل والاسم مستقل."
        },
        "exercise": {
          "q": "أكمل: Ich ___ fern. Das ___ ist langweilig.",
          "a": "sehe / Fernsehen"
        }
      }
    ],
