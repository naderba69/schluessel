    "warningCards": [
      {
        "commonError": {
          "de": "~~Ich aufstehe.~~ / ~~er fahrt~~ / ~~du macht~~",
          "ar": "الوحدة 7 في ثلاث جمل"
        },
        "whyArabicSpeakerFails": "ثلاثة أنماط: انفصال البادئة، وumlaut في du/er، ونهايات -st/-t — كلها تغييرات داخل الكلمة لا تُنطق بالعربية (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "stehe auf · fährt · machst",
          "ar": "النهاية · الـumlaut · النهايات"
        },
        "exercise": {
          "q": "صحّح: ~~Ich aufstehe und du macht und er fahrt.~~",
          "a": "Ich stehe auf, und du machst, und er fährt."
        }
      },
      {
        "commonError": {
          "de": "~~Er isst müde.~~ / ~~Er ist Brot.~~",
          "ar": "isst ↔ ist متشابهان"
        },
        "whyArabicSpeakerFails": "«يأكل» و«يكون» متماثلان صوتياً بالألماني؛ العربي يخلط بالسياق — اقرأ المعنى لا الصوت (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Er isst Brot. / Er ist müde.",
          "ar": "يأكل خبزاً. / هو متعب."
        },
        "exercise": {
          "q": "أكمل: Er ___ Kuchen und ___ satt.",
          "a": "isst / ist"
        }
      },
