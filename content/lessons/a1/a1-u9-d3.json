  "zusammenfassung": {
    "summary": {
      "de": "Entschuldigung! Helfen Sie mir, bitte! — Zuerst geradeaus, danach rechts, und dann: Biegen Sie links ab! Kein Problem.",
      "ar": "عفواً! ساعدوني من فضلكم! — أولاً إلى الأمام، ثم يميناً، ثم: انعطفوا يساراً! لا مشكلة."
    },
    "warningCards": [
      {
        "commonError": {
          "de": "~~Sie biegen links ab, bitte!~~ / ~~Biegen links Sie ab!~~",
          "ar": "Imperativ (Sie): الفعل أولاً ثم Sie مباشرة"
        },
        "whyArabicSpeakerFails": "الأمر العربي «انعطفوا» بلا ضمير مرئي أو بترتيب مختلف؛ الألماني يبدأ بالفعل ثم يضمير Sie: Biegen Sie …! — ترتيب غير موجود بالعربية إطلاقاً (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Biegen Sie links ab, bitte!",
          "ar": "انعطفوا يساراً من فضلكم!"
        },
        "exercise": {
          "q": "رتّب: (abbiegen) (Sie) (links) (bitte) — بصيغة الأمر.",
          "a": "Abbiegen? → Biegen Sie links ab, bitte!"
        }
      },
      {
        "commonError": {
          "de": "~~Helfen Sie mich!~~ / ~~Ich helfe dich~~",
          "ar": "helfen فعل داتيفي — يجرّ المفعول بالداتيف"
        },
        "whyArabicSpeakerFails": "«ساعدني» بالمفعول المضمر واحد؛ الألماني helfen يفرض الداتيف: helfen Sie **mir** (وليس mich) — تثبيت مصيدة الأفعال الناقمة من الوحدة 8 (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Helfen Sie mir, bitte!",
          "ar": "ساعدوني من فضلكم!"
        },
        "exercise": {
          "q": "أكمل: Helfen Sie ___ (ich)!",
          "a": "mir"
        }
      },
      {
        "commonError": {
          "de": "~~Biegen Sie ab links!~~ / ~~Abbiegen Sie links!~~",
          "ar": "الفعل المنفصل في الأمر: البادئة تبقى في النهاية"
        },
        "whyArabicSpeakerFails": "البادئة لا تنفصل بالعربية؛ في الأمر الألماني يبقى الفعل المنفصل مقصوصاً: Biegen Sie links **ab**! — مصيدة d2 تتكرر هنا بالصيغة الأمر (خريطة التداخل 10‑ي)",
        "correct": {
          "de": "Biegen Sie links ab!",
          "ar": "انعطفوا يساراً!"
