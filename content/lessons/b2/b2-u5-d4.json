    "warningCards": [
      {
        "commonError": {
          "ar": "die Arbeitgeber!",
          "de": "~~die Arbeitgeber bezahlt.~~"
        },
        "correct": {
          "ar": "der Arbeitgeber!",
          "de": "Der Arbeitgeber bezahlt."
        },
        "exercise": {
          "q": "___ Arbeitgeber bezahlt.",
          "a": "der"
        },
        "whyArabicSpeakerFails": "العربية: «صاحب العمل» مركّب فيه «العمل» مذكّر! والألمانية: المركّب يتبع آخره — der Geber (يعطي!) مذكّر! (خريطة التداخل 10-ي!)"
      },
      {
        "commonError": {
          "ar": "der Anstellung!",
          "de": "~~der Anstellung ist gut.~~"
        },
        "correct": {
          "ar": "die Anstellung!",
          "de": "Die Anstellung ist gut."
        },
        "exercise": {
          "q": "___ Anstellung ist gut.",
          "a": "die"
        },
        "whyArabicSpeakerFails": "العربية: «التوظيف» مذكّر (مصدر!)! والألمانية: كل كلمات -ung مؤنثة (die Anstellung!) (خريطة التداخل 10-ي!)"
      },
      {
        "commonError": {
          "ar": "in das …!",
          "de": "~~Er geht in das Ruhestand.~~"
        },
        "correct": {
          "ar": "in den!",
          "de": "Er geht in den Ruhestand."
        },
        "exercise": {
          "q": "Er geht in ___ Ruhestand.",
          "a": "den"
        },
        "whyArabicSpeakerFails": "العربية: «إلى» حرف واحد! والألمانية: in + النصب (den!) هنا — جملة ثابتة تُحفظ كاملة! (خريطة التداخل 10-ي!)"
      }
    ]
  },
