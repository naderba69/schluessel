    "warningCards": [
      {
        "commonError": {
          "ar": "der Operation!",
          "de": "~~der Operation ist wichtig.~~"
        },
        "correct": {
          "ar": "die Operation!",
          "de": "Die Operation ist wichtig."
        },
        "exercise": {
          "q": "___ Operation ist wichtig.",
          "a": "die"
        },
        "whyArabicSpeakerFails": "العربية: «العملية» مؤنثة — والألمانية كذلك! لكن كلمات -ion مؤنثة دائماً (die!) وقد تُذكَّر بالعربية المحكية («عملية ناجح»!) (خريطة التداخل 10-ي!)"
      },
      {
        "commonError": {
          "ar": "die Symptom!",
          "de": "~~die Symptom ist klar.~~"
        },
        "correct": {
          "ar": "das Symptom!",
          "de": "Das Symptom ist klar."
        },
        "exercise": {
          "q": "___ Symptom ist klar.",
          "a": "das"
        },
        "whyArabicSpeakerFails": "العربية: «العَرَض» مذكّر! والألمانية: das Symptom (das! كلمات -om أجنسيّة محايدة!) — قاعدة -nis/-tum نفسها (خريطة التداخل 10-ي!)"
      },
      {
        "commonError": {
          "ar": "die Heilung machen!",
          "de": "~~die Heilung machen.~~"
        },
        "correct": {
          "ar": "die Heilung brauchen!",
          "de": "die Heilung brauchen."
        },
        "exercise": {
          "q": "Wir ___ die Heilung.",
          "a": "brauchen"
        },
        "whyArabicSpeakerFails": "«يحتاج إلى الشفاء» = brauchen (لا machen!) — المفردة الثابتة die Heilung brauchen (خريطة التداخل 10-ي!)"
      }
    ]
  },
