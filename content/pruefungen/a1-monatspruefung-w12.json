  "items": [
    {
      "q": "«أين تعمل؟»؟",
      "a": "Wo arbeiten Sie?"
    },
    {
      "q": "«اتصلتُ أمس»؟",
      "a": "Ich habe gestern angerufen."
    },
    {
      "q": "«لأنني متعب» — denn (الترتيب)؟",
      "a": "…, denn ich bin müde."
    },
    {
      "q": "«ليس X بل Y»؟",
      "a": "nicht X, sondern Y"
    },
    {
      "q": "«برأيي»؟",
      "a": "Meiner Meinung nach"
    },
    {
      "q": "«عندي صداع»؟",
      "a": "Ich habe Kopfschmerzen."
    },
    {
      "q": "«كنتُ مريضاً»؟",
      "a": "Ich war krank."
    },
    {
      "q": "«القطار متأخر»؟",
      "a": "Der Zug hat Verspätung."
    },
    {
      "q": "«غرفة الطوارئ»؟",
      "a": "die Notaufnahme"
    },
    {
      "q": "«يُصوّر» — والماضي؟",
      "a": "fotografieren — hat fotografiert"
    },
    {
      "q": "«شاطئ/غابة»؟",
      "a": "der Strand / der Wald"
    },
    {
      "q": "«أعيدوا المفتاح!»؟",
      "a": "Geben Sie den Schlüssel zurück!"
    }
