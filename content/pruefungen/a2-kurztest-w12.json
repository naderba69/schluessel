  "items": [
    {
      "q": "«أودّ أن أصير طاهياً»؟",
      "a": "Ich würde gern Koch werden."
    },
    {
      "q": "«لو عندي وقت أتعلّم»؟",
      "a": "Wenn ich Zeit habe, lerne ich."
    },
    {
      "q": "«أعلم أن الامتحان سهل»؟",
      "a": "Ich weiß, dass die Prüfung leicht ist."
    },
    {
      "q": "«الحصان والعصفور»؟",
      "a": "das Pferd und der Vogel"
    },
    {
      "q": "«البحر أزرق»؟",
      "a": "Die See ist blau."
    },
    {
      "q": "«يوم العمل»؟",
      "a": "der Arbeitstag"
    },
    {
      "q": "«أريد أن أصير موسيقياً»؟",
      "a": "Ich will Musiker werden."
    },
    {
      "q": "«المدرسة مفتوحة»؟",
      "a": "Die Schule ist offen."
    },
    {
      "q": "«أكتب على ورقة الإجابة»؟",
      "a": "Ich schreibe auf den Antwortbogen."
    },
    {
      "q": "«الكيمياء صعبة»؟",
      "a": "Chemie ist schwer."
    },
    {
      "q": "«في يوليو عندي عطلة»؟",
      "a": "Im Juli habe ich Urlaub."
    },
    {
      "q": "«الماء بارد»؟",
      "a": "Das Wasser ist kalt."
    }
