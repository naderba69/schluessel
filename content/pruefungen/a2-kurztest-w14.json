  "items": [
    {
      "q": "«في الليل أنام»؟",
      "a": "In der Nacht schlafe ich."
    },
    {
      "q": "«عند منتصف الليل»؟",
      "a": "Um Mitternacht"
    },
    {
      "q": "«اليوم الأول جميل»؟",
      "a": "Der erste Tag ist schön."
    },
    {
      "q": "«أشرب قهوة مرتين»؟",
      "a": "Ich trinke zweimal Kaffee."
    },
    {
      "q": "«أودّ أن أساعد»؟",
      "a": "Ich würde gern helfen."
    },
    {
      "q": "«اشتريت — وكان جديداً»؟",
      "a": "Ich habe gekauft — es war neu."
    },
    {
      "q": "«أغسل يديّ»؟",
      "a": "Ich wasche mir die Hände."
    },
    {
      "q": "«لا أريد لحماً»؟",
      "a": "Ich möchte kein Fleisch."
    },
    {
      "q": "«سنسافر غداً»؟",
      "a": "Wir werden morgen fahren."
    },
    {
      "q": "«الحصان كبير»؟",
      "a": "Das Pferd ist groß."
    },
    {
      "q": "«من فضلك، مسموح؟»؟",
      "a": "Ist das erlaubt, bitte?"
    },
    {
      "q": "«شكراً — إلى اللقاء!»؟",
      "a": "Danke — tschüss!"
    }
  ]
}
