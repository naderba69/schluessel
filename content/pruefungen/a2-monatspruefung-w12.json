  "items": [
    {
      "q": "«أودّ أن أصير طاهياً»؟",
      "a": "Ich würde gern Koch werden."
    },
    {
      "q": "«لو عندي وقت أتعلّم»؟",
      "a": "Wenn ich Zeit habe, lerne ich."
    },
    {
      "q": "«أعلم أن الامتحان ليس صعباً»؟",
      "a": "Ich weiß, dass die Prüfung nicht schwer ist."
    },
    {
      "q": "«الحصان والعصفور والبحر»؟",
      "a": "das Pferd, der Vogel und die See"
    },
    {
      "q": "«الزبون يسأل السيد»؟",
      "a": "Der Kunde fragt den Herrn."
    },
    {
      "q": "«بسبب الطقس نبقى في البيت»؟",
      "a": "Wegen des Wetters bleiben wir zu Hause."
    },
    {
      "q": "«يوم العمل»؟",
      "a": "der Arbeitstag"
    },
    {
      "q": "«أريد أن أصير موسيقياً»؟",
      "a": "Ich will Musiker werden."
    },
    {
      "q": "«لا لحماً»؟",
      "a": "kein Fleisch"
    },
    {
